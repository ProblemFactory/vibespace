#!/usr/bin/env node
// vibespace-msg — agent-to-agent messaging (Communication Channels v1 2.362.0;
// AGENT GROUPS 2.369.159, design-communication-panel §22). STATIC tracked.
// Auth: VIBESPACE_SESSION_TOKEN. Reach is msg-acl, server-side: same Task
// Group = mutual; other groups only when the user opened them.
// Every message lives in a GROUP: `send <agent>` posts into the two-member
// group of the pair (found or created — the same pair is always the same
// group), `send <group>` into a group you belong to. Each member's NOTIFY MODE
// decides what reaches it when: next-turn (default — a report on its next
// user turn, zero cost), mention (woken when @named), always (woken by every
// message), mute. A WAKE is a BILLED turn for the receiver — every answer
// ECHOES the count ("woke 2 agents = 2 billed turns"). Members and groups
// are named by conversation id / group id OR by name, resolved SERVER-side; a
// name that matches more than one is refused with the candidates, never
// guessed. Inside a Background Work job (VIBESPACE_JOB_TOKEN) it speaks as
// the conversation that owns the job: list / read / send only — creating a
// group or changing membership is refused locally, before any request.
// Exit codes: 0 ok · 1 refused (the server's typed code + its remedy) ·
// 2 not inside a session · 3 server unreachable. Full manual: vibespace-docs msg.
// DISPATCH (lane worker-dispatch, 2026-10-02): `dispatch <agent> --file brief.md` (or `send <agent> --wake
// --compact-first "…"`) = a wake with the worker COMPACTED first when it is idle — POST /api/agent/msg/dispatch;
// the answer says whether it compacted and why not. A conversation's verb: refused locally inside a job.
'use strict';
const API = process.env.VIBESPACE_API;
const SESS = process.env.VIBESPACE_SESSION_TOKEN;
const JOBT = process.env.VIBESPACE_JOB_TOKEN;
const TOKEN = SESS || JOBT;
const AS_JOB = !SESS && !!JOBT;
if (!API || !TOKEN) { console.error('vibespace-msg: not inside a VibeSpace session (VIBESPACE_API / token missing)'); process.exit(2); }

const argv = process.argv.slice(2);
// flags anywhere: --context "…" --quiet --wake --yes --compact-first --before <ts> --limit <n> --file <path> --at <member> (repeatable)
const flags = {};
const args = [];
const atRefs = [];
for (let i = 0; i < argv.length; i++) {
  const a = argv[i];
  if (a === '--quiet' || a === '--wake' || a === '--yes') flags[a.slice(2)] = true;
  else if (a === '--compact-first') flags.compactFirst = true;
  else if (a === '--again') flags.again = true;                       // verify r2 ②: send the same text again on purpose
  else if (a.startsWith('--again=')) flags.again = a.slice('--again='.length);   // reuse a printed nonce = a retry of that attempt
  else if (a === '--context' || a === '--before' || a === '--limit' || a === '--file') { flags[a.slice(2)] = argv[i + 1]; i++; }
  else if (a === '--at') { if (argv[i + 1] !== undefined) atRefs.push(argv[i + 1]); i++; }
  else args.push(a);
}
const verb = args[0];

// The remedy for each typed refusal (the server's `code`; its `error` text is
// printed first and already names the specifics).
const REMEDY = {
  unreachable: 'vibespace-msg list shows every session you can message; ask the user to open a scope if the one you need is not there',
  'not-found': 'vibespace-msg group list shows the groups you are in (a group you are not in answers the same way)',
  ambiguous: 'repeat the command with one of the ids above',
  'not-member': 'only a member can do that — vibespace-msg group list shows yours',
  'not-allowed': 'only the group\'s creator (or the user, in the Channels panel) may do that',
  archived: 'the group is archived (its log stays readable with vibespace-msg read); start a new one with vibespace-msg group create',
  'pair-group': 'a direct (two-member) group takes no third member — vibespace-msg group create <name> <member…> makes a group',
  'job-token': 'run it from the conversation that owns this job (its own VIBESPACE_SESSION_TOKEN)',
  'bad-notify': 'the modes are next-turn | mention | always | mute',
  'bad-name': 'a group name is 1–80 characters',
  'too-few-members': 'a group needs at least one other agent besides you',
  self: 'that is this session',
  'bad-member': 'this session cannot act as itself yet (no conversation id of its own) — wait a moment and repeat the command; the server\'s line above says when',
  'not-chat': 'nothing was sent. A terminal session cannot be compacted by an agent — send the brief without the compaction: vibespace-msg send <agent> --wake "…"',
  'unknown-mention': 'nothing was sent. @ a member by its exact name or conversation id (the candidates above), or name it with --at <name|id>; a literal "@word" goes in backticks as code',
  'ambiguous-mention': 'nothing was sent. @ the member by its conversation id (one of the ids above), or --at <id>',
  'confirm-wakes': 'nothing was sent. Repeat with --yes if waking them all NOW is worth that many billed turns — or send without --wake (add --quiet to an invite): they read it on their next turn, free',
};
function refused(j, status) {
  const code = j.code || (status === 429 ? 'rate-floor' : status === 401 ? 'auth' : 'error');
  console.error(`vibespace-msg: refused [${code}] — ${j.error || 'refused (HTTP ' + status + ')'}`);
  for (const c of Array.isArray(j.candidates) ? j.candidates : []) console.error(`    ${c.conversationId || c.groupId}${c.name ? '  "' + c.name + '"' : ''}`);
  if (REMEDY[code]) console.error('  → ' + REMEDY[code]);
  process.exit(1);
}
async function call(method, p, body) {
  const res = await fetch(API + p, {
    method, headers: { 'Content-Type': 'application/json', Authorization: 'Bearer ' + TOKEN },
    body: body === undefined ? undefined : JSON.stringify(body),
  }).catch((e) => ({ _neterr: e.message }));
  if (res._neterr) { console.error('vibespace-msg: server unreachable (' + res._neterr + ')'); process.exit(3); }
  let j = {};
  try { j = await res.json(); } catch { }
  if (j.error || !res.ok) refused(j, res.status);
  return j;
}

const USAGE = `vibespace-msg — message other agent sessions (groups; Task-Group scoped reach)
  vibespace-msg list                              ← sessions you can see/message (name · id · state)
  vibespace-msg group list                        ← the groups you are in (id · members · unread · your notify mode; also: groups)
  vibespace-msg send <name|id|group> "text" [--at <member>]… [--wake] [--yes]
        ← an agent: your direct (two-member) group with it · a group: everyone in it.
          Default: it reaches them on THEIR next turn (free). @name in the text, --at <name|id>, or --wake, wakes them NOW (a billed turn each).
          Every @ is resolved to a member's id when you send: an @ that names no member (or two) is refused with the candidates.
          Waking more than 5 at once is refused with the count until you add --yes; at most 8 wakes per minute are yours.
  vibespace-msg dispatch <agent> --file brief.md | "text"   ← hand a WORKER its next brief: compacted first if idle, then woken (ONE billed turn)
        = send <agent> --wake --compact-first "text". Waits for the compaction (≤ 3 min); says whether it compacted and why not.
          Compacts only a worker in a Task Group you both belong to, idle, with no owner input for 10 min; the compaction
          counts as an unattended turn beside the wake. A retry of the same brief within 10 min re-sends nothing.
  vibespace-msg read <group> [--before <ts>] [--limit N]   ← the group's log (older history on purpose); each message ends with where it
          stands: "waiting for <name>'s next turn" (not handed over yet) / "read by <name>" / muted / left
  vibespace-msg group create <name> <member…> [--context "why"] [--quiet] [--yes]
  vibespace-msg group invite <group> <member…> [--context "why"] [--quiet] [--yes]   ← an invite wakes each invitee (billed) unless --quiet; > 5 need --yes
  vibespace-msg group leave <group> | kick <group> <member> | rename <group> <new name> | archive <group>
  vibespace-msg group notify <group> <next-turn|mention|always|mute>        ← YOUR mode in that group (mention = only what @names you reaches you)
Members: a session name or conversation id · <group>: a group id (g-…) or its name — an ambiguous name is refused with the candidates.
Reach: same Task Group = mutual by default; other groups only if opened by the user.
Inside a Background Work job: list / group list / read / send only (as the conversation that owns the job) — never dispatch.`;

const plural = (n, one, many) => `${n} ${n === 1 ? one : many}`;
/** THE wake echo: every wake is a billed turn, so the count is always said. */
const wakeCount = (n, who = 'agent') => `woke ${plural(n, who, who + 's')} = ${plural(n, 'billed turn', 'billed turns')}`;
const wokeLine = (r) => {
  const bits = [];
  const woke = r.woke || [];
  bits.push(`${wakeCount(woke.length)}${woke.length ? ': ' + woke.join(', ') : ''}`);
  if (r.refused && r.refused.length) bits.push(`${plural(r.refused.length, 'wake', 'wakes')} refused (not billed) — ${r.refused.map((x) => `${x.name}: ${x.reason}`).join('; ')} — they get it on their next turn instead`);
  if (r.nextTurn && r.nextTurn.length) bits.push(`on their next turn (free): ${r.nextTurn.join(', ')}`);
  return bits.join(' · ');
};
const MEMBERSHIP_OPS = new Set(['create', 'invite', 'leave', 'kick', 'rename', 'archive', 'notify']);
/** WHERE A MESSAGE STANDS with its recipients, as one trailing clause (the server's `delivery` rows — the same rule
 *  the user's window shows under the message): " — waiting for beta's next turn" / " — read by beta"; a group ⇒
 *  " — waiting: a, b · read: c". An older server sends no rows ⇒ no clause. */
const deliveryClause = (rows) => {
  if (!Array.isArray(rows) || !rows.length) return '';
  // a handed row's `at` = when the report / wake went out (UTC HH:MM + Z, like every other instant this CLI prints); a row without one says no time
  const hhmm = (ms) => (Number.isFinite(ms) ? ' ' + new Date(ms).toISOString().slice(11, 16) + 'Z' : '');
  const word = (x) => (x.state === 'waiting' ? `waiting for ${x.name}'s next turn` : x.state === 'handed' ? `read by ${x.name}${hhmm(x.at)}` : x.state === 'muted' ? `${x.name} is muted (never reads it)` : x.state === 'left' ? `${x.name} left` : '');
  if (rows.length === 1) { const w = word(rows[0]); return w ? ' — ' + w : ''; }
  const names = (s) => rows.filter((x) => x.state === s).map((x) => x.name);
  const parts = [];
  const named = (s) => rows.filter((x) => x.state === s).map((x) => x.name + (s === 'handed' ? hhmm(x.at) : ''));
  for (const [s, label] of [['waiting', 'waiting'], ['handed', 'read'], ['muted', 'muted'], ['left', 'left']]) if (names(s).length) parts.push(`${label}: ${named(s).join(', ')}`);
  return parts.length ? ' — ' + parts.join(' · ') : '';
};

(async () => {
  if (!verb || verb === 'list') {
    if (!verb) console.log(USAGE + '\n');
    const r = await call('GET', '/api/agent/msg/peers');
    if (!r.peers || !r.peers.length) { console.log('no sessions visible to you right now.'); return; }
    for (const p of r.peers) {
      console.log(`${p.level === 'messageable' ? '✉' : '·'} ${p.name || '(unnamed)'} — ${p.conversationId}`);
      console.log(`    ${p.level}${p.machine ? ' · on ' + p.machine : ''}${p.state ? ' · ' + p.state + (p.stateReason ? ': ' + p.stateReason.slice(0, 60) : '') : ''}`);
    }
    console.log('\n"·" = visible only (cannot be messaged). Send: vibespace-msg send <name|id> "..."');
    return;
  }
  if (verb === 'groups' || (verb === 'group' && args[1] === 'list')) {
    const r = await call('GET', '/api/agent/msg/groups');
    if (!r.groups || !r.groups.length) { console.log('you are in no group yet. vibespace-msg send <agent> "..." starts a direct one; vibespace-msg group create <name> <member…> a group.'); return; }
    for (const g of r.groups) {
      console.log(`${g.id}  "${g.name}"${g.pair ? ' (direct)' : ''}${g.archived ? ' [archived]' : ''} — ${g.unread} unread · your notify: ${g.notify}`);
      console.log(`    members: ${g.members.map((m) => `${m.name}${m.live ? '' : ' (not live)'} [${m.notify}]`).join(', ')} + the user`);
    }
    return;
  }
  if (verb === 'dispatch' || (verb === 'send' && flags.compactFirst)) {
    if (AS_JOB) { console.error('vibespace-msg: refused [job-token] — a dispatch is a conversation\'s verb; a job never compacts a conversation\n  → ' + REMEDY['job-token']); process.exit(1); }
    const to = args[1];
    let text = args[2];
    if (flags.file) {
      if (text) { console.error('vibespace-msg: give the brief as text OR --file, not both'); process.exit(1); }
      try { text = require('node:fs').readFileSync(flags.file, 'utf8'); }   // a node BUILTIN: a host has no checkout, it has node
      catch (e) { console.error(`vibespace-msg: cannot read the brief file ${flags.file} (${e.code || e.message})`); process.exit(1); }
    }
    if (verb === 'send' && !flags.wake) { console.error('vibespace-msg: --compact-first needs --wake (a compaction is only worth paying for before a turn you start now) — or use: vibespace-msg dispatch <agent> --file brief.md'); process.exit(1); }
    if (!to || !text || !text.trim()) { console.error('usage: vibespace-msg dispatch <agent> --file brief.md | "text"   (= send <agent> --wake --compact-first "text")'); process.exit(1); }
    const body = { to, text, compactFirst: true };
    if (flags.yes) body.yes = true;
    if (flags.again) { body.again = true; if (typeof flags.again === 'string') body.attempt = flags.again; }   // verify r2 ②: a fresh attempt (or a retry of a printed nonce)
    console.error('dispatching — an idle worker is compacted first (a large conversation takes 1–2 minutes; this waits up to 3)…');
    const r = await call('POST', '/api/agent/msg/dispatch', body);
    const rec = r.record || {};
    const worker = (rec.target && rec.target.name) || to;
    // verify r1 ③: 'unknown' = no end record was observed (it may have finished); ②: a replay re-sent nothing
    const said = rec.compacted === true ? 'compacted' : rec.compacted === false ? 'NOT compacted' : rec.compacted === 'unknown' ? 'compaction outcome UNKNOWN' : r.replay ? 'ALREADY delivered' : 'no compaction';
    console.log(`dispatched to "${worker}" — ${said}: ${rec.why || ''}`);
    if (rec.compactionCounted) console.log('  the compaction counts as one unattended turn (a model call nobody typed) on the same ceiling as the wake');
    const wk = rec.wake || {};
    if (r.replay) console.log(`  nothing re-sent, nobody woken (not billed)${wk.reason ? ' — ' + wk.reason : ''}`);
    else if (wk.billed) console.log(`  ${wakeCount(1)}${wk.identity ? ' (on ' + wk.identity.name + ')' : ''} — the brief is its next turn`);
    else console.log(`  not woken (not billed)${wk.reason ? ' — ' + wk.reason : ''} — the brief reaches it on its next turn`);
    if (rec.reply && rec.reply.notify) console.log(`  the worker's reply ${rec.reply.words}${r.group ? ` — change it with: vibespace-msg group notify ${r.group.id} <next-turn|mention|always|mute>` : ''}`);
    if (r.attempt) console.log(`  attempt ${r.attempt} — if this answer is lost, retry THIS exact attempt with: vibespace-msg dispatch ${to} --again=${r.attempt} …`);
    if (r.group) console.log(`  posted to your direct group "${r.group.name}" (${r.group.id}); replies arrive in this conversation`);
    return;
  }
  if (verb === 'send') {
    const to = args[1];
    const text = args[2];
    if (!to || !text) { console.error('usage: vibespace-msg send <name|id|group> "text" [--wake]'); process.exit(1); }
    const body = { to, text, wake: !!flags.wake };
    if (atRefs.length) body.at = atRefs;
    if (flags.yes) body.yes = true;
    const r = await call('POST', '/api/agent/msg/send', body);
    if (r.posted) {
      console.log(`posted to ${r.group.pair ? 'your direct group' : 'group'} "${r.group.name}" (${r.group.id})${r.pairCreated ? ' — created just now' : ''}`);
      const w = wokeLine(r);
      if (w) console.log('  ' + w);
      console.log('  replies arrive in this conversation (a report on your next turn, or now if they @name you and you are not muted)');
      return;
    }
    // legacy direct delivery (a server without the groups engine)
    if (r.delivered) console.log(`delivered (${r.lane}${r.machine ? ' via ' + r.machine : ''}) to "${r.peerName || to}" — if they reply, it arrives as a peer message in this conversation`);
    else console.log(`not delivered now (${r.reason}) — ${r.note || 'queued for their next turn'}`);
    return;
  }
  if (verb === 'read') {
    const group = args[1];
    if (!group) { console.error('usage: vibespace-msg read <group> [--before <ts>] [--limit N]'); process.exit(1); }
    const q = new URLSearchParams({ group });
    if (flags.before) q.set('before', flags.before);
    if (flags.limit) q.set('limit', flags.limit);
    const r = await call('GET', '/api/agent/msg/read?' + q.toString());
    console.log(`group "${r.group.name}" (${r.group.id}) — ${r.records.length} record(s), oldest first:`);
    for (const x of r.records) console.log(`- [${x.at}] ${x.kind === 'message' ? x.from + ':' : '(' + x.kind + ')'} ${x.text}${x.kind === 'message' ? deliveryClause(x.delivery) : ''}`);
    if (r.records.length) console.log(`older: vibespace-msg read ${r.group.id} --before ${r.records[0].at}`);
    return;
  }
  if (verb === 'group') {
    const op = args[1];
    const rest = args.slice(2);
    if (AS_JOB && MEMBERSHIP_OPS.has(op)) {
      console.error(`vibespace-msg: refused [job-token] — a job token may list, read and send; it never creates a group or changes membership (group ${op})`);
      console.error('  → ' + REMEDY['job-token']);
      process.exit(1);
    }
    const body = { op };
    if (op === 'create') { body.name = rest[0]; body.members = rest.slice(1); }
    else if (op === 'invite') { body.group = rest[0]; body.members = rest.slice(1); }
    else if (op === 'leave' || op === 'archive') body.group = rest[0];
    else if (op === 'kick') { body.group = rest[0]; body.member = rest[1]; }
    else if (op === 'rename') { body.group = rest[0]; body.name = rest.slice(1).join(' '); }
    else if (op === 'notify') { body.group = rest[0]; body.notify = rest[1]; }
    else { console.log(USAGE); process.exit(1); }
    if (flags.context !== undefined) body.context = flags.context;
    if (flags.quiet) body.quiet = true;
    if (flags.yes && (op === 'create' || op === 'invite')) body.yes = true;
    const r = await call('POST', '/api/agent/msg/group', body);
    const g = r.group;
    if (op === 'create') console.log(`created group "${g.name}" (${g.id}) — members: ${g.members.map((m) => m.name).join(', ')} + the user`);
    else if (op === 'invite') {
      if (r.added && r.added.length) console.log(`added to "${g.name}": ${r.added.join(', ')}`);
      if (r.already && r.already.length) console.log(`already members (nothing done): ${r.already.join(', ')}`);
    } else if (op === 'leave') console.log(`left "${g.name}"${r.archived ? ' — it is archived now (a direct group ends when one side leaves)' : ''}`);
    else if (op === 'kick') console.log(`removed from "${g.name}"${r.archived ? ' — it is archived now' : ''}`);
    else if (op === 'rename') console.log(r.noop ? `already named "${g.name}"` : `renamed to "${g.name}"`);
    else if (op === 'archive') console.log(r.noop ? `"${g.name}" was already archived` : `archived "${g.name}" (its log is kept)`);
    else if (op === 'notify') console.log(r.noop ? `your notify mode in "${g.name}" was already ${r.notify}` : `your notify mode in "${g.name}" is now ${r.notify}`);
    if (op === 'create' || op === 'invite') {
      const n = (r.woke || []).length;
      if (r.quiet) console.log('  --quiet: woke 0 invitees = 0 billed turns; they see the invite on their next turn');
      else console.log(`  ${wakeCount(n, 'invitee')}${n ? ': ' + r.woke.join(', ') : ''}${(r.refused || []).length ? ` · ${plural(r.refused.length, 'wake', 'wakes')} refused (not billed) — ${r.refused.map((x) => `${x.name}: ${x.reason}`).join('; ')} — they see it on their next turn` : ''}`);
    }
    return;
  }
  console.log(USAGE);
})();
