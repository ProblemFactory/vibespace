#!/usr/bin/env node
// vibespace-ask — file something the USER needs to act on (a decision to make,
// input only they can give, something to review). Items land on the user's
// GLOBAL "For you" inbox (taskbar), grouped under THIS session, where they can
// jump straight here to handle them. Scoped to this session by the per-session
// token in the env — you never pass a session id. Run with NO arguments to see
// usage AND this session's open items, so a wrong guess self-corrects.
//
// This is NOT your own working todo list (use your normal todo tool for that),
// and NOT the Task Group checklist (vibespace-task plan-add). File an item here
// ONLY when progress genuinely depends on the user. When the user answers in
// chat, resolve the item yourself.
// lane cli-call-timeouts: THE ONE CALL to the hub (src/cli-call.js in a checkout; its boot-time copy cli-call.js beside
// this file on a host) — every wait bounded by its verb class, ONE line naming the wait on expiry (exit 124); --timeout <s> overrides
const CC = (() => {
  try { return require('node:fs').existsSync(require('node:path').join(__dirname, '..', '..', 'server.js')) ? require('../../src/cli-call.js') : require('./cli-call.js'); } catch { }
  try { return require('./cli-call.js'); } catch { return null; }
})();
if (!CC) { console.error('vibespace-ask: refused — this CLI\'s call helper (cli-call.js) is missing beside it, so it could not bound its wait; nothing was sent — ask the user to reinstall the agent tools (Manage agents → the machine → Install)'); process.exit(2); }
CC.cliStart({ tool: 'vibespace-ask', flags: ['--timeout', '--call-timeout'] });
const api = process.env.VIBESPACE_API;
const token = process.env.VIBESPACE_SESSION_TOKEN;
if (!api || !token) { console.error('vibespace-ask: not running inside a VibeSpace session (missing env)'); process.exit(2); }

// lane cli-one-text-arg (the owner 2026-10-14): ONE TEXT PER FREE-TEXT COMMAND — the rule the four agent CLIs share (PURE
// src/agent-cli-text.js in a checkout; its boot-time copy agent-cli-text.js beside this file on a host). The question
// is ONE argument: a stray word after it is refused by name (exit 2, nothing filed) — it used to be JOINED in, which lost
// the quotes that closed early and hid the bug; --text-file <path> / --text - (stdin) carry a long or quoted question,
// --detail-file <path> (- = stdin) a long --detail; the answer's `chars` is echoed as `sent: N characters`.
const TX = (() => {   // the module by its literal name (test-peer-text-census walks it beside the CLIs)
  try { return require('node:fs').existsSync(require('node:path').join(__dirname, '..', '..', 'server.js')) ? require('../../src/agent-cli-text.js') : require('./agent-cli-text.js'); } catch { }
  try { return require('./agent-cli-text.js'); } catch { return null; }
})();
const TX_IO = { readFile: (p) => require('node:fs').readFileSync(p, 'utf8'), readStdin: () => require('node:fs').readFileSync(0, 'utf8'), stdinIsTTY: (() => { try { return require('node:fs').fstatSync(0).isCharacterDevice(); } catch { return false; } })() };
const DOORS = TX ? TX.takeDoors(process.argv.slice(2), ['text', 'detail']) : { argv: process.argv.slice(2), doors: {}, error: null };
/** the question: ONE argument or its door; a stray word, a door it cannot read ⇒ refused, exit 2, nothing filed */
function oneText(tool, positional, strays) {
  if (!TX) { console.error(`${tool}: refused — this CLI's text rule (agent-cli-text.js) is missing beside it, so stray words cannot be told apart; nothing was filed — ask the user to reinstall the agent tools (Manage agents → the machine → Install)`); process.exit(2); }
  const one = TX.oneText({ tool, what: 'the question', positional, strays, detail: true, doors: DOORS, io: TX_IO });
  if (one.error) { console.error(one.error.replace(/nothing was sent$/, 'nothing was filed')); process.exit(TX.STRAY_EXIT); }
  return one.text;
}

const rawArgs = DOORS.argv;
const opt = (name) => {
  const i = rawArgs.indexOf('--' + name);
  if (i >= 0 && rawArgs[i + 1] !== undefined) { const v = rawArgs[i + 1]; rawArgs.splice(i, 2); return v; }
  const pref = '--' + name + '=';
  const j = rawArgs.findIndex((a) => a.startsWith(pref));
  if (j >= 0) { const v = rawArgs[j].slice(pref.length); rawArgs.splice(j, 1); return v; }
  return undefined;
};
const URGENCIES = (TX && TX.FOR_YOU_URGENCIES) || null;   // lane job-notify-user r4: THE store's own set (agent-cli-text FOR_YOU_URGENCIES) — no second list; an install without the module leaves the store to judge
const urgency = opt('urgency');
let detail = opt('detail');
// --options "A|B|C" (2.369.169, design-user-inbox-reply D3a): one-click answers
// the user can pick in the inbox — the chip's reply IS the label. ≤6 labels of
// ≤40 chars, distinct; the server refuses anything else by name.
const optionsRaw = opt('options');
// Labels go to the route AS TYPED (trimmed only): an empty label ("A||B", a trailing '|')
// is the store's to refuse BY NAME (`options[1] is empty`), never dropped here (inbox r1).
const options = optionsRaw === undefined ? undefined : optionsRaw.split('|').map((x) => x.trim());
// --grant browser:<profile label|id> (lane controls-that-lie): an ask for ACCESS the user grants — the tray draws the grant
// itself («Let this conversation use …»), which changes «Who can use it» and then answers you; an --options label is only
// ever a reply the user sends (it shows as «Reply: …»), so never offer a label that names an action it cannot perform
const grant = opt('grant');
// --notice (2.369.118): the item is FOR THE USER'S INFORMATION, not an ask — it
// lands in the inbox's own Notices section with a grey count, never the red badge.
const noticeIdx = rawArgs.indexOf('--notice');
const kind = noticeIdx >= 0 ? (rawArgs.splice(noticeIdx, 1), 'notice') : undefined;
// --artifact <path|/p/id>… (lane foryou-attachments, owner 2026-10-09): what you want the user to OPEN from this item —
// vibespace-msg's hand-over grammar: every argument after the flag until the next flag (only the first while the question
// is still to come); a path absolute against this shell's cwd, a /p/<id> page link as is. The server checks that each one
// OPENS (a readable file, a design folder, a published page; ≤ 8) — any that would not ⇒ NOTHING is filed (exit 2).
const artifacts = [];
for (let i = rawArgs.indexOf('--artifact'); i >= 0; i = rawArgs.indexOf('--artifact')) {
  const textIn = rawArgs.slice(0, i).some((a) => !a.startsWith('-'));
  let n = 0;
  while (rawArgs[i + 1 + n] !== undefined && !rawArgs[i + 1 + n].startsWith('--') && (textIn || n < 1)) n++;
  for (const v of rawArgs.splice(i, 1 + n).slice(1)) artifacts.push(/^\/p\/[\w-]+\/?$/.test(v) || v.startsWith('/') ? v : require('node:path').resolve(v));
}
const USAGE = [
  'usage — mirror questions for the USER into their tray (the answer names its label and where it is on their screen; they may not be watching this window):',
  '  vibespace-ask "question or decision needed" [--detail "context, options, your recommendation (up to 8000 chars)"] [--urgency low|normal|high|urgent] [--options "A|B|C"] [--grant browser:<profile>] [--notice] [--artifact <path|/p/id>…]',
  '      --artifact = up to 8 things the user should OPEN from the item (a file you want reviewed, a design folder, a published /p/<id> page) —',
  '                   chips under the question, one press opens each; every path after the flag until the next flag, relative to this shell\'s cwd.',
  '                   Each must open NOW (exists, readable, a design holds design.json, a page is published) or NOTHING is filed (exit 2) —',
  '                   fix the named attachment and run vibespace-ask again. Paths and links written in the question / --detail are clickable too',
  '      --options = up to 6 one-click answers (≤40 chars each) — the user\'s reply is then exactly one label (each shows as «Reply: <label>»: a reply, never an action)',
  '      --grant browser:<label|id> = you need a browser profile «Who can use it» keeps from you: the item carries the real grant button — one press',
  '                   adds this conversation to the profile\'s list, then you are answered «Granted …» with how to attach (`vibespace-browser use <id>`).',
  '                   A channel conversation is asked with `vibespace-channels request`; a machine only in words (the user opens it on its row)',
  '      --notice = for their information only (no action needed): its own Notices section, grey count, never the red badge',
  '      long or quoted text: --text-file <path> or --text - (stdin, a heredoc) for the question, --detail-file <path> for --detail;',
  '                   the CLI refuses stray words (the question is ONE argument: a word after it ⇒ exit 2, nothing filed) and answers sent: N characters',
  '  vibespace-ask list                    print this session\'s open items',
  '  vibespace-ask resolve <id|text>       the user answered (in chat counts)? resolve it YOURSELF immediately',
  '  vibespace-ask show <id>               print one item of this session in full (any status, with the user\'s inbox reply)',
  '  vibespace-ask clear <id>              CLEAR an item this session filed: it stays in the tray with its time, its words become',
  '                                        "[cleared at the user\'s request]" (the user clears any item from the For you window)',
  '  a reply from the inbox arrives as a user message opening with [For you reply #<id>] and a quote of your item',
  '  (whenever you ask in chat, ALSO file it here — both channels, always; the FULL content goes in your CHAT reply, the For you tray only notifies; your own working steps still belong in your todo list)',
].join('\n');

async function call(body) {
  const res = await CC.call(api + '/api/agent/user-todo', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json', Authorization: 'Bearer ' + token },
    body: JSON.stringify(body),
  });
  const data = await res.json().catch(() => ({}));
  if (!res.ok && data.code === 'bad-artifact' && Array.isArray(data.refused)) { // lane foryou-attachments: one line per attachment that would not open
    for (const b of data.refused) console.error('vibespace-ask: ' + b.error);
    console.error('nothing was filed — fix the attachment and run vibespace-ask again');
    process.exit(2);
  }
  if (!res.ok) { console.error('vibespace-ask:', data.error || res.status); process.exit(1); }
  return data;
}
const printItems = (items) => {
  if (!items.length) { console.log('  (no open items for this session)'); return; }
  for (const i of items) {
    console.log('  ' + i.id + '  [' + (i.urgency || 'normal') + '] ' + i.text + (i.detail ? '\n      ' + i.detail.split('\n').join('\n      ') : '')
      + (Array.isArray(i.options) && i.options.length ? '\n      options: ' + i.options.join(' | ') : ''));
  }
};
const printOne = (i) => {
  printItems([i]);
  console.log('      status: ' + i.status + (i.resolvedBy ? ' (by ' + i.resolvedBy + ')' : ''));
  if (i.reply && i.reply.text) console.log('      the user replied: ' + i.reply.text.split('\n').join('\n        '));
};

async function main() {
  const [cmd, ...rest] = rawArgs;
  // -h/--help/help print usage — a real agent ran `vibespace-ask --help` and
  // FILED "--help" as a user todo (observed in data). Any flag-looking "text"
  // is a mistake, never a question for the user.
  if (cmd === 'help' || cmd === '-h' || cmd === '--help' || (cmd && cmd.startsWith('-'))) {
    console.log(USAGE);
    if (cmd.startsWith('-') && cmd !== '-h' && cmd !== '--help') process.exit(1);
    return;
  }
  if (!cmd && !DOORS.doors.text) {
    console.log(USAGE + '\n\ncurrent open items:');
    printItems((await call({ list: true })).items || []);
    return;
  }
  if (cmd === 'list') { printItems((await call({ list: true })).items || []); return; }
  if (cmd === 'show') {
    const ref = rest.join(' ').trim();
    if (!ref) { console.error('vibespace-ask: show needs an item id\n' + USAGE); process.exit(1); }
    printOne((await call({ show: ref })).item);
    return;
  }
  if (cmd === 'clear') {
    const ref = rest.join(' ').trim();
    if (!ref) { console.error('vibespace-ask: clear needs an item id (vibespace-ask list prints them)\n' + USAGE); process.exit(1); }
    const r = await call({ clear: ref });
    console.log(r.cleared ? 'cleared ' + ref + ' — it keeps its place and time in the user\'s tray; its words now read "[cleared at the user\'s request]"' : 'already cleared: ' + ref);
    return;
  }
  if (cmd === 'resolve' || cmd === 'done') {
    const ref = rest.join(' ').trim();
    if (!ref) { console.error('vibespace-ask: resolve needs an item id or unique text fragment\n' + USAGE); process.exit(1); }
    const { item } = await call({ resolve: ref });
    console.log('resolved: ' + item.text);
    return;
  }
  if (cmd === 'add' && (rest.length || DOORS.doors.text)) { // tolerated alias: "vibespace-ask add ..." — agents guess it
    return fileItem(oneText('vibespace-ask add', rest[0], rest.slice(1)));
  }
  if (urgency && URGENCIES && !URGENCIES.includes(urgency)) {
    console.error('vibespace-ask: unknown urgency "' + urgency + '" (valid: ' + URGENCIES.join('/') + ')');
    process.exit(1);
  }
  // Default form: the question is ONE argument (lane cli-one-text-arg: never the whole argv joined — a stray word is refused)
  return fileItem(oneText('vibespace-ask', rawArgs[0], rawArgs.slice(1)));
}
async function fileItem(typed) {
  const text = String(typed == null ? '' : typed).trim();
  if (!text) { console.error(USAGE); process.exit(1); }
  if (DOORS.doors.detail) { // --detail-file <path> (- = stdin): the long --detail's door — never beside --detail
    const d = TX.textOf(detail, DOORS.doors.detail, TX_IO, 'by --detail');
    if (d.error) { console.error('vibespace-ask: refused — ' + d.error.replace(/nothing was sent$/, 'nothing was filed')); process.exit(TX.STRAY_EXIT); }
    detail = d.text;
  }
  const body = { add: { text, detail, urgency, kind, options, ...(grant !== undefined ? { grant } : {}) } };
  if (artifacts.length) body.add.artifacts = artifacts; // lane foryou-attachments: judged by the server — any that would not open ⇒ nothing filed
  const answer = await call(body);
  const { item } = answer;
  // lane agent-context-owner-facts (B-7960 b): WHERE it landed is the hub's words (the tray's label in the owner's language +
  // its CURRENT place — src/tray-words.js); never a place written here (the owner may have moved it)
  const tray = answer.tray && typeof answer.tray === 'object' ? answer.tray : {};
  const trayName = tray.name || 'the user\'s tray', trayPhrase = tray.phrase || trayName;
  console.log((item.existing ? 'already in ' + trayName + ' (refreshed): ' : 'added to ' + trayPhrase + ': ') + item.text + '  (' + item.id + ')');
  if (answer.filed && !item.existing) console.log(answer.filed);   // lane chat-needs-you-card: THE line to quote — the hub's words (the card in this conversation + the tray)
  console.log('  ' + TX.sentLine(answer, text, detail));   // lane cli-one-text-arg: the route's count — a cut is visible here
  if (Array.isArray(item.options) && item.options.length) console.log('  options: ' + item.options.join(' | ') + '  (a chip reply arrives as exactly that label)');
  if (item.action && item.action.type === 'browser-grant') console.log('  grant: the user sees «Let this conversation use ' + item.action.label + '» — one press adds this conversation to the profile\'s «Who can use it» and answers you');
  for (const a of Array.isArray(item.artifacts) ? item.artifacts : []) console.log('  attached: ' + (a.kind === 'page' ? a.url : a.path) + ' (' + a.kind + (a.host ? ' on ' + a.host : '') + ') — one press opens it from the item');
  if (item.artifactsCut) console.log('NOTE: only the first ' + item.artifactsCut + ' attachments were kept — attach the rest to a second item.');
  // THE CUT, NAMED (2026-09-27): the store keeps a question up to 500 chars and a detail up
  // to 8000 and says on the returned record which cap it hit — a longer --detail used to
  // lose its tail silently (the user read a question whose context stopped mid-sentence)
  if (item.detailCut) console.log('NOTE: your --detail was CUT at ' + item.detailCut + ' characters — the user\'s tray holds only that much and the rest never reached them. Put the whole content in your CHAT reply (the tray is a notification mirror).');
  if (item.textCut) console.log('NOTE: the question itself was CUT at ' + item.textCut + ' characters — keep the question to a sentence or two and put the context in --detail and your CHAT reply.');
  console.log('REMINDER: the tray is only a NOTIFICATION MIRROR — now ALSO write the full question/content (options + your recommendation) in your CHAT REPLY to the user. Do not end the turn with the tray as the only copy. If you mention it, say "' + trayPhrase + '" — never "your inbox".');
}
main().catch((e) => { console.error('vibespace-ask:', e.message); process.exit(1); });
