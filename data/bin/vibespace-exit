#!/usr/bin/env node
// vibespace-exit — ON-DEMAND egress through a paired remote machine. Use this
// ONLY when a specific request needs THAT machine's network position (a
// region, an internal/VPN network, a fixed source IP) — NOT for your whole
// session. By default you go direct (this instance's own network); reach for
// an exit deliberately, for the one command that needs it.
//
// Two ways to use a machine's network:
//   • BORROW its egress (a SOCKS proxy) — the tool runs HERE, only its network
//     path is the remote machine. Works for proxy-aware TCP tools:
//         eval "$(vibespace-exit use <machine>)"     # sets ALL_PROXY/HTTPS_PROXY for THIS shell line
//         # or grab the URL and point one command at it:
//         curl --proxy "$(vibespace-exit url <machine>)" https://ifconfig.me
//   • RUN the command ON the machine — the universal fallback. Use it when the
//     tool ignores proxies, or you need ICMP / UDP / that machine's own DNS:
//         vibespace-exit run <machine> -- ping -c1 10.0.0.5
//         vibespace-exit run <machine> -- curl -s https://internal.corp/health
//
// SOCKS5 is NOT universal: it can't carry ICMP (ping/traceroute), UDP is
// spotty, and a tool has to honor the proxy. When `use` won't do, `run` will.
// WHO MAY (lane-pairing ⑥): the user opens each machine to conversations under
// "Who can use it" (Remote tab → the machine's exit icon) — TWO separate grants:
// borrow its network (use / url) and run commands on it (run, as the machine's
// user, up to 30 s; optionally "ask me each time" — the user's Allow in For you,
// 60 s, else refused). `vibespace-exit list` shows what THIS conversation may do.
// Background Work jobs (jbt_) can never use an exit.
// THE SHELL IS THE MACHINE'S (lane-exit-run-output, 2026-10-01): `run` hands the machine ONE line and the machine's
// agent runs it under the interpreter it has — cmd.exe on Windows (`cmd.exe /d /s /c "<line>"`: one line, join steps
// with & or &&, %VAR% and inner quotes are cmd's own), `sh -lc` everywhere else. A command that could not START (no
// such interpreter, not executable) is said by name and this CLI exits with the shell's own code (127 / 126) —
// never a bare "exit 1". The first 4 KiB of stdout and stderr of every run are kept on the machine's command list
// and shown in the user's chat card; `runs` lists this conversation's own runs with those heads.
// FILES (lane exit-transfer, 2026-10-03): `pull` / `push` move ONE regular file between here and the machine under the
// SAME grant as `run` (and its "ask me each time"), through the machine's own file ops — no shell, no 30 s cap, no
// output bound: up to the user's limit (default 1 GiB), sha256-checked on both ends, never half-kept on failure. A pull
// lands under this conversation's project directory, /tmp or ~/Downloads (default: ./<the remote file's name>).
const api = process.env.VIBESPACE_API;
const token = process.env.VIBESPACE_SESSION_TOKEN;
if (!api || !token) { console.error('vibespace-exit: not running inside a VibeSpace session (missing env)'); process.exit(2); }

const args = process.argv.slice(2);
const USAGE = [
  'usage — borrow a paired machine\'s network for a SINGLE command (not your whole session):',
  '  vibespace-exit list                     machines open to THIS conversation (network: yes/no · commands: yes/ask/no)',
  '  vibespace-exit use <machine>            print shell exports (ALL_PROXY/HTTPS_PROXY) for a proxy-aware command:',
  '                                            eval "$(vibespace-exit use mac)"; curl https://ifconfig.me',
  '  vibespace-exit url <machine>            print just the socks5h://<user>:<pass>@127.0.0.1:PORT url (for --proxy; the',
  '                                            credentials are THIS conversation\'s — the port refuses every other client)',
  '  vibespace-exit run <machine> -- <cmd>   run <cmd> ON the machine as its user, up to 30 s (universal: ICMP/UDP/proxy-unaware/its DNS);',
  '                                            with "ask me each time" it first waits (≤ 60 s) for the user\'s Allow.',
  '                                            The machine picks the shell: Windows runs the line under cmd.exe (ONE line — join',
  '                                            steps with & or &&; %VAR% and inner quotes are cmd\'s own), everything else under sh -lc.',
  '                                            A command that could not start is said by name (exit 127 not found / 126 not executable).',
  '  vibespace-exit runs [<machine>] [--limit N]',
  '                                          this conversation\'s own recent runs there (newest first): the verdict, the duration and',
  '                                            the first line of output — the machine keeps the first 4 KiB of stdout and stderr of',
  '                                            every run (the user sees them on the chat card and the machine\'s command list)',
  '',
  '  vibespace-exit pull <machine> <remote-path> [<local-path>] [--overwrite]',
  '                                          copy ONE file from the machine to here (needs "run"; no shell, no 30 s cap): the',
  '                                            remote path is absolute (C:\\Users\\me\\out.zip or /home/me/out.zip); it lands at',
  '                                            <local-path> (default ./<its name>) under the project, /tmp or ~/Downloads;',
  '                                            sha256-checked; an existing file is replaced only with --overwrite. A folder: archive',
  '                                            it first with `run`. Bounded by the user\'s limit (default 1 GiB).',
  '  vibespace-exit push <local-path> <machine> <remote-path> [--overwrite]',
  '                                          copy ONE file from here to the machine (same rules; the machine\'s agent must be',
  '                                            2.369.205 or later). Prints where it landed, the size and the sha256.',
  '',
  '  <machine> = id / name / unique name substring (omit if only one machine is open to you).',
  '  The user decides who may: Remote tab → the machine\'s exit icon → "Who can use it" (network and commands are two grants).',
  '  Use an exit ONLY when a request needs that machine\'s network position; otherwise go direct.',
].join('\n');
const WAY_OUT = '  way out: ask the user to allow this conversation under "Who can use it" on the machine row (Remote tab)';
// the ONE wording of a spawn failure (src/exit-shell.js spawnFailureText — this file ships alone to every host, so it
// carries the three sentences it prints rather than requiring the module)
function describeSpawn(r) {
  const code = r.spawnError.code, what = r.interpreter || 'sh';
  if (code === 'ENOENT') return `${what}: not found on that machine`;
  if (code === 'EACCES' || code === 'EPERM') return `${what}: permission denied on that machine`;
  if (code === 'ENOEXEC') return `${what}: not executable on that machine`;
  if (code === 'ESHELLLINE') return String(r.spawnError.message || 'the shell line could not be run whole').slice(0, 200);
  return `${code}: ${String(r.spawnError.message || '').slice(0, 200)}`;
}

// every refusal prints the server's sentence (it names the grant this conversation lacks — never another one);
// a missing grant adds the way out
function fail(data, status) {
  console.error('vibespace-exit:', (data && data.error) || status);
  if (data && data.code === 'not_granted') console.error(WAY_OUT);
  // a command that could not START exits with the shell's own code (127 not found / 126 not executable) — the server
  // names it (`exitCode`); every other refusal is 1
  process.exit(data && data.code === 'spawn_failed' && Number.isInteger(data.exitCode) ? data.exitCode : 1);
}
async function get(path) {
  const res = await fetch(api + path, { headers: { Authorization: 'Bearer ' + token } });
  const data = await res.json().catch(() => ({}));
  if (!res.ok) fail(data, res.status);
  return data;
}
async function post(path, body) {
  const res = await fetch(api + path, { method: 'POST', headers: { 'Content-Type': 'application/json', Authorization: 'Bearer ' + token }, body: JSON.stringify(body) });
  const data = await res.json().catch(() => ({}));
  if (!res.ok) fail(data, res.status);
  return data;
}
// a POST whose answer may be minutes away (a pull answers once the file landed): plain http(s).request, which sets no
// deadline — global fetch gives up on an answer's headers after 300 s (UND_ERR_HEADERS_TIMEOUT), and the hub then stops
// the transfer between windows (verify r2: a pull longer than 5 min never landed)
function postLong(path, body) {
  const u = new URL(api + path), raw = Buffer.from(JSON.stringify(body));
  return new Promise((resolve, reject) => {
    const req = require(u.protocol === 'https:' ? 'https' : 'http').request(u, { method: 'POST', headers: { 'Content-Type': 'application/json', 'Content-Length': raw.length, Authorization: 'Bearer ' + token } }, (res) => {
      const chunks = [];
      res.on('data', (d) => chunks.push(d));
      res.on('end', () => {
        let data = {};
        try { data = JSON.parse(Buffer.concat(chunks).toString('utf8')); } catch { }
        if (res.statusCode >= 400) fail(data, res.statusCode); else resolve(data);
      });
      res.on('error', reject);
    });
    req.on('error', reject);
    req.end(raw);
  });
}

async function main() {
  const [cmd, ...rest] = args;
  if (!cmd || cmd === 'help' || cmd === '-h' || cmd === '--help') { console.log(USAGE); return; }

  if (cmd === 'list') {
    const { exits } = await get('/api/agent/exit');
    if (!exits.length) { console.log('  (no machine is open to this conversation — ask the user: Remote tab → the machine\'s exit icon → "Who can use it")'); return; }
    for (const e of exits) {
      const g = e.grants || {};
      console.log(`  ${e.name}${e.online ? '' : ' (offline)'}   network: ${g.use ? 'yes' : 'no'} · commands: ${g.run ? (g.runAsk ? 'ask' : 'yes') : 'no'}${e.active ? '  [active: socks5h://127.0.0.1:' + e.localPort + ']' : ''}   id=${e.id}`);
    }
    return;
  }

  if (cmd === 'runs') {
    // vibespace-exit runs [<machine>] [--limit N] — THIS conversation's own runs (the server answers nothing of another's)
    const li = rest.indexOf('--limit');
    const limit = li >= 0 ? Number(rest[li + 1]) || 50 : 50;
    const machine = rest.filter((a, i) => a !== '--limit' && i !== (li >= 0 ? li + 1 : -1)).join(' ').trim() || undefined;
    const { runs } = await get('/api/agent/exit/runs?' + new URLSearchParams({ ...(machine ? { machine } : {}), limit: String(limit) }).toString());
    if (!runs.length) { console.log(machine ? `  no command of this conversation has run on "${machine}" yet` : '  no command of this conversation has run on a machine yet'); return; }
    for (const r of runs) {
      const when = new Date(r.at).toISOString().replace('T', ' ').slice(0, 19);
      const verdict = r.outcome === 'spawn_failed' ? `could not start — ${r.spawnError && r.spawnError.code ? describeSpawn(r) : '?'}`
        : r.outcome === 'timed_out' ? 'timed out after 30 s' : r.outcome === 'refused' ? `refused (${r.refusal})`
        : r.transfer ? `${r.transfer.verb === 'push' ? 'pushed' : 'pulled'} ${r.transfer.bytes} bytes` : `exit ${r.code == null ? '?' : r.code}`;
      const secs = `${(Math.max(0, Number(r.ms) || 0) / 1000).toFixed(1)} s`;
      console.log(`  ${when}  ${r.machine}  ${verdict} · ${secs}${r.interpreter ? ' · ' + r.interpreter : ''}  ${r.cmd.length > 100 ? r.cmd.slice(0, 99) + '…' : r.cmd}`);
      const first = (r.stderr && r.stderr.trim() ? r.stderr : r.stdout || '').split('\n').find((l) => l.trim());
      if (first) console.log(`      ${r.stderr && r.stderr.trim() ? 'stderr' : 'stdout'}: ${first.slice(0, 200)}${(r.cut && (r.cut.stdout || r.cut.stderr)) ? '  (cut at 4 KiB)' : ''}`);
    }
    return;
  }

  if (cmd === 'pull' || cmd === 'push') {
    const fs = require('fs'), path = require('path');
    const overwrite = rest.includes('--overwrite');
    const words = rest.filter((a) => a !== '--overwrite');
    const nameOf = (p) => String(p).split(/[\\/]/).filter(Boolean).pop() || '';
    const need = cmd === 'pull' ? 'vibespace-exit pull <machine> <remote-path> [<local-path>] [--overwrite]' : 'vibespace-exit push <local-path> <machine> <remote-path> [--overwrite]';
    if (words.length < (cmd === 'pull' ? 2 : 3) || words.length > 3) { console.error('usage: ' + need); process.exit(2); }
    // "ask me each time": the call waits for the user's Allow first — said once it outlives a second
    const note = setTimeout(() => console.error("# waiting for the user's approval (up to 60 s) if the machine asks…"), 1000);
    if (cmd === 'pull') {
      const [machine, remote, word] = words;
      let local = path.resolve(word || nameOf(remote));
      try { if (fs.statSync(local).isDirectory()) local = path.join(local, nameOf(remote)); } catch { }
      const r = await postLong('/api/agent/exit/pull', { machine, remote, local, overwrite });
      clearTimeout(note);
      console.log(r.line);
      return;
    }
    const [word, machine, remote] = words;
    const local = path.resolve(word);
    let st = null;
    try { st = fs.statSync(local); } catch { }
    if (!st || !st.isFile()) { clearTimeout(note); console.error('vibespace-exit push: not a regular file here: ' + local); process.exit(1); }
    const u = new URL(api + '/api/agent/exit/push?' + new URLSearchParams({ machine: machine || '', remote, local, size: String(st.size), ...(overwrite ? { overwrite: '1' } : {}) }).toString());
    // the request BODY is the file, streamed; the answer may come before the last byte (a refusal) — then sending stops
    const r = await new Promise((resolve, reject) => {
      const src = fs.createReadStream(local);
      const req = require(u.protocol === 'https:' ? 'https' : 'http').request(u, { method: 'POST', headers: { Authorization: 'Bearer ' + token, 'Content-Type': 'application/octet-stream' } }, (res) => {
        const chunks = [];
        res.on('data', (d) => chunks.push(d));
        res.on('end', () => {
          let data = {};
          try { data = JSON.parse(Buffer.concat(chunks).toString('utf8')); } catch { }
          src.destroy(); req.destroy();
          clearTimeout(note);
          if (res.statusCode >= 400) fail(data, res.statusCode); else resolve(data);
        });
      });
      req.on('error', (e) => { if (!req.res) reject(e); });
      src.on('error', (e) => { req.destroy(); reject(e); });
      src.pipe(req);
    });
    console.log(r.line);
    return;
  }

  if (cmd === 'use' || cmd === 'url') {
    const machine = rest[0];
    const r = await post('/api/agent/exit/use', { machine });
    if (cmd === 'url') { console.log(r.url); return; }
    // shell exports honored by curl/git/most CLIs; covers proxy-aware TCP
    console.log(`export ALL_PROXY=${r.url}`);
    console.log(`export HTTPS_PROXY=${r.url}`);
    console.log(`export HTTP_PROXY=${r.url}`);
    console.error(`# egress via "${r.machine}" (socks5h, this conversation's own credentials in the url — a tool must send SOCKS5 username/password). NOT universal — for ICMP/UDP/proxy-unaware tools use: vibespace-exit run ${machine || r.machine} -- <cmd>`);
    return;
  }

  if (cmd === 'run') {
    // vibespace-exit run <machine> -- <cmd...>
    const dashdash = rest.indexOf('--');
    let machine, cmdParts;
    if (dashdash >= 0) { machine = rest.slice(0, dashdash).join(' ').trim() || undefined; cmdParts = rest.slice(dashdash + 1); }
    else { machine = rest[0]; cmdParts = rest.slice(1); } // tolerate a missing --
    const command = cmdParts.join(' ').trim();
    if (!command) { console.error('vibespace-exit run: need a command after `--`, e.g. vibespace-exit run mac -- curl -s https://ifconfig.me'); process.exit(2); }
    // "ask me each time": the route answers once — after the user's Allow (≤ 60 s) and the run (≤ 30 s). Say so
    // when the call outlives a second and the machine asks.
    const waitNote = setTimeout(async () => {
      try {
        const res = await fetch(api + '/api/agent/exit', { headers: { Authorization: 'Bearer ' + token } }); // never get(): a failed list must not end the waiting run
        const { exits } = res.ok ? await res.json() : { exits: [] };
        const r0 = String(machine || '').toLowerCase();
        const hit = (exits || []).filter((e) => !r0 || e.id === machine || String(e.name).toLowerCase().includes(r0));
        if (hit.some((e) => e.grants && e.grants.runAsk)) console.error("# waiting for the user's approval (up to 60 s)…");
      } catch { }
    }, 1000);
    const r = await post('/api/agent/exit/run', { machine, cmd: command });
    clearTimeout(waitNote);
    if (r.stdout) process.stdout.write(r.stdout.endsWith('\n') ? r.stdout : r.stdout + '\n');
    if (r.stderr) process.stderr.write(r.stderr.endsWith('\n') ? r.stderr : r.stderr + '\n');
    if (r.line) console.error(r.line);
    // the exit code is a NUMBER or nothing (an older daemon's maxBuffer overflow named a string; process.exit throws on it)
    process.exit(r.timedOut ? 124 : (Number.isInteger(r.code) ? r.code : (r.code == null ? 0 : 1)));
  }

  console.error(`vibespace-exit: unknown command "${cmd}"\n`);
  console.log(USAGE);
  process.exit(2);
}
main().catch((e) => { console.error('vibespace-exit:', e.message); process.exit(1); });
