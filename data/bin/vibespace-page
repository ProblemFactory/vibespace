#!/usr/bin/env node
// vibespace-page — publish self-contained HTML (mockups, reports, one-page
// tools) to THIS VibeSpace instance and get a share URL (2.366.0, STATIC
// tracked, in AGENT_TOOLS — ships to remote hosts). Designs have their own
// tool, vibespace-design (the Design window). Auth: VIBESPACE_SESSION_TOKEN
// (agent session) or VIBESPACE_JOB_TOKEN (Background Work). Full manual:
// vibespace-docs pages.
'use strict';
const fs = require('fs');
const path = require('path');
const API = process.env.VIBESPACE_API;
const TOKEN = process.env.VIBESPACE_SESSION_TOKEN || process.env.VIBESPACE_JOB_TOKEN;
if (!API || !TOKEN) { console.error('vibespace-page: not inside a VibeSpace session (VIBESPACE_API / token missing)'); process.exit(2); }

const args = process.argv.slice(2);
const verb = args[0];
const flag = (name) => { const i = args.indexOf(name); return i >= 0 ? (args[i + 1] ?? '') : undefined; };
const has = (name) => args.includes(name);

const USAGE = `vibespace-page — host self-contained HTML on this VibeSpace and share it
  vibespace-page publish <file.html> --title "<what the user would call it>" [--public]
        ← uploads a snapshot, prints the share URL (private by default: viewers log in;
          --public = anyone with the link). Same file path again = same URL, new snapshot.
  vibespace-page list   ← pages published from this session
  vibespace-page unpublish <page>                    ← take it down: its link then answers
                          "this page was unpublished" (410); publishing the file again = a NEW link
  vibespace-page visibility <page> public|private   ← who may open it (private: viewers log in)
        <page> = the published file's path, the page id (pg…) or its /p/… link — one this
                 conversation published
Hosted pages run sandboxed (opaque origin): their scripts run, they cannot reach VibeSpace.
Designs (screens, mockups to watch while you draft them): vibespace-design — vibespace-docs design.`;

async function call(method, p, { body, headers } = {}) {
  const res = await fetch(API + p, { method, headers: { Authorization: 'Bearer ' + TOKEN, ...(headers || {}) }, body }).catch((e) => ({ _neterr: e.message }));
  if (res._neterr) { console.error('vibespace-page: server unreachable (' + res._neterr + ')'); process.exit(3); }
  let j = {};
  try { j = await res.json(); } catch { }
  if (!res.ok || j.error) { console.error(j.error || `HTTP ${res.status}`); process.exit(1); }
  return j;
}

(async () => {
  if (!verb || verb === 'help' || verb === '--help' || verb === '-h') { console.log(USAGE); return; }

  if (verb === 'publish') {
    const file = args[1];
    if (!file || file.startsWith('--')) { console.error('usage: vibespace-page publish <file.html> --title "<title>" [--public]'); process.exit(2); }
    const abs = path.resolve(file);
    let html;
    try { html = fs.readFileSync(abs); } catch (e) { console.error(`cannot read ${abs}: ${e.message}`); process.exit(2); }
    if (!/\.html?$/i.test(abs)) { console.error('only .html files can be published'); process.exit(2); }
    if (html.length > 25 * 1024 * 1024) { console.error('file too large (>25MB)'); process.exit(2); }
    const title = flag('--title') ?? flag('--name') ?? path.basename(abs, path.extname(abs));
    const q = new URLSearchParams({ title, path: abs });
    if (has('--public')) q.set('public', '1'); // omitted = keep the page's current visibility (the user may have flipped it)
    const r = await call('POST', '/api/agent/pages/publish?' + q.toString(), { body: html, headers: { 'Content-Type': 'text/html; charset=utf-8' } });
    const p = r.page || {};
    const url = p.url || p.path;
    console.log(`published: ${p.path || url}`);
    if ((p.path || url).startsWith('/')) {
      console.log('Write that PATH verbatim in your reply — the chat UI turns it into a working link');
      console.log('against the address the user actually opens VibeSpace at. Do NOT prefix it with a');
      console.log('hostname or IP: this server cannot know how the user reaches it (reverse proxy,');
      console.log('tunnel, another hostname), and a guess produces a link that resolves only here.');
    }
    console.log(p.public ? '(public — anyone with the link can view)' : '(private — viewers must be logged in to this VibeSpace; --public opens it, or the user flips it in the chat status bar)');
    if (p.replaced) console.log('(replaced the previous snapshot of this file — same URL)');
    return;
  }

  // B-f694: take one of this conversation's pages down, or flip who may open it. An id or a /p/ link goes as is;
  // anything else is the published file's path, made absolute HERE (the server keys a page by host + absolute path).
  const pageRef = (r) => (/(?:^|\/p\/)pg[a-z0-9]{10}(?:$|[/?#])/.test(r) ? r : path.resolve(r));
  const postJson = (p, body) => call('POST', p, { body: JSON.stringify(body), headers: { 'Content-Type': 'application/json' } });
  if (verb === 'unpublish') {
    if (!args[1] || args[1].startsWith('--')) { console.error('usage: vibespace-page unpublish <file.html | page id | /p/ link>'); process.exit(2); }
    const p = (await postJson('/api/agent/pages/unpublish', { ref: pageRef(args[1]) })).page || {};
    console.log(`unpublished: ${p.path} (${p.name}) — the link now answers "this page was unpublished"; publishing the file again gives a NEW link`);
    return;
  }

  if (verb === 'visibility') {
    const vis = args[2];
    if (!args[1] || args[1].startsWith('--') || (vis !== 'public' && vis !== 'private')) { console.error('usage: vibespace-page visibility <file.html | page id | /p/ link> public|private'); process.exit(2); }
    const p = (await postJson('/api/agent/pages/visibility', { ref: pageRef(args[1]), visibility: vis })).page || {};
    console.log(`${p.path} (${p.name}) is now ` + (p.public ? 'public — anyone with the link can view' : 'private — viewers must be logged in to this VibeSpace'));
    return;
  }

  if (verb === 'list') {
    const r = await call('GET', '/api/agent/pages');
    if (!r.pages || !r.pages.length) { console.log('no pages published from this session yet.'); return; }
    for (const p of r.pages) console.log(`${p.public ? 'public ' : 'private'}  ${p.url || p.path}  ${p.name}  (${new Date(p.updatedAt).toISOString().slice(0, 16)}Z)`);
    return;
  }

  console.error(`unknown verb "${verb}"\n` + USAGE);
  process.exit(2);
})().catch((e) => { console.error('vibespace-page: ' + (e && e.message || e)); process.exit(1); });
