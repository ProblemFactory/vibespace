#!/usr/bin/env node
// vibespace-vault — the vault's state and its lock, for an agent (lane vault-e2e-password). Every credential this VibeSpace
// stores is sealed under ONE vault key that only the user's SECOND password opens, and after every restart the vault stays
// locked until the user unlocks it from the page. An agent may SEE the state (`status`) and LOCK it (`lock` — a suspected
// leak, the end of a sensitive task); it never unlocks it, sets it up or changes the password: those are people's doors, and
// the password is never an agent's to ask for. A LOCKED vault has already told the user what waits on it (lane
// vault-locked-refusal-notice: For you names every caller it stopped) — an agent never asks them to unlock. Scoped by the per-session token in the env.
const API = process.env.VIBESPACE_API;
const TOKEN = process.env.VIBESPACE_SESSION_TOKEN || process.env.VIBESPACE_JOB_TOKEN;
if (!API || !TOKEN) { console.error('vibespace-vault: not running inside a VibeSpace session (missing env)'); process.exit(2); }

const USAGE = [
  'usage — the vault that seals every credential this VibeSpace stores (unlocked only by the user\'s second password):',
  '  vibespace-vault [status]   the state: unlocked / locked / not set up',
  '  vibespace-vault lock       lock it now — every stored credential stays sealed until the user unlocks it again',
  '  (unlock, set up and change are the user\'s, from the page: ⚙ System ▸ Vault… — never ask for the password)',
].join('\n');

const SAYS = {
  unlocked: 'unlocked — the stored credentials open',
  locked: 'LOCKED — every stored credential stays sealed until the user unlocks it from the page; the user has already been told (their For you tray names what is waiting on it) — do not ask them to unlock it or for its password: wait, or do other work, and try again later',
  not_set_up: 'not set up — the user sets the second password in ⚙ System ▸ Vault…',
};

async function call(method, route) {
  const res = await fetch(API + route, { method, headers: { 'Content-Type': 'application/json', Authorization: 'Bearer ' + TOKEN } });
  const data = await res.json().catch(() => ({}));
  if (!res.ok) { console.error('vibespace-vault: ' + (data.error || 'HTTP ' + res.status)); process.exit(1); }
  return data;
}
const when = (at) => { try { return new Date(at).toISOString().slice(0, 16).replace('T', ' ') + 'Z'; } catch { return '?'; } };
function print(d) {
  console.log('vault: ' + (SAYS[d.state] || d.state));
  if (d.state === 'locked' && d.lockedSince) console.log('  locked since ' + when(d.lockedSince));
}

async function main() {
  const args = process.argv.slice(2);
  const [cmd = 'status'] = args;
  if (args.length > 1 || cmd === 'help' || cmd === '-h' || cmd === '--help') { console.log(USAGE); if (args.length > 1) process.exit(2); return; }
  if (cmd === 'status') return print(await call('GET', '/api/agent/vault/state'));
  if (cmd === 'lock') { const d = await call('POST', '/api/agent/vault/lock'); print(d); return; }
  console.error('vibespace-vault: unknown command "' + cmd + '"\n' + USAGE);
  process.exit(2);
}
main().catch((e) => { console.error('vibespace-vault:', e.message); process.exit(1); });
