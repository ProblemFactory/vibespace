#!/usr/bin/env node
// vibespace-vault — the vault's state and its lock, for an agent (lane vault-e2e-password). Every credential this VibeSpace
// stores is sealed under ONE vault key that only the user's SECOND password opens, and after every restart the vault stays
// locked until the user unlocks it from the page. An agent may SEE the state (`status`) and LOCK it (`lock` — a suspected
// leak, the end of a sensitive task); it never unlocks it, sets it up or changes the password: those are people's doors, and
// the password is never an agent's to ask for. A LOCKED vault has already told the user what waits on it (lane
// vault-locked-refusal-notice: For you names every caller it stopped) — an agent never asks them to unlock. Scoped by the
// per-session token in the env. `totp <name>` (design q-047 L1, lane vault-totp) prints a two-step code's CURRENT code —
// when the user granted that code to this conversation — never its seed.
// lane vault-run-door (design q-043 §8): `run` — a command that needs a stored secret runs WITHOUT the agent seeing it: the
// HUB resolves each `vault://…` reference, injects the value (env / a 0600 file / stdin — never the command line), spawns
// the command and answers its output with every value and its encoded forms blanked to `[vault:…]`; the user opens each
// entry for runs and allows each new command shape once or always. `list` names what this conversation may reference.
// Nothing here ever prints a value: the hub never sends one.
// lane cli-call-timeouts: THE ONE CALL to the hub (src/cli-call.js in a checkout; its boot-time copy cli-call.js beside
// this file on a host) — every wait bounded by its verb class, ONE line naming the wait on expiry (exit 124); --call-timeout <s> overrides
const CC = (() => {
  try { return require('node:fs').existsSync(require('node:path').join(__dirname, '..', '..', 'server.js')) ? require('../../src/cli-call.js') : require('./cli-call.js'); } catch { }
  try { return require('./cli-call.js'); } catch { return null; }
})();
if (!CC) { console.error('vibespace-vault: refused — this CLI\'s call helper (cli-call.js) is missing beside it, so it could not bound its wait; nothing was sent — ask the user to reinstall the agent tools (Manage agents → the machine → Install)'); process.exit(2); }
CC.cliStart({ tool: 'vibespace-vault', flags: ['--call-timeout'] });
  // lane vault-mint-put (design q-043 §9): `mint` — the HUB makes a random secret in its OWN namespace `agent:<this conversation>/<name>` and seals it (the agent never sees the value); `put` — seal a value the agent already has (a 0600 file / stdin, never argv). An agent can CREATE in its namespace but can never READ a stored value back — the user reveals it.
// lane vault-manual-and-lock (design q-043 D4): `request <vault://…> --for "<purpose>"` asks the user for an entry with what it
// is for (ONE question in their For you tray — nothing waits on it); their answer is a grant (one run, or every run for 8
// hours; a lock ends it). `uses` = this conversation's grants, its open requests and its own uses (entry, purpose, when,
// outcome, receipt) — names and codes, never a value.
// lane vault-standing-request (the owner 2026-10-30: 「能不能让 agent 自行申请权限 … 常驻的，跟我配"谁可以用"等效的权限」): `request
// <vault://…> --standing --for "<purpose>" [--host <h>[,<h>…]] [--command "<program> <script>"]` asks ONCE for the STANDING grant
// the user would set on the entry's row — for commands to those hosts, or (a program whose destination VibeSpace cannot read, like
// `python3 transcribe.py`) for that command itself; their Allow keeps it until they take it back (a lock does not end it).
// lane vault-agent-own (the owner 2026-10-26: 「它自己存的使用为啥还要我的允许？」): what THIS conversation stored itself (mint / put,
// `totp add`, `login add`) is its own to use — no switch, no grant, no card (a minted value going to another host than its
// `--for` asks the user once per host). A seed or a password you hold goes in as ITS KIND: `totp add` (the vault computes the
// code) and `login add` (the browser kernel fills it) — never a free `put`; you never need the value again.
// lane vault-paste-request (the owner 2026-10-23: 「应该允许你给我弹一个保险库输入框让我直接 paste 进去」): `request "<what>" --purpose
// "<why>" [--into <row>.<field> | --kind api-key|password|secret] [--name <label>]` — the SAME verb's second shape (the first
// argument is words, not a vault:// reference): ONE item in the user's For you tray with a masked box; the user pastes the
// value (or refuses) and this conversation reads a receipt at its next turn — where it went, never the value.
const fs = require('fs');
const API = process.env.VIBESPACE_API;
const TOKEN = process.env.VIBESPACE_SESSION_TOKEN || process.env.VIBESPACE_JOB_TOKEN;
if (!API || !TOKEN) { console.error('vibespace-vault: not running inside a VibeSpace session (missing env)'); process.exit(2); }

const USAGE = [
  'usage — the vault that seals every credential this VibeSpace stores (unlocked only by the user\'s second password):',
  '  vibespace-vault [status]   the state: unlocked / locked / not set up',
  '  vibespace-vault lock       lock it now — every stored credential stays sealed until the user unlocks it again',
  '  vibespace-vault totp <name> [--json]   the CURRENT two-step code of <name> + the seconds it has left — when this',
  '                             conversation added it (totp add) or the user granted it (Vault window ▸ 用于…); never the seed',
  '  vibespace-vault totp add <name> --from-file <0600 file> | --stdin',
  '                             store a two-step seed you hold (the otpauth:// link or the base32 seed) as a REAL two-step entry:',
  '                             the vault computes its code (`totp <name>`, no grant for this conversation) — you never read it back',
  '  vibespace-vault login add <origin> --user <name> --from-file <0600 file> | --stdin [--totp <name>]',
  '                             store a website login you hold (its password) as a web-login entry, optionally paired with a two-step',
  '                             entry YOU added (totp add): `vibespace-browser login <origin> --user <name>` fills it (the kernel; no grant for this',
  '                             conversation) — you never see the password again',
  '                             A seed or a password goes in as ITS KIND (totp add / login add), never as a free `put`.',
  '  vibespace-vault list       the stored secrets you may use in a run (the ones this conversation stored, the ones the user',
  '                             opened, or granted to you) — a reference each, never a value',
  '  vibespace-vault request <vault://…> --for "<purpose>"',
  '                             ask the user for an entry, with what you will run with it: ONE question in their For you tray;',
  '                             nothing waits on it — `uses` shows their answer (once: your next run · 8h: every run for 8 hours)',
  '  vibespace-vault request <vault://…> --standing --for "<purpose>" [--host <h>[,<h>…]] [--command "<program> <script>"]',
  '                             ask ONCE for a STANDING grant — the same as the user setting «Who may use it…» on its row: no card',
  '                             for commands to those hosts (--host: where the command connects, e.g. api.openai.com), or for THAT',
  '                             command (--command: a program whose destination VibeSpace cannot read — an interpreter and its',
  '                             script, read from this folder; a changed program or script asks again). It stays until the user',
  '                             takes it back (a lock does not end it — nothing runs while it is locked). `uses` / `list` show it.',
  '                             When a card asks for each run of a command, this is the way to stop it — ask once.',
  '  vibespace-vault request "<what you need, in the user\'s words>" --purpose "<what you will do with it>"',
  '                             [--into <row>.<field> | --kind api-key|password|secret] [--name <label>] [--host <h>[,<h>…]]',
  '                             ask the user to PASTE a secret you do not have (a password, an API key): ONE item in their For you',
  '                             tray with a masked box — the value goes straight into the vault, never to you. --into = an',
  '                             Integrations field (e.g. llm.apiKey — VibeSpace uses it there itself); otherwise a NEW vault entry',
  '                             (--kind, --name = its label; --host = where you will use it, e.g. 192.168.1.1 — then, unless the user',
  '                             turned it off, THIS conversation may use it in commands to those hosts for 8 hours with no card; a',
  '                             command to any other host still shows a card (name no host and every command does); a vault lock',
  '                             ends it; the card says so).',
  '                             Nothing waits on it: your next turn says «stored» (where) or «refused».',
  '                             Never ask for a secret in the chat — this is the way.',
  '  vibespace-vault uses       what THIS conversation holds: its grants, its open requests and its own uses of the vault',
  '                             (entry, purpose, when, outcome, receipt) — never a value',
  '  vibespace-vault run [--env NAME=vault://<store>/<row>/<field>]… [--file NAME=vault://…|@<template>]… [--stdin vault://…] [--timeout <s>] -- <command…>',
  '                             run a command that needs a stored secret WITHOUT seeing it: the hub injects it (env / a 0600 file /',
  '                             stdin — never the command line), the user allows each new command shape (once, or always) — a',
  '                             secret THIS conversation put runs without asking anyone; one it MINTED runs without asking for its',
  '                             --for host — another host asks the user once per host, a command whose destination cannot be told',
  '                             (a shell, a script, a tool naming no host it can read) asks every run on a shared instance — and the',
  '                             output comes back with the secret blanked to [vault:<store>/<row>/<field>]. In the command,',
  '                             $VAULT_FILE{NAME} or $VAULT_FILE{<store>/<row>/<field>} is the PATH of a 0600 file holding it; a',
  '                             template file names a value as $VAULT{<store>/<row>/<field>}. Refused by name: tools that print,',
  '                             transform, pack or copy what they read (cat, echo, base64, cp …), wrappers (sudo, xargs …), a value',
  '                             on the command line. vibespace-docs vault = the manual.',
  '',
  '  vibespace-vault mint <name> [--length 24] [--charset ascii-printable|alnum|digits] [--for <host/service>]',
  '      the HUB makes a random secret and seals it under agent:<this conversation>/<name>; you get the name + a',
  '      vault:// reference and NEVER the value (the user can reveal it in ⚙ System ▸ Vault…). For registering an',
  '      account, setting a service password, generating a token — a secret you do not need to read. --for names the',
  '      host it is for: a run sending it there asks nobody; another host asks the user once per host; a command',
  '      whose destination cannot be told (a shell, a script, a tool naming no host it can read, a config file) asks',
  '      the user — once per command shape on their own machine, every run on a shared instance.',
  '  vibespace-vault put <name> --from-file <0600 file> | --stdin',
  '      seal a value you ALREADY have (a key a vendor page gave you) under agent:<this conversation>/<name>. The value',
  '      rides a 0600 file or stdin — NEVER the command line (argv is readable). The vault records that you saw the',
  '      plaintext; rotate it when you can (the transcript\'s copy is not protected). This conversation runs with',
  '      it without asking anyone. A two-step seed or a website password is NOT a put: use totp add / login add.',
  '',
  '  (unlock, set up and change are the user\'s, from the page: ⚙ System ▸ Vault… — never ask for the password)',
].join('\n');

const SAYS = {
  unlocked: 'unlocked — the stored credentials open',
  locked: (d) => 'LOCKED — every stored credential stays sealed until the user unlocks it from the page; the user has already been told (' + (d.tray || 'their tray') + ' names what is waiting on it) — do not ask them to unlock it or for its password: wait, or do other work, and try again later',
  not_set_up: 'not set up — the user sets the second password in ⚙ System ▸ Vault…',
};

async function call(method, route, body) {
  const headers = { Authorization: 'Bearer ' + TOKEN };
  let payload;
  if (body !== undefined) { headers['Content-Type'] = 'application/json'; payload = JSON.stringify(body); }
  const res = await CC.call(API + route, { method, headers, body: payload });
  const data = await res.json().catch(() => ({}));
  if (!res.ok) { console.error('vibespace-vault: ' + (data.error || 'HTTP ' + res.status)); process.exit(1); }
  return data;
}
// a POST whose answer may be minutes away (the user's card ≤ 60 s + the run ≤ 600 s): global fetch gave up on an answer's
// headers after 300 s (vibespace-exit's postLong, the same reason) — the ONE call with that bound (lane cli-call-timeouts)
async function postLong(route, body) {
  const res = await CC.call(API + route, { method: 'POST', headers: { 'Content-Type': 'application/json', Authorization: 'Bearer ' + TOKEN }, body: JSON.stringify(body), cls: 'wake', ms: 60000 + 600000 + 30000 });
  let data = {};
  try { data = JSON.parse(await res.text()); } catch { }
  return { status: res.status, data };
}
// lane agent-context-owner-facts (B-7960): the lock time and the tray are the HUB's words (the owner's zone, named; the tray's
// label + current place) — this file never formats a time or names a tray itself (it ships to hosts in other zones)
const when = (d) => (d.when && d.when.lockedSince) || (Number(d.lockedSince) ? new Date(Number(d.lockedSince)).toISOString() : '?');
// int332 seam: the .331 grant / request / use rows (lane vault-manual-and-lock) carry raw timestamps the hub does not word yet —
// a full ISO stamp (the fallback shape `when` uses above; test-task-injection §8 bans a hand-sliced one), never a sliced UTC
const whenAt = (at) => { try { return new Date(at).toISOString(); } catch { return '?'; } };
function print(d) {
  const say = SAYS[d.state];
  console.log('vault: ' + (typeof say === 'function' ? say(d) : say || d.state));
  if (d.state === 'locked' && d.lockedSince) console.log('  locked since ' + when(d));
}

/** A call whose refusal says its code too (request / uses) — exit 1 on a refusal, the code in parentheses. */
async function callCoded(method, route, body, verb) {
  const headers = { Authorization: 'Bearer ' + TOKEN };
  let payload;
  if (body !== undefined) { headers['Content-Type'] = 'application/json'; payload = JSON.stringify(body); }
  const res = await CC.call(API + route, { method, headers, body: payload });
  const data = await res.json().catch(() => ({}));
  if (!res.ok || !data.ok) { console.error(`vibespace-vault ${verb}: ` + (data.error || 'HTTP ' + res.status) + (data.code ? ` (${data.code})` : '')); process.exit(1); }
  return data;
}

async function requestCmd(rest) {
  const { out, positional } = parseFlags(rest, { '--for': 'value', '--purpose': 'value', '--into': 'value', '--kind': 'value', '--name': 'value', '--host': 'value', '--standing': 'bool', '--command': 'value' });
  if (out['--standing'] || out['--command'] !== undefined) return standingCmd(positional, out);   // lane vault-standing-request
  // lane vault-paste-request: words (not a vault:// reference) ⇒ the PASTE shape — the user pastes a secret you do not have
  if (positional.length === 1 && !positional[0].startsWith('vault://')) return pasteCmd(positional[0], out);
  if (out['--into'] !== undefined || out['--kind'] !== undefined || out['--name'] !== undefined || out['--host'] !== undefined) { console.error('vibespace-vault: --into / --kind / --name / --host belong to a paste request: vibespace-vault request "<what you need>" --purpose "<why>" — for a stored entry it is: request <vault://…> --for "<purpose>"'); process.exit(2); }
  const why = out['--for'] !== undefined ? out['--for'] : out['--purpose'];
  if (positional.length !== 1 || why === undefined) { console.error('vibespace-vault: request <vault://…> --for "<what you will run with it, and why>"  ·  or ask the user to paste one: request "<what>" --purpose "<why>"'); process.exit(2); }
  const d = await callCoded('POST', '/api/agent/vault/request', { entry: positional[0], purpose: why }, 'request');
  if (d.already === 'own' && d.minted) { console.log(`${d.ref} is this conversation's own — the hub minted it${d.for ? ` for ${d.for}` : ' with no --for host'}: ${d.for ? `a run sending it to ${d.for} (or a host under it) runs without asking; ` : ''}another host asks the user once per host, and a command whose destination cannot be told (a shell, a script, a tool naming no host it can read, a config file) asks every run on a shared instance (once per command shape on the user's own machine): vibespace-vault run --env NAME=${d.ref} -- <command>`); return; }   // lane vault-agent-own (round 2)
  if (d.already === 'own') { console.log(`${d.ref} is this conversation's own — it stored it, so it runs without asking anyone: vibespace-vault run --env NAME=${d.ref} -- <command>`); return; }   // lane vault-agent-own
  if (d.already === 'open') { console.log(`${d.ref} is already open for runs — run it (a new kind of command still shows the user its card first)`); return; }
  if (d.already === 'granted') { console.log(`${d.ref} is already granted to this conversation (${d.once ? 'for one run' : 'for every run'} until ${whenAt(d.until)}) — run it`); return; }
  if (d.filed) { console.log(`asked the user for ${d.ref}; nothing waits on it`); console.log(d.filed); }   // lane chat-needs-you-card: the hub's line (the card + the tray)
  else console.log(`asked the user for ${d.ref} — the question is in their For you tray; nothing waits on it`);
  console.log('  their answer: once (your next run with it) · 8h (every run for 8 hours) · deny; a lock ends a grant');
  console.log('  `vibespace-vault uses` shows it when it comes; do other work meanwhile, and do not ask again in the chat');
}

/** lane vault-standing-request: ask ONCE for a STANDING grant on a stored entry — hosts and/or a command shape. */
async function standingCmd(positional, out) {
  const usage = 'vibespace-vault: request <vault://…> --standing --for "<what it is for>" [--host <h>[,<h>…]] [--command "<program> <script>"] — name the hosts its commands connect to, or the command (a program whose destination VibeSpace cannot read)';
  if (!out['--standing']) { console.error('vibespace-vault: --command belongs to a standing request: ' + usage.slice('vibespace-vault: '.length)); process.exit(2); }
  if (positional.length !== 1 || !positional[0].startsWith('vault://') || out['--into'] !== undefined || out['--kind'] !== undefined || out['--name'] !== undefined) { console.error(usage); process.exit(2); }
  const why = out['--for'] !== undefined ? out['--for'] : out['--purpose'];
  if (why === undefined || (out['--host'] === undefined && out['--command'] === undefined)) { console.error(usage); process.exit(2); }
  const hosts = out['--host'] !== undefined ? String(out['--host']).split(',').map((h) => h.trim()).filter(Boolean) : null;
  const d = await callCoded('POST', '/api/agent/vault/request', { entry: positional[0], purpose: why, standing: true, ...(hosts ? { hosts } : {}), ...(out['--command'] !== undefined ? { command: out['--command'] } : {}), cwd: process.cwd() }, 'request');
  if (d.already === 'own') { console.log(`${d.ref} is this conversation's own — it stored it, so it runs without asking anyone: vibespace-vault run --env NAME=${d.ref} -- <command>`); return; }
  if (d.already === 'standing') { console.log(`${d.ref}: this conversation already holds that standing grant (${d.grant}) — run it`); return; }
  if (d.filed) { console.log(`asked the user ONCE for a standing grant on ${d.ref}; nothing waits on it`); console.log(d.filed); }
  else console.log(`asked the user ONCE for a standing grant on ${d.ref} — the question is in their For you tray; nothing waits on it`);
  console.log(`  for: ${[...(d.hosts && d.hosts.length ? [`commands to ${d.hosts.join(', ')}`] : []), ...(d.command ? [`the command ${d.command}`] : [])].join(' · ')} — until they take it back`);
  console.log('  their answer: Allow (standing) · deny; `vibespace-vault uses` shows it when it comes; do other work meanwhile, and do not ask again in the chat');
}

/** lane vault-paste-request: ask the user to PASTE a secret (the hub files ONE For-you item with a masked box; the value never
 *  comes back — the receipt at the next turn says where it went). The hub judges every word (one spelling, CLI on any host). */
async function pasteCmd(words, out) {
  if (out['--for'] !== undefined) { console.error('vibespace-vault: in a paste request the purpose is --purpose "<why>" and the place is --into <row>.<field> (or --kind / --name for a new entry); --for belongs to request <vault://…>'); process.exit(2); }
  if (out['--purpose'] === undefined) { console.error('vibespace-vault: request "<what you need>" --purpose "<what you will do with it>" [--into <row>.<field> | --kind api-key|password|secret] [--name <label>]'); process.exit(2); }
  const body = { words, purpose: out['--purpose'] };
  if (out['--into'] !== undefined) body.into = out['--into'];
  if (out['--kind'] !== undefined) body.kind = out['--kind'];
  if (out['--name'] !== undefined) body.name = out['--name'];
  if (out['--host'] !== undefined) body.hosts = out['--host'];   // lane vault-use-grants: the hub judges the list (one spelling)
  const d = await callCoded('POST', '/api/agent/vault/secret-request', body, 'request');
  const t = d.target || {};
  const where = t.into ? `${t.into} (${t.row} › ${t.field}) — VibeSpace uses it there itself` : `a new vault entry «${t.label}» (${t.kind})${t.hosts && t.hosts.length ? ` for ${t.hosts.join(', ')}` : ''}`;
  const tray = (d.tray && (d.tray.phrase || d.tray.name)) || 'their For you tray';
  if (d.already === 'open') console.log(`already asked (${d.requestId}) — the paste box still waits in ${tray}; nothing waits on it`);
  else if (d.filed) { console.log(`asked the user to paste it — a masked paste box; nothing waits on it`); console.log(d.filed); }   // lane chat-needs-you-card: the hub's line (the card + the tray)
  else console.log(`asked the user to paste it (${d.requestId}) — a masked paste box is in ${tray}; nothing waits on it`);
  console.log('  where it goes: ' + where);
  console.log('  your next turn says «stored» (where, and how to use it) or «refused» — never the value; do other work meanwhile,');
  console.log('  and never ask for the secret in the chat');
}

async function usesCmd() {
  const d = await callCoded('GET', '/api/agent/vault/uses', undefined, 'uses');
  if (d.state && d.state !== 'unlocked') console.log('vault: ' + (SAYS[d.state] || d.state));
  console.log('grants (this conversation):');
  if (!d.grants || !d.grants.length) console.log('  none');
  for (const g of d.grants || []) console.log(`  ${g.entry}  ${g.once ? 'one run' : 'every run'} until ${whenAt(g.until)}  for: ${g.purpose || '-'}`);
  for (const s of d.standing || []) console.log(`  ${s.entry}  standing · ${standingScope(s)} · since ${s.since ? whenAt(s.since) : '?'}${s.until ? ` · until ${whenAt(s.until)}` : ''}${s.paused ? ' · PAUSED (the user turned the entry off)' : ''}  (${s.grant})`);   // lane vault-standing-request
  console.log('requests waiting on the user:');
  if (!d.requests || !d.requests.length) console.log('  none');
  for (const q of d.requests || []) console.log(`  ${q.entry}  asked ${whenAt(q.at)}${q.standing ? ` (standing · ${standingScope(q)})` : ''}  for: ${q.purpose || '-'}`);
  for (const q of d.pastes || []) console.log(`  ${q.requestId}  paste «${q.words}» → ${q.place || '-'}  for: ${q.purpose || '-'}`);   // lane vault-paste-request: a paste box waiting in their tray
  console.log('uses (newest first):');
  if (!d.uses || !d.uses.length) console.log('  none');
  for (const u of d.uses || []) console.log(`  ${whenAt(u.at)}  ${u.entry || '-'}  via ${u.door || '-'}  ${u.outcome}${u.grant ? `  by grant${u.standing ? ' · standing' : ''} ${u.grant}` : ''}${u.receipt ? '  receipt ' + u.receipt : ''}${u.purpose ? '  for: ' + u.purpose : ''}`);
}
/** lane vault-standing-request: a standing grant's scope in words — «hosts a, b» / «the command python3 transcribe.py». */
const standingScope = (s) => [...(s.hosts && s.hosts.length ? [`hosts ${s.hosts.join(', ')}`] : []), ...(s.commands && s.commands.length ? [`the command ${s.commands.join(', ')}`] : s.command ? [`the command ${s.command}`] : [])].join(' + ') || '-';

async function runCmd(rest) {
  // the hub parses the words (the CLI ships to other hosts — one spelling of the flags, src/vault-run.js parseRunArgs)
  const note = setTimeout(() => console.error('# vibespace-vault run: still waiting — a new command shape waits for the user\'s answer on the card in this conversation or in For you (up to 60 s), or the command is still running'), 3000);   // lane chat-needs-you-card: the note names the card
  let r;
  try { r = await postLong('/api/agent/vault/run', { args: rest, cwd: process.cwd() }); } finally { clearTimeout(note); }
  const d = r.data || {};
  if (r.status >= 400 || !d.ok) { console.error('vibespace-vault run: ' + (d.error || 'HTTP ' + r.status) + (d.code ? ` (${d.code})` : '')); process.exit(r.status === 400 && d.code === 'bad_flag' ? 2 : 1); }
  if (d.stdout) process.stdout.write(d.stdout);
  if (d.stderr) process.stderr.write(d.stderr);
  const said = [];
  if (d.scrubbed && d.scrubbed.hits) said.push(`${d.scrubbed.hits} occurrence(s) of a stored secret blanked`);
  if (d.truncated) said.push('the output was cut at 2 MiB');
  if (d.timedOut) said.push('stopped at its timeout');
  if (said.length) console.error(`# vibespace-vault run: ${said.join(' · ')}`);
  if (d.next) console.error(`# vibespace-vault run: ${d.next}`);   // lane vault-standing-request: a run the user let through once names the standing road
  if (d.receipt) console.error(`# vibespace-vault run: receipt ${d.receipt}`);   // the audit line the user sees carries the same one
  const signals = require('os').constants.signals || {};
  process.exit(d.timedOut ? 124 : Number.isInteger(d.exit) ? d.exit : d.signal && signals[d.signal] ? 128 + signals[d.signal] : 1);
}

/** Split `rest` into flags and positionals. `specs`: { '--flag': 'value' | 'bool' }. An unknown flag exits 2. */
function parseFlags(rest, specs) {
  const out = {}, positional = [];
  for (let i = 0; i < rest.length; i++) {
    const a = rest[i];
    if (a === '--') { positional.push(...rest.slice(i + 1)); break; }
    if (a.startsWith('--')) {
      const eq = a.indexOf('='), key = eq >= 0 ? a.slice(0, eq) : a;
      if (!(key in specs)) { console.error('vibespace-vault: unknown option ' + key + '\n' + USAGE); process.exit(2); }
      if (specs[key] === 'bool') out[key] = true;
      else { const v = eq >= 0 ? a.slice(eq + 1) : rest[++i]; if (v === undefined) { console.error('vibespace-vault: ' + key + ' needs a value'); process.exit(2); } out[key] = v; }
    } else positional.push(a);
  }
  return { out, positional };
}

async function mint(rest) {
  const { out, positional } = parseFlags(rest, { '--length': 'value', '--charset': 'value', '--for': 'value' });
  if (positional.length !== 1) { console.error('vibespace-vault: mint <name> [--length 24] [--charset ascii-printable|alnum|digits] [--for <host/service>]'); process.exit(2); }
  const body = { name: positional[0] };
  if (out['--length'] !== undefined) body.length = Number(out['--length']);
  if (out['--charset'] !== undefined) body.charset = out['--charset'];
  if (out['--for'] !== undefined) body.for = out['--for'];
  const d = await call('POST', '/api/agent/vault/mint', body);
  console.log('minted ' + d.name);
  console.log('  reference: ' + d.ref);
  console.log('  ' + (d.provenance || 'agent minted · never shown to the agent') + ' — the value is sealed; you never see it.');
  console.log('  The user can reveal it in ⚙ System ▸ Vault… behind the second password (it is meant to be typed somewhere).');
  console.log((d.for ? `  Made for ${d.for}: a run of yours sending it there asks nobody; another host asks the user once per host.` : '  No --for: each host it goes to asks the user once.') + ' A command whose destination cannot be told (a shell, a script, a tool naming no host it can read) asks the user every run on a shared instance, once per command shape on their own machine.');   // lane vault-agent-own (round 2)
}

/** lane vault-agent-own: a value the agent holds, from a 0600 file or stdin — NEVER the command line (argv is readable). One
 *  trailing newline a file / echo adds is dropped; the value itself is kept. */
function secretIn(out, verb) {
  const hasFile = out['--from-file'] !== undefined, hasStdin = !!out['--stdin'];
  if (hasFile === hasStdin) { console.error(`vibespace-vault: ${verb} needs exactly one of --from-file <0600 file> or --stdin (never the value on the command line)`); process.exit(2); }
  let value;
  if (hasFile) {
    const file = out['--from-file'];
    let st; try { st = fs.statSync(file); } catch (e) { console.error('vibespace-vault: cannot read ' + file + ' (' + (e && e.code) + ')'); process.exit(1); }
    if (st.mode & 0o077) { console.error('vibespace-vault: ' + file + ' is readable by others (mode ' + (st.mode & 0o777).toString(8) + ') — the plaintext must be private; run: chmod 600 ' + file); process.exit(1); }
    value = fs.readFileSync(file, 'utf8');
  } else value = fs.readFileSync(0, 'utf8');
  value = value.replace(/\r?\n$/, '');
  if (!value) { console.error('vibespace-vault: the value is empty'); process.exit(1); }
  return value;
}
/** lane vault-agent-own: `totp add <name> --from-file | --stdin` — the otpauth:// link or the seed becomes the two-step entry
 *  `totp:<name>`, this conversation's own: its code answers here with no grant; the seed is never read back. */
async function totpAdd(rest) {
  const { out, positional } = parseFlags(rest, { '--from-file': 'value', '--stdin': 'bool' });
  if (positional.length !== 1) { console.error('vibespace-vault: totp add <name> --from-file <0600 file> | --stdin   (the otpauth:// link or the base32 seed — never on the command line)'); process.exit(2); }
  const text = secretIn(out, 'totp add');
  const d = await callCoded('POST', '/api/agent/vault/totp', { name: positional[0], ...(/^otpauth:\/\//i.test(text.trim()) ? { uri: text.trim() } : { seed: text.trim() }) }, 'totp add');
  console.log(`stored the two-step code ${d.name} — the seed is sealed; you never read it back`);
  console.log(`  its code: vibespace-vault totp ${d.name}   (no grant: this conversation stored it)`);
}
/** lane vault-agent-own: `login add <origin> --user <name> --from-file | --stdin [--totp <name>]` — a website login this
 *  conversation holds becomes a web-login entry it owns: the kernel fills it (`vibespace-browser login`), no grant here. */
async function loginAdd(rest) {
  const { out, positional } = parseFlags(rest, { '--user': 'value', '--from-file': 'value', '--stdin': 'bool', '--totp': 'value' });
  if (positional.length !== 1 || out['--user'] === undefined) { console.error('vibespace-vault: login add <origin> --user <name> --from-file <0600 file> | --stdin [--totp <totpname>]   (the password — never on the command line)'); process.exit(2); }
  const pw = secretIn(out, 'login add');
  const d = await callCoded('POST', '/api/agent/vault/login', { origin: positional[0], username: out['--user'], loginPassword: pw, ...(out['--totp'] !== undefined ? { totpName: out['--totp'] } : {}) }, 'login add');
  console.log(`stored the login ${d.user} on ${d.origin} — the password is sealed; you never read it back`);
  console.log(`  sign in with it: vibespace-browser login ${d.origin} --user ${d.user}   (the kernel fills it; no grant: this conversation stored it)`);
}

async function put(rest) {
  const { out, positional } = parseFlags(rest, { '--from-file': 'value', '--stdin': 'bool' });
  if (positional.length !== 1) { console.error('vibespace-vault: put <name> --from-file <0600 file> | --stdin\n  (the value NEVER rides the command line — it is readable there; use a 0600 file or stdin)'); process.exit(2); }
  const name = positional[0];
  const hasFile = out['--from-file'] !== undefined, hasStdin = !!out['--stdin'];
  if (hasFile === hasStdin) { console.error('vibespace-vault: put needs exactly one of --from-file <0600 file> or --stdin (never the value on the command line)'); process.exit(2); }
  let value;
  if (hasFile) {
    const file = out['--from-file'];
    let st; try { st = fs.statSync(file); } catch (e) { console.error('vibespace-vault: cannot read ' + file + ' (' + (e && e.code) + ')'); process.exit(1); }
    if (st.mode & 0o077) { console.error('vibespace-vault: ' + file + ' is readable by others (mode ' + (st.mode & 0o777).toString(8) + ') — the plaintext must be private; run: chmod 600 ' + file); process.exit(1); }
    value = fs.readFileSync(file, 'utf8');
  } else {
    value = fs.readFileSync(0, 'utf8');   // stdin
  }
  value = value.replace(/\r?\n$/, '');   // drop ONE trailing newline a file / echo adds — the value itself is kept
  if (!value) { console.error('vibespace-vault: the value is empty'); process.exit(1); }
  const d = await call('POST', '/api/agent/vault/put', { name, value });
  console.log('stored ' + d.name);
  console.log('  reference: ' + d.ref);
  console.log('  ' + (d.provenance || 'agent stored · the agent saw the plaintext'));
  if (d.hint) console.log('  ' + d.hint);
}

async function main() {
  const args = process.argv.slice(2);
  const [cmd = 'status'] = args;
  if (cmd === 'totp') {
    if (args[1] === 'add' && args.slice(2).some((a) => a !== '--json')) return totpAdd(args.slice(2));   // lane vault-agent-own (`totp add` alone = the code of an entry named «add»)
    const rest = args.slice(1), json = rest.includes('--json'), names = rest.filter((a) => a !== '--json');
    if (names.length !== 1 || names[0].startsWith('-')) { console.error('vibespace-vault: totp takes ONE name\n' + USAGE); process.exit(2); }
    const d = await call('GET', '/api/agent/vault/totp/' + encodeURIComponent(names[0]));
    if (json) console.log(JSON.stringify({ name: d.name, code: d.code, secondsLeft: d.secondsLeft, period: d.period }));
    else console.log(`${d.code} (${d.secondsLeft} s left)`);
    return;
  }
  if (cmd === 'help' || cmd === '-h' || cmd === '--help') { console.log(USAGE); return; }
  if (cmd === 'run') return runCmd(args.slice(1));
  if (cmd === 'mint') return mint(args.slice(1));
  if (cmd === 'put') return put(args.slice(1));
  if (cmd === 'request') return requestCmd(args.slice(1));
  if (cmd === 'login') { if (args[1] === 'add') return loginAdd(args.slice(2)); console.error('vibespace-vault: login add <origin> --user <name> --from-file <0600 file> | --stdin [--totp <name>]\n' + USAGE); process.exit(2); }   // lane vault-agent-own
  if (args.length > 1) { console.log(USAGE); process.exit(2); }
  if (cmd === 'status') return print(await call('GET', '/api/agent/vault/state'));
  if (cmd === 'lock') { const d = await call('POST', '/api/agent/vault/lock'); print(d); return; }
  if (cmd === 'list') {
    const d = await call('GET', '/api/agent/vault/runnable');
    if (!d.entries || !d.entries.length) { console.log('no stored secret is open for your runs — ask the user for one with its purpose: vibespace-vault request <vault://…> --for "<why>" (they open it in ⚙ System ▸ Vault…, or grant it to you from For you)'); return; }
    for (const e of d.entries) console.log(`${e.ref}  ${e.label} (${e.kind})${e.by === 'own' ? (e.minted ? `  yours: minted${e.for ? ` for ${e.for} — runs there without asking` : ''}; another host or a command whose destination cannot be told asks the user` : '  yours: this conversation stored it — runs without asking') : e.by === 'grant' ? `  granted to you: ${e.once ? 'one run' : 'every run'} until ${whenAt(e.until)}` : e.by === 'standing' ? `  standing · ${standingScope(e)} · since ${e.since ? whenAt(e.since) : '?'}${e.until ? ` · until ${whenAt(e.until)}` : ''}${e.paused ? ' · PAUSED (the user turned the entry off)' : ' — yours to use with no card'} (${e.grant})` : ''}`);   // own: lane vault-agent-own · standing: lane vault-use-grants
    return;
  }
  if (cmd === 'uses') return usesCmd();
  console.error('vibespace-vault: unknown command "' + cmd + '"\n' + USAGE);
  process.exit(2);
}
main().catch((e) => { console.error('vibespace-vault:', e.message); process.exit(1); });
