#!/usr/bin/env node
// vibespace-job — Background Work CLI (STATIC tracked; docs/design-background-work.md §8).
// Auth: VIBESPACE_SESSION_TOKEN (agent session) or VIBESPACE_JOB_TOKEN (from
// inside a job process). Server scopes everything by token — no ids of other
// people's work ever leak here (uniform not-found, no 403 oracle).
'use strict';
const API = process.env.VIBESPACE_API;
const SESS = process.env.VIBESPACE_SESSION_TOKEN;
const JOBT = process.env.VIBESPACE_JOB_TOKEN;
const JOBID = process.env.VIBESPACE_JOB_ID;
if (!API || (!SESS && !JOBT)) { console.error('vibespace-job: not inside a VibeSpace session (VIBESPACE_API / token missing)'); process.exit(2); }

const args = process.argv.slice(2);
const flags = {};
const pos = [];
for (let i = 0; i < args.length; i++) {
  const a = args[i];
  if (a.startsWith('--')) {
    const k = a.slice(2);
    if (i + 1 < args.length && !args[i + 1].startsWith('--')) { flags[k] = args[++i]; }
    else flags[k] = true;
  } else pos.push(a);
}
const verb = pos[0];

function dur(v) { // 30s/10m/6h/2d → ms
  const m = /^(\d+(?:\.\d+)?)(s|m|h|d)?$/.exec(String(v || ''));
  if (!m) return null;
  return Math.round(+m[1] * ({ s: 1e3, m: 60e3, h: 3600e3, d: 86400e3 }[m[2] || 'm']));
}
function readArg(v) { // @file support
  if (typeof v === 'string' && v.startsWith('@')) { try { return require('fs').readFileSync(v.slice(1), 'utf-8'); } catch (e) { console.error('cannot read ' + v.slice(1) + ': ' + e.message); process.exit(1); } }
  return v;
}
async function call(method, p, body) {
  const res = await fetch(API + p, {
    method, headers: { 'Content-Type': 'application/json', Authorization: 'Bearer ' + (SESS || JOBT) },
    body: body === undefined ? undefined : JSON.stringify(body),
  }).catch((e) => ({ _neterr: e.message }));
  if (res._neterr) { console.error('vibespace-job: server unreachable (' + res._neterr + ') — if a --wait was interrupted the job is still running; retry the poll'); process.exit(3); }
  let j = {};
  try { j = await res.json(); } catch { }
  if (j.error) { console.error(j.error); process.exit(1); }
  return j;
}
const hum = (ms) => { const m = Math.round(Math.abs(ms) / 60000); return m < 60 ? m + 'm' : m < 1440 ? Math.round(m / 60) + 'h' : Math.round(m / 1440) + 'd'; };
function printJob(j, tailLines) {
  const run = j.run || {};
  const dur_ = run.startedAt ? (run.endedAt ? ` ran ${hum(run.endedAt - run.startedAt)}` : ` up ${hum(Date.now() - run.startedAt)}`) : '';
  console.log(`${j.id} ${j.name} [${j.kind}] state=${j.state}${run.exit !== null && run.exit !== undefined ? ' exit=' + run.exit : ''}${run.cause ? ' cause=' + run.cause : ''}${dur_}${j.nextFireAt ? ' next=' + hum(j.nextFireAt - Date.now()) : ''}${j.progress ? '\nprogress: ' + j.progress : ''}`);
  if (j.context && j.context.payload) console.log('context: ' + j.context.payload);
  if (j.answers && j.answers.length) console.log('answers: ' + JSON.stringify(j.answers[j.answers.length - 1]));
  if (j.logTail) console.log(`log tail:\n${j.logTail.split('\n').map((l) => '  ' + l).join('\n')}`);
  if (j.state === 'done' || j.state === 'failed') console.log(`next: vibespace-job logs ${j.id} --tail 200 · vibespace-job rm ${j.id}`);
}

const USAGE = `vibespace-job — background work that OUTLIVES this conversation (services · long tasks · cron)
create:  vibespace-job run "CMD" --name NAME [--context "brief (echoed at poll, survives your compaction)"]
           [--cwd DIR] [--until "MARKER"] [--timeout 6h] [--stdin-open] [--notify-user] [--notify on|off]
           [--keep-up [--restart on-failure|always|never] [--port N] [--publish]]     ← service
           [--every 30m | --cron "41 9 * * *" | --at "+5m"|"2026-09-05 06:00"]        ← schedule (spawns CMD; bare datetime = SERVER-LOCAL tz — prefer relative "+5m"/"+1h30m" or ISO with Z)
         vibespace-job notify-cron --name X (--every 12h|--cron "..."|--at "...") --text "..." [--urgency low|normal|high] [--notify-user]
             (fires wake YOUR conversation; --notify-user ALSO copies the text to the user's inbox — default off, the text is usually your own reminder)
docs:    vibespace-job docs   — the FULL manual (notify/subscribe/announce/panels/patterns), read anytime
read:    vibespace-job list [--mine|--subscribed] · vibespace-job poll <id|name> [--wait 100] [--tail 40]
         vibespace-job show <id>  (FULL params: cmd/schedule/access/notify/subscribers/your subscription)
         vibespace-job logs <id> [--tail 200]
control: vibespace-job stop <id> [--force] · vibespace-job start <id> · vibespace-job rm <id> [--stop]
         vibespace-job access <id> [--view session|group|all] [--control session|group|all]
         vibespace-job notify <id> on|off|inherit   (owner only — change auto-notify without recreating)
         vibespace-job subscribe <id> [--filter "SpaceX|Starship"] · unsubscribe <id>   (any session that can VIEW
           the job gets its notifications; --filter = case-insensitive regex on the message text, re-subscribe updates it)
in-job:  vibespace-job progress "text"     · vibespace-job ask --form @panel.json [--timeout 30m]
         vibespace-job answers [--wait 100] · vibespace-job announce "what happened" (notify owner+subscribers NOW —
           for watch jobs where exit code ≠ newsworthiness; --notify-ok at create = scheduled successes notify too)
Pick the right tool: turn-scoped waits → background Bash/Monitor · session continuation → /goal ·
must OUTLIVE the conversation → THIS · harness cron → never (expires) · dated obligations → --at.`;

(async () => {
  if (!verb) {
    console.log(USAGE + '\n');
    const r = await call('GET', '/api/agent/jobs');
    if (r.jobs && r.jobs.length) { console.log('your visible jobs:'); for (const j of r.jobs) console.log(`  ${j.id} [${j.kind}] ${j.state} — ${j.name}`); }
    else console.log('no jobs visible to this session yet.');
    return;
  }
  switch (verb) {
    case 'run': case 'notify-cron': {
      const isNotify = verb === 'notify-cron';
      const cmdStr = pos[1];
      if (!isNotify && !cmdStr) { console.error('usage: vibespace-job run "CMD" --name NAME [flags] — run with no args for full usage'); process.exit(1); }
      // --at forms: epoch ms | RELATIVE "+2m"/"+1h30m" (unambiguous — prefer
      // this) | ISO with Z/offset (exact) | bare datetime = SERVER-LOCAL time.
      // The 2026-08-20 incident: an agent living in UTC transcript timestamps
      // wrote a UTC wall time, bare-parse landed it 7h out (PDT) and the agent
      // chased a "broken notification channel" — hence the relative form and
      // the resolved-time echo below.
      const parseAt = (s) => {
        if (/^\d+$/.test(s)) return Number(s);
        const rel = /^\+\s*((\d+)\s*h)?\s*((\d+)\s*m)?\s*((\d+)\s*s)?$/.exec(s.replace(/\s+/g, ''));
        if (rel && (rel[2] || rel[4] || rel[6])) return Date.now() + (Number(rel[2] || 0) * 3600 + Number(rel[4] || 0) * 60 + Number(rel[6] || 0)) * 1000;
        return new Date(s).getTime();
      };
      const schedule = flags.every ? { everyMs: dur(flags.every), jitterPct: Number(flags.jitter) || 20 }
        : flags.cron ? { cron: flags.cron }
        : flags.at ? { at: parseAt(flags.at) } : null;
      if (flags.at && (!schedule.at || Number.isNaN(schedule.at))) { console.error('cannot parse --at time: ' + flags.at + ' (use "+2m" relative, ISO with Z, or "YYYY-MM-DD HH:MM" in SERVER-LOCAL time)'); process.exit(1); }
      const body = {
        kind: isNotify ? 'cron' : schedule ? 'cron' : flags['keep-up'] ? 'service' : 'task',
        name: flags.name, note: flags.note || '',
        context: flags.context ? { payload: readArg(flags.context) } : null,
        cwd: flags.cwd, env: [].concat(flags.env || []).length ? undefined : undefined,
        schedule,
        access: { view: flags.view || 'group', control: flags.control || 'session' },
        stopWithOwner: !!flags['stop-with-owner'],
        notify: flags.notify === 'on' || flags.notify === 'off' ? flags.notify : undefined,
      };
      // REMINDER-INSTINCT SUPPORT (2.361.4, owner call): "scheduled run of a
      // bare echo" is a natural first way to build a reminder — but scheduled
      // SUCCESSES don't notify by default (notifyOk=false), so that shape was
      // a silent no-op forever (the 79928a2b never-reminded incident). A pure
      // echo/printf command has no purpose BEYOND its output ⇒ default
      // notifyOk=true for that shape (an explicit --notify-ok flag, or
      // --notify off, still wins).
      let echoReminder = false;
      if (isNotify) body.action = { type: 'notify', text: readArg(flags.text || ''), urgency: flags.urgency || 'normal' };
      else {
        echoReminder = !!schedule && flags['notify-ok'] === undefined && flags.notify !== 'off'
          && /^\s*(echo|printf)\b[^|&;<>`$()]*$/.test(cmdStr);
        const task = {
          cmd: { argv: ['sh', '-c', cmdStr], cwd: flags.cwd || process.cwd() },
          untilOutput: flags.until || null, timeoutMs: flags.timeout ? dur(flags.timeout) : null,
          stdinOpen: !!flags['stdin-open'], notifyUser: !!flags['notify-user'],
          notifyOk: !!flags['notify-ok'] || echoReminder, restart: flags.restart || 'on-failure',
          ports: [].concat(flags.port || []).filter(Boolean).map(Number), publish: !!flags.publish,
        };
        if (schedule) body.action = { type: 'spawn-task', task };
        else Object.assign(body, task);
      }
      const r = await call('POST', '/api/agent/jobs', body);
      const j = r.job;
      console.log(`started ${j.id} (${j.kind} ${j.name})${r.renamed ? ' — name was taken, auto-suffixed' : ''}`);
      // RESOLVED-TIME ECHO: always show WHEN it actually fires, absolute UTC +
      // countdown — a timezone mis-parse (bare datetimes are server-local)
      // must be visible the second the job is created, not 7 hours later.
      if (j.nextFireAt) {
        const inMs = j.nextFireAt - Date.now();
        const inTxt = inMs < 90000 ? Math.round(inMs / 1000) + 's' : inMs < 5400000 ? Math.round(inMs / 60000) + 'm' : (inMs / 3600000).toFixed(1) + 'h';
        console.log(`next fire: ${new Date(j.nextFireAt).toISOString()} (in ${inTxt}) — if that is NOT what you meant, rm and recreate with --at "+5m"-style relative time`);
      }
      console.log(`this job OUTLIVES your conversation. Poll it (even from a future session):\n  vibespace-job poll ${j.id}`);
      if (r.notify) {
        if (r.notify.enabled) console.log(`auto-notify: ON (${r.notify.source}) — ${r.notify.mode === 'live-message' ? 'this conversation will be messaged on completion/failure/ask' : 'no live inbox now; you will be told at your next resume'}. Polling still works anytime.`);
        else console.log(`auto-notify: OFF (${r.notify.reason}) — you will NOT be told when it finishes; poll it yourself: vibespace-job poll ${j.id}`);
      }
      // PER-FIRE semantics honesty for scheduled tasks: "auto-notify: ON"
      // above means terminal/failure/ask events — an agent building a
      // reminder reads it as "each fire will message me", which is false
      // unless notifyOk (the 79928a2b silent-reminder incident). Say it.
      if (!isNotify && j.kind === 'cron') {
        if (echoReminder) console.log('reminder-style command detected (bare echo/printf on a schedule): per-fire notify turned ON for you — notify-cron is the cleaner primitive for pure reminders (vibespace-job notify-cron --text "...").');
        else console.log(`scheduled task: SUCCESSFUL fires are SILENT (failures/asks/parks notify) — add --notify-ok to be messaged on every fire; for pure reminders use notify-cron.`);
      }
      if (r.survivalNote) console.log('runtime note: ' + r.survivalNote);
      break;
    }
    case 'docs': {
      const r = await call('GET', '/api/agent/jobs-docs');
      console.log(r.text || 'manual unavailable');
      break;
    }
    case 'list': {
      const q = flags.mine ? '?mine=1' : flags.subscribed ? '?subscribed=1' : flags.all ? '?all=1' : '';
      const r = await call('GET', '/api/agent/jobs' + q);
      if (!r.jobs.length) return console.log(flags.mine ? 'no jobs owned by this conversation.' : flags.subscribed ? 'no subscriptions from this conversation.' : 'no jobs visible to this session.');
      for (const j of r.jobs) console.log(`${j.id} [${j.kind}] ${j.state}${j.mine ? ' ★mine' : ''}${j.mySubscription ? ' ✓sub' + (j.mySubscription.filter ? '/' + j.mySubscription.filter : '') : ''}${j.progress ? ' 「' + j.progress + '」' : ''} — ${j.name}${j.context && j.context.payload ? ' — ' + j.context.payload.split('\n')[0].slice(0, 60) : ''}`);
      break;
    }
    case 'show': {
      if (!pos[1]) { console.error('usage: vibespace-job show <id|name>'); process.exit(1); }
      const r = await call('GET', `/api/agent/jobs/${encodeURIComponent(pos[1])}`);
      const j = r.job;
      console.log(`${j.id} [${j.kind}] ${j.state} — ${j.name}${j.mine ? '  (yours)' : ''}`);
      if (j.cmd) console.log(`cmd: ${JSON.stringify(j.cmd.argv)}${j.cmd.cwd ? ' @ ' + j.cmd.cwd : ''}${j.cmd.envKeys.length ? ' env:[' + j.cmd.envKeys.join(',') + ']' : ''}${j.envFrom.length ? ' envFrom:[' + j.envFrom.join(',') + ']' : ''}`);
      if (j.schedule) console.log(`schedule: ${JSON.stringify(j.schedule)} catchUp=${j.catchUp}${j.nextFireAt ? ' next=' + new Date(j.nextFireAt).toISOString() : ''}`);
      console.log(`params: restart=${j.restart} timeout=${j.timeoutMs || '—'} until=${j.untilOutput || '—'} singleInstance=${j.singleInstance} stopWithOwner=${j.stopWithOwner} notifyOk=${j.notifyOk}`);
      console.log(`access: view=${j.access.view} control=${j.access.control}${j.access.lockedBy ? ' (locked by user)' : ''} · notify=${j.notify}${j.lastNotify ? ' last=' + j.lastNotify.lane + (j.lastNotify.ok ? '✓' : '✗') : ''} · subscribers=${j.subscribersCount}${j.mySubscription ? ' (you' + (j.mySubscription.filter ? ', filter=' + j.mySubscription.filter : '') + ')' : ''}`);
      if (j.context && j.context.payload) console.log('context: ' + j.context.payload);
      if (j.run) console.log(`last run: ${new Date(j.run.startedAt).toISOString()} exit=${j.run.exit ?? '—'} ${j.run.cause || ''} (${j.runsCount} run(s))`);
      break;
    }
    case 'poll': case 'answers': {
      const ref = pos[1] || JOBID;
      if (!ref) { console.error(`usage: vibespace-job ${verb} <id|name> [--wait 100]`); process.exit(1); }
      let wait = flags.wait === true ? 100 : Math.min(Number(flags.wait) || 0, 100); // CLI cap 100s (harness Bash times out at 120s)
      if (Number(flags.wait) > 100) console.error('(--wait capped at 100s — you will still see current state on timeout; completion also arrives as injected context)');
      const onTerm = () => { console.error('(poll interrupted — the job keeps running; re-run the poll any time)'); process.exit(0); };
      process.on('SIGTERM', onTerm); process.on('SIGINT', onTerm);
      const r = await call('GET', `/api/agent/jobs/${encodeURIComponent(ref)}?tail=${Number(flags.tail) || 20}&wait=${wait}${verb === 'answers' ? '&answers=1' : ''}`);
      printJob(r.job, Number(flags.tail) || 20);
      break;
    }
    case 'logs': {
      const ref = pos[1] || JOBID;
      const r = await call('GET', `/api/agent/jobs/${encodeURIComponent(ref)}?tail=${Number(flags.tail) || 200}`);
      console.log(r.job.logTail || '(no log)');
      break;
    }
    case 'stop': case 'start': {
      const r = await call('POST', `/api/agent/jobs/${encodeURIComponent(pos[1] || JOBID)}/${verb}`, { force: !!flags.force });
      console.log(verb === 'stop' ? 'stopped (services stay down until an explicit start)' : 'started');
      break;
    }
    case 'rm': {
      await call('POST', `/api/agent/jobs/${encodeURIComponent(pos[1])}/rm`, { stop: !!flags.stop, orphan: !!flags.orphan });
      console.log('removed');
      break;
    }
    case 'access': {
      const r = await call('POST', `/api/agent/jobs/${encodeURIComponent(pos[1])}/access`, { view: flags.view, control: flags.control });
      console.log('access updated: view=' + r.access.view + ' control=' + r.access.control);
      break;
    }
    case 'notify': {
      if (!pos[1] || !['on', 'off', 'inherit'].includes(pos[2])) { console.error('usage: vibespace-job notify <id|name> on|off|inherit'); process.exit(1); }
      const r = await call('POST', `/api/agent/jobs/${encodeURIComponent(pos[1])}/notify`, { value: pos[2] });
      console.log('auto-notify: ' + r.notify + (r.preview ? ` — ${r.preview.enabled ? (r.preview.mode === 'live-message' ? 'this conversation will be messaged' : 'stashed until your next resume') : 'off: ' + (r.preview.reason || '')}` : ''));
      break;
    }
    case 'announce': {
      const ref = pos[1] && pos[1].startsWith('jb-') ? pos[1] : JOBID;
      const text = pos[1] && pos[1].startsWith('jb-') ? pos[2] : pos[1];
      if (!ref || !text) { console.error('usage: vibespace-job announce [id] "what happened" (id implied inside a job)'); process.exit(1); }
      await call('POST', `/api/agent/jobs/${encodeURIComponent(ref)}/announce`, { text: readArg(text) });
      console.log('announced — owner and subscribers notified (or queued for their next resume)');
      break;
    }
    case 'subscribe': case 'unsubscribe': {
      if (!pos[1]) { console.error(`usage: vibespace-job ${verb} <id|name>`); process.exit(1); }
      const r = await call('POST', `/api/agent/jobs/${encodeURIComponent(pos[1])}/${verb}`, verb === 'subscribe' ? { filter: flags.filter } : {});
      console.log(verb === 'subscribe'
        ? (r.updated ? 'subscription filter updated' : r.already ? 'already subscribed' : 'subscribed') + (r.filter ? ` (filter: /${r.filter}/i — only matching messages reach you)` : '') + ` (${r.count} subscriber(s)); vibespace-job unsubscribe ${pos[1]} to stop`
        : (r.removed ? 'unsubscribed' : 'was not subscribed') + ` (${r.count} left)`);
      break;
    }
    case 'progress': {
      const text = pos[1] && !JOBID ? pos[2] || pos[1] : pos[JOBID && pos[1] && pos[1].startsWith('jb-') ? 2 : 1];
      const ref = pos[1] && pos[1].startsWith('jb-') ? pos[1] : JOBID;
      if (!ref || !text) { console.error('usage: vibespace-job progress [id] "text"'); process.exit(1); }
      await call('POST', `/api/agent/jobs/${encodeURIComponent(ref)}/progress`, { text });
      console.log('progress recorded (shown in the Jobs panel and in polls)');
      break;
    }
    case 'ask': {
      const ref = pos[1] && pos[1].startsWith('jb-') ? pos[1] : JOBID;
      if (!ref || !flags.form) { console.error('usage: vibespace-job ask [id] --form @panel.json [--timeout 30m]'); process.exit(1); }
      let panel;
      try { panel = JSON.parse(readArg(flags.form)); } catch (e) { console.error('panel JSON parse failed: ' + e.message); process.exit(1); }
      if (flags.timeout) panel.timeoutS = Math.round(dur(flags.timeout) / 1000);
      await call('POST', `/api/agent/jobs/${encodeURIComponent(ref)}/ask`, { panel });
      console.log('panel posted — the user sees it now; read replies with: vibespace-job answers ' + ref + ' --wait 100');
      break;
    }
    default:
      console.error(`unknown verb "${verb}" — run vibespace-job with no arguments for usage`);
      process.exit(1);
  }
})().catch((e) => { console.error('vibespace-job failed: ' + e.message); process.exit(1); });
