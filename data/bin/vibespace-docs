#!/usr/bin/env node
// vibespace-docs — full manuals for every VibeSpace agent tool, served by the
// running server (always version-matched). STATIC tracked; ships with the
// other agent tools. No topic = the index.
// lane cli-call-timeouts: THE ONE CALL to the hub (src/cli-call.js in a checkout; its boot-time copy cli-call.js beside
// this file on a host) — every wait bounded by its verb class, ONE line naming the wait on expiry (exit 124); --timeout <s> overrides
const CC = (() => {
  try { return require('node:fs').existsSync(require('node:path').join(__dirname, '..', '..', 'server.js')) ? require('../../src/cli-call.js') : require('./cli-call.js'); } catch { }
  try { return require('./cli-call.js'); } catch { return null; }
})();
if (!CC) { console.error('vibespace-docs: refused — this CLI\'s call helper (cli-call.js) is missing beside it, so it could not bound its wait; nothing was sent — ask the user to reinstall the agent tools (Manage agents → the machine → Install)'); process.exit(2); }
CC.cliStart({ tool: 'vibespace-docs', flags: ['--timeout', '--call-timeout'] });
'use strict';
const API = process.env.VIBESPACE_API;
const TOK = process.env.VIBESPACE_SESSION_TOKEN || process.env.VIBESPACE_JOB_TOKEN;
if (!API || !TOK) { console.error('vibespace-docs: not inside a VibeSpace session (VIBESPACE_API / token missing)'); process.exit(2); }
const topic = (process.argv[2] || 'index').replace(/^vibespace-/, '').replace(/^job$/, 'jobs');
(async () => {
  const res = await CC.call(`${API}/api/agent/docs/${encodeURIComponent(topic)}`, { headers: { Authorization: 'Bearer ' + TOK } }).catch((e) => ({ _neterr: e.message }));
  if (res._neterr) { console.error('vibespace-docs: server unreachable (' + res._neterr + ')'); process.exit(3); }
  let j = {}; try { j = await res.json(); } catch { }
  if (j.error) { console.error(j.error); process.exit(1); }
  console.log(j.text || 'manual unavailable');
})();
