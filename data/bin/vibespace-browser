    if (r.minted) console.error(`note: this session had no browser yet — VibeSpace gave it one on this command (${r.minted.origin === 'conversation' ? 'its conversation\'s own, kept from before' : 'new'}); nothing needs restarting [browser_key_minted]`);
    process.exit(1);
