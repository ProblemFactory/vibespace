async function call(method, p, body, { soft = false } = {}) {
  const res = await fetch(API + p, { method, headers: { Authorization: 'Bearer ' + TOKEN, ...(body !== undefined ? { 'Content-Type': 'application/json' } : {}) }, body: body !== undefined ? JSON.stringify(body) : undefined }).catch((e) => ({ _neterr: e.message }));
  if (res._neterr) { console.error('vibespace-browser: server unreachable (' + res._neterr + ')'); process.exit(3); }
  let j = {};
  try { j = await res.json(); } catch { }
  if (!res.ok || j.error) {
    if (soft) return { ...j, _status: res.status, _failed: true };
    // "Who can use it" (2026-09-27): a refusal whose way out is the USER's button prints that way out on every verb
    // (`use` as much as a page verb's /resolve) — the list sentence, then the button, never a command line
    if (j.code === 'not_owner' || j.code === 'groups_unreadable') { printRefusal(j); process.exit(1); }
    console.error((j.error || `HTTP ${res.status}`) + (j.code ? ` [${j.code}]` : ''));
    // B-f7ab verify r1: a refusal's WAY OUT is printed for every verb, not only the page verbs' (`status` on a session
    // that could not get its browser key said what happened and never what to do — the 2026-09-17 chat parked on less)
    if (j.remedy) console.error(`  remedy: ${j.remedy}`);
    // B-f7ab verify r2 (LOW): the key minted by this very call is said even when the call was refused — the next command runs on it
    if (j.minted) console.error(`note: this session had no browser yet — VibeSpace gave it one on this command (${j.minted.origin === 'conversation' ? 'its conversation\'s own, kept from before' : 'new'}); nothing needs restarting [browser_key_minted]`);
    process.exit(1);
  }
  return j;
}
/** lane browser-stuck: a GET that never exits the process (the long-poll beside a running verb) — null on any failure. */
async function peek(p, signal) {
  try {
    const res = await fetch(API + p, { headers: { Authorization: 'Bearer ' + TOKEN }, signal });
    let j = {}; try { j = await res.json(); } catch { j = {}; }
    return res.ok && !j.error ? j : { ...j, _failed: true, _status: res.status };
  } catch { return null; }
}
const when = (ms) => (ms ? new Date(ms).toISOString().slice(0, 16) + 'Z' : '-');
const ago = (ms) => { if (!ms) return ''; const s = Math.max(0, Math.round((Date.now() - ms) / 1000)); return s < 90 ? `${s}s ago` : s < 5400 ? `${Math.round(s / 60)}m ago` : `${Math.round(s / 3600)}h ago`; };
/** §3.8 layer ①: every answer names the profile it acted on. */
const profileLine = (p, lease, others, alias) => `profile: ${p.label} (${p.id})${alias ? ` · handle ${alias}` : ''}${lease ? ` · attached ${ago(lease.since)}` : ''}${others != null ? ` · ${others} other session(s) on it` : ''}`;
const handlesLine = (handles) => (handles && handles.length ? handles.map((h) => `${h.handle}${h.profileId ? ' (' + h.profileId + ')' : ''}${h.isDefault ? ' [default]' : ''}`).join(', ') : '(none)');
/** A refusal from /resolve is TYPED (§3.8): print the code, the handles and — for profile_changed — was → now. */
/** P4 (§7.4): the verbs that navigate — their URL is stamped on the lease (what a backend switch re-opens) and their output is read for the 403/429 HINT. */
const NAV_VERBS = new Set(['open', 'goto', 'navigate', 'nav']);
/** lane site-reset: the loop's ways out where the rules file beside this one predates the loop (the same list as
 *  src/browser-stuck.js LOOP_PASS_VERBS — pinned equal by test-browser-stuck), and a looping tab's screenshot bound.
 *  KEPT on purpose (lane dc-dead-sweep, 2026-10-05): the fallbacks serve a partial install, a real fleet shape. */
const LOOP_PASS_FALLBACK = new Set(['stop', 'site-reset', 'tab', 'close', 'screenshot', 'dialog', 'open', 'goto', 'navigate', 'nav', 'back', 'forward', 'reload']);
/** verify r4 #4: the READING verbs (src/browser-stuck.js LOOP_READ_VERBS, pinned equal) — they run on a loop whose pages load between hops. */
const LOOP_READ_FALLBACK = new Set(['snapshot', 'get', 'is', 'console', 'errors']);
const LOOP_SHOT_MS = 4000;
/** A real 403/429 in a navigation's output yields a HINT that names its source — worded so it cannot be read as a detection (§7.6 rule 5). */
function navHint(text) {
  const m = /\b(?:HTTP\s*|status(?:Code)?\W{0,3})(403|429)\b/i.exec(String(text || ''));
  if (!m) return null;
  return `hint: may-need-cloak — HTTP ${m[1]} is a hint from the status code, not a detection: the page may need a tier-2 backend; \`vibespace-browser blocked --url <u> --why http-${m[1]}\` records your claim (the user decides)`;
}
/** lane browser-propose step 2: a navigation's FINAL url + title off the browser CLI's own result — `--json`'s
 *  `{data:{url,title}}`, else its text form (0.38.1: "✓ <title>\n  <url>"). The server judges them against its sign-in
 *  refusal table (the audit answer's `hint`); null when neither form reads. */
function navFacts(outText) {
  const s = String(outText || '');
  for (const line of s.split('\n').reverse()) {
    const l = line.trim();
    if (!l.startsWith('{')) continue;
    try { const j = JSON.parse(l); const d = j && j.data; if (d && typeof d.url === 'string') return { url: d.url.slice(0, 4096), title: typeof d.title === 'string' ? d.title.slice(0, 4096) : '' }; } catch { /* not the result line */ }
  }
  const m = /^✓ ?(.*)\r?\n[ \t]+(\S+)[ \t]*$/m.exec(s);
  return m ? { title: m[1].trim().slice(0, 4096), url: m[2].slice(0, 4096) } : null;
}
/** lane site-reset verify r4 #1: a `tab new` that succeeded NAMES its tab — the binary's own `--json` ack (`data.targetId`),
 *  else the session's `tab list --json` active tab (0.38.1: a new tab becomes the session's active one; measured ≤ 80 ms,
 *  bounded here) — handed to the server with the audit so the watch binds the tab to THIS conversation, never to the verb
 *  that happened to be in flight (two commands at once left it nobody's: a loop in it was never told, `stop` found nothing). */
function tabNewAck(outText, { bin, env, cwd, wantsJson }) {
  const idOf = (x) => (typeof x === 'string' && /^[0-9A-Za-z_-]{4,64}$/.test(x) ? x : null);
  const lastJson = (text, pick) => { for (const line of String(text || '').split('\n').reverse()) { const l = line.trim(); if (!l.startsWith('{')) continue; try { const v = pick(JSON.parse(l)); if (v) return v; } catch { /* not the result line */ } } return null; };
  if (wantsJson) return Promise.resolve(lastJson(outText, (j) => idOf(j && j.data && j.data.targetId)) ? { targetId: lastJson(outText, (j) => idOf(j && j.data && j.data.targetId)), via: 'json' } : null);
  return new Promise((resolve) => {
    let out = ''; let c = null;
    try { c = spawn(bin, ['tab', 'list', '--json'], { stdio: ['ignore', 'pipe', 'ignore'], env, cwd }); } catch { return resolve(null); }
    const t = setTimeout(() => { try { c.kill('SIGKILL'); } catch { /* ended */ } resolve(null); }, 3000);
    c.stdout.on('data', (d) => { out += d; });
    c.on('error', () => { clearTimeout(t); resolve(null); });
    c.on('exit', () => { clearTimeout(t); const id = lastJson(out, (j) => { const tabs = j && j.data && Array.isArray(j.data.tabs) ? j.data.tabs : null; const act = tabs ? tabs.find((x) => x && x.active) : null; return idOf(act && act.targetId); }); resolve(id ? { targetId: id, via: 'list' } : null); });
  });
}
function printRefusal(r) {
  console.error(`${r.error || r.code} [${r.code}]`);
  if (r.code === 'profile_changed') {
    console.error(`  was: ${r.was ? (r.was.default ? r.was.default + ' [default]' : 'no default') + ' of ' + handlesLine(r.was.handles) : 'unknown'}`);
    console.error(`  now: ${r.now ? (r.now.default ? r.now.default + ' [default]' : 'no default') + ' of ' + handlesLine(r.now.handles) : handlesLine(r.handles)}`);
  } else if (r.code === 'browser_restarting') {
    // P4 (§7.4): the profile's backend is being switched — the gap is a NAMED refusal, not a timeout; the lease survives
    console.error('  the browser is being restarted on another backend; your tab is re-opened at its last URL — retry in a moment');
  } else if (r.code === 'backend_no_key' || r.code === 'backend_seat_taken' || r.code === 'backend_seat_ceiling') {
    if (r.action && r.action.openIntegration) console.error(`  way out: ask the user to open ⚙ → Integrations → ${r.action.openIntegration}${r.action.label ? ' (' + r.action.label + ')' : ''}`);
  } else if (r.code === 'downgrade_refused' || r.code === 'downgrade_unknown') {
    for (const w of r.waysOut || []) console.error(`  way out: ${w}`);
    if (r.needsConfirm) console.error('  (a human may confirm once: the user\'s switcher, or --confirm-downgrade if they told you to)');
  } else if (r.code === 'sharing_refused' || r.code === 'mediation_unavailable' || r.code === 'mediation_no_cdp') {
    // P6 (§6.2): instance sharing is a value only where the mediating proxy exists, on this machine
    if (r.why === 'mediation_unavailable' || r.code === 'mediation_unavailable') console.error('  this instance has no mediating CDP proxy — keep --sharing owner (the default)');
    else if (r.why === 'host') console.error('  a profile on a paired machine cannot be shared instance-wide — run it here, or keep --sharing owner');
    else if (r.code === 'mediation_no_cdp') console.error('  the profile\'s browser answered no CDP url — ask the user to stop it (Browser profiles panel), then attach again');
  } else if (r.code === 'browser_cap') {
    // takeover C3 (D2): the instance's browsers + desktop apps are at the shared ceiling — nothing is queued
    for (const h of r.holders || []) console.error(`  holder: ${h.label}${h.sessions && h.sessions.length ? ' (' + h.sessions.join(', ') + ')' : ''}${h.kind && h.kind !== 'profile' ? ' [' + h.kind + ']' : ''}`);
  } else if (r.code === 'not_owner') {
    // "Who can use it" is a list: the user kept that profile to some conversations / Task Groups — the way out is THEIR
    // button (add this conversation, or All agents), never a recreate
    console.error('  way out: ask the user to add this conversation under "Who can use it" in the Agent browser panel (Change…), or to pick "All agents" there');
  } else if (r.code === 'groups_unreadable') {
    console.error('  the Task Group list could not be read — run the same command again once');
  } else if (r.code === 'remote_session') {
    // identity verify r2 (2026-09-28): a profile's browser runs on the VibeSpace machine — a conversation elsewhere keeps its own
    console.error('  this conversation runs on another machine — keep using its own browser (a bare `vibespace-browser <verb>` lands on it)');
  } else if (r.code === 'browser_paused') {
    // P3 (§4.3): the user drives this browser — do NOT retry in a loop; the handback names the page they left you on
    if (r.takenAt) console.error(`  taken over at: ${new Date(r.takenAt).toISOString()}${r.lastUserInputAt ? ` · last input ${ago(r.lastUserInputAt)}` : ''}`);
    console.error('  wait for the handback (it arrives as a message naming the current URL and what to re-run), then re-orient before continuing');
  } else if (r.handles && r.handles.length) console.error(`  handles: ${handlesLine(r.handles)}`);
  if (r.pinned) console.error(`  pinned profile: ${r.pinnedProfile && r.pinnedProfile.label ? r.pinnedProfile.label : '?'} — nothing else was opened instead; tell the user`);
  if (r.remedy) console.error(`  remedy: ${r.remedy}`);
}


/** THE AGENT IS TOLD (the owner's ruling, 2026-09-27): the audit's `interrupted` answer — the user took this browser
 *  over while the command ran. Printed by name like every refusal; the caller exits 1. `code` = the binary's own. */
function printInterrupted(it, code) {
  console.error(`${it.error || 'The user took over your window of this browser — your operation was interrupted. Wait for the handback, then run it again.'} [browser_interrupted]`);
  if (it.takenAt) console.error(`  taken over at: ${new Date(it.takenAt).toISOString()}${it.input === 'agent' && it.handedBackAt ? ` · handed back at ${new Date(it.handedBackAt).toISOString()} — control is back with you: re-read the page, then run it again` : ' · the user still drives — wait for the handback (it names what to re-run)'}`);
  if (it.aborted) console.error(`  this command was cut short: its calls in flight were answered browser_interrupted, a script it was running was asked to stop (one awaiting a timer or a fetch may still finish)${Number(it.landed) > 0 ? ` — but ${it.landed === 1 ? 'one of its calls' : it.landed + ' of its calls'} had already reached the page and took effect (a fill's text may be in the field, a click may have landed): check the page before running it again` : ''}${Number(it.unsettled) > 0 ? ` — and ${it.unsettled === 1 ? 'one of its calls' : it.unsettled + ' of its calls'} had not been answered by the page when this was written, so whether it took effect is unknown: check the page before running it again` : ''}`);
  else if (code === 0 && it.mediated) console.error('  the takeover found none of this command\'s calls in flight (its last one had answered): it ran to its end — check the page before re-running it (a click that landed is not to be clicked twice)');
  else if (it.mediated) console.error('  the takeover came between its calls: what it had done before it stands, its calls after it were refused (nothing more reached the page)');
  else if (code === 0) console.error('  this browser is not shared instance-wide, so nothing stood between your command and the page: it ran to its end while the user drove — check the page before relying on its result');
}

/** lane browser-resume C: the profile an attachment answer names (the audit line's). */
function profileId0(r) { return r && r.profile && r.profile.id ? r.profile.id : null; }
/** lane browser-resume B: ONE note line per kept-browser fact of an answer (the server's own sentence). */
function printKept(r) {
  if (!r || typeof r !== 'object') return;
  if (r.resumed && r.resumed.text) console.error(`note: ${r.resumed.text} [browser_resumed]`);
  if (r.restored && r.restored.text) console.error(`note: ${r.restored.text} [browser_restored]`);
  if (r.kept && typeof r.kept === 'object' && r.kept.text) console.error(`note: ${r.kept.text} [browser_kept]`);
  if (r.notKept && typeof r.notKept === 'object' && r.notKept.text) console.error(`note: ${r.notKept.text} [browser_not_kept]`); // verify r2 (D6): a helper's first answer
  // lane profile-lock-roll (L2): this command's attach found the session's bound tab gone with a replaced browser (or closed)
  // and bound a tab BEFORE the verb ran — said once, here; the verb's own answer follows
  if (r.rebound && typeof r.rebound === 'object' && r.rebound.text) console.error(`note: ${r.rebound.text} [tab_rebound]`);
}
/** A LOCAL refusal (never a server call): the words, the code, the way out. */
function refuseLocally(r, exitCode = 1) {
  console.error(`${r.error} [${r.code}]`);
  if (r.remedy) console.error(`  remedy: ${r.remedy}`);
  process.exit(exitCode);
}

/** r4 (takeover finding 2): THE ACCOUNT'S HOME, never $HOME. "This machine's
 *  own browser configuration" (~/.agent-browser/config.json), the directory a
 *  composed config is pinned in and rung H's host-decided scratch profile are
 *  all the ACCOUNT's — read from its passwd entry (`os.userInfo()` asks
 *  getpwuid; `os.homedir()` reads $HOME first, which the agent's shell sets:
 *  `HOME=/tmp/mine vibespace-browser open …` made an agent-written file "the
 *  machine's own" and carried every launch key through the sanctioned road).
 *  No passwd entry (a container uid) ⇒ os.homedir(), and nothing to disagree
 *  with. sshd sets HOME from the same entry, so a legitimate session — local or
 *  on a paired host — never sees `agrees:false`. */
function accountHome() {
  const env = process.env.HOME || '';
  let pw = null;
  try { pw = os.userInfo().homedir || null; } catch { pw = null; }
  if (!pw) return { home: os.homedir(), pw: null, env, agrees: true };
  const norm = (d) => { try { return fs.realpathSync(d); } catch { return path.resolve(d); } };
  return { home: pw, pw, env, agrees: !env || norm(env) === norm(pw) };
}
const HOMES = accountHome();

/** Where the REAL browser CLI lives: PATH in order, never a shim — neither the
 *  directories VibeSpace puts its shim in (this file's own, ~/.vibespace/bin)
 *  nor any file carrying the shim's marker (another checkout's data/bin). */
function realBinary({ pinned = true } = {}) {
  const isShim = (p) => { try { const fd = fs.openSync(p, 'r'); try { const b = Buffer.alloc(512); const n = fs.readSync(fd, b, 0, 512, 0); return b.slice(0, n).toString('utf8').includes(V.SHIM_MARKER); } finally { fs.closeSync(fd); } } catch { return false; } };
  const exists = (p) => { try { const st = fs.statSync(p); return st.isFile() && (st.mode & 0o111) !== 0; } catch { return false; } };
  return V.resolveRealBinary({ PATH: process.env.PATH || '', shimDirs: [__dirname, path.join(HOMES.home, '.vibespace', 'bin'), path.join(os.homedir(), '.vibespace', 'bin')], exists, isShim, pinned: pinned ? pinnedCli() : null });
}
/** verify r2 (H1): VibeSpace's VERIFIED install of one browser CLI version beside this command (data/browser-tools/
 *  agent-browser-<v>/verified.json — written by the keeper only after that program said its version), its program inside
 *  the tools directory (the pin file's rule) and runnable. → the path, or null. */
function installedCliFor(version) {
  if (typeof V.cliInstallDirName !== 'function' || typeof V.cliPinVerdict !== 'function') return null;
  const toolsDir = path.resolve(path.join(__dirname, '..', 'browser-tools'));
  let w = null; try { w = JSON.parse(fs.readFileSync(path.join(toolsDir, V.cliInstallDirName(version), 'verified.json'), 'utf8')); } catch { return null; }
  if (!w || w.version !== version) return null;
  const p = V.cliPinVerdict(w, { toolsDir });
  try { const st = p ? fs.statSync(p) : null; return st && st.isFile() && (st.mode & 0o111) !== 0 ? p : null; } catch { return null; }
}
/** lane browser-admin 2b: the browser CLI VibeSpace installed itself (Settings `browser.cli`), named by the keeper's pin
 *  file BESIDE this command (data/browser-tools/cli-pin.json in a checkout; a remote machine has none ⇒ PATH). */
function pinnedCli() {
  if (typeof V.cliPinVerdict !== 'function') return null; // an older verb table
  const toolsDir = path.join(__dirname, '..', 'browser-tools');
  try { return V.cliPinVerdict(JSON.parse(fs.readFileSync(path.join(toolsDir, 'cli-pin.json'), 'utf8')), { toolsDir: path.resolve(toolsDir) }); } catch { return null; }
}

/** r4 (takeover finding 6): the version of the binary THIS command will run,
 *  read off that binary (`--version` prints and exits: launch-free, ~2 ms
 *  measured on 0.32.0) with no AGENT_BROWSER_* of this shell (an ambient
 *  AGENT_BROWSER_CONFIG naming a missing file makes it exit 1). The server's
 *  cached answer names ITS binary (its PATH); this is the one that runs. */
function installedVersion(bin) {
  const env = Object.fromEntries(Object.entries(process.env).filter(([k]) => !k.startsWith('AGENT_BROWSER_')));
  try { return String(execFileSync(bin, ['--version'], { env, encoding: 'utf8', timeout: 8000, stdio: ['ignore', 'pipe', 'pipe'] })); } catch (e) { return String((e && e.stdout) || ''); }
}

/** r3 (takeover finding 2): THE CONFIG IS NAMED, NEVER SEARCHED. Where the
 *  server named none (a session on another machine — no keeper there —, an
 *  older server, a keeper that could not write its file), it is composed HERE
 *  by the verb table's one rule (`sanctionedConfig`: this machine's
 *  ~/.agent-browser/config.json minus the raw-CDP keys and raw-debugging
 *  switches, and the agent-browser.json in THIS directory only for the keys
 *  that narrow) into a private content-addressed file the child is pointed
 *  at — the browser CLI never searches this directory itself. A file that does
 *  not parse is refused by name (the browser CLI would refuse it too). */
function composeConfig() {
  if (!HOMES.agrees) return { code: 'config_unavailable', error: `$HOME (${HOMES.env}) is not this account's home (${HOMES.pw}) — which file is this machine's own browser configuration is decided by the account, never by an environment variable, so nothing ran`, remedy: 'run it with HOME unchanged; if this machine sets HOME elsewhere on purpose, tell the user' };
  const readJson = (p) => {
    let raw;
    try { raw = fs.readFileSync(p, 'utf8'); } catch (e) { return e && e.code === 'ENOENT' ? { v: null } : { err: `${p}: ${e.message}` }; }
    try { const v = JSON.parse(raw); return v && typeof v === 'object' && !Array.isArray(v) ? { v, p } : { err: `${p}: not a JSON object` }; } catch (e) { return { err: `${p}: ${e.message}` }; }
  };
  const u = readJson(path.join(HOMES.home, '.agent-browser', 'config.json'));
  const pj = readJson(path.join(process.cwd(), 'agent-browser.json'));
  const bad = u.err || pj.err;
  if (bad) return { code: 'config_unavailable', error: `the browser configuration could not be read (${bad}) — the browser CLI would refuse it too`, remedy: 'fix or remove that file, or tell the user' };
  const r = V.sanctionedConfig({ user: u.v, project: pj.v });
  const text = JSON.stringify(r.config, null, 2);
  const dir = path.join(HOMES.home, '.vibespace', 'browser-config');
  try {
    fs.mkdirSync(dir, { recursive: true, mode: 0o700 });
    const st = fs.lstatSync(dir);
    if (st.isSymbolicLink() || !st.isDirectory() || (typeof process.getuid === 'function' && st.uid !== process.getuid())) throw new Error(`${dir} is not a directory this user owns`);
    const file = path.join(dir, crypto.createHash('sha256').update(text).digest('hex').slice(0, 16) + '.json');
    let same = false;
    try { same = fs.readFileSync(file, 'utf8') === text; } catch { same = false; }
    if (!same) { const tmp = `${file}.tmp-${process.pid}`; fs.writeFileSync(tmp, text, { mode: 0o600 }); fs.renameSync(tmp, file); }
    return { file, dropped: r.dropped, projectPath: pj.p || null, userPath: u.p || null };
  } catch (e) {
    return { code: 'config_unavailable', error: `the browser configuration could not be pinned (${e.message}); without it the browser CLI would read an agent-browser.json from whatever directory you stand in, so nothing ran`, remedy: 'tell the user' };
  }
}

/** lane L r5 — THE FRAME. Every path word is resolved PHYSICALLY
 *  (`V.physicalPath`: a symlink is followed before any `..` after it, a literal
 *  `~` is the account's home) against THIS shell's directory — what `./x`
 *  means where the agent typed it (`process.cwd()` is the kernel's getcwd, a
 *  physical path) — and that absolute path is both the one judged and the one
 *  the binary is handed (`inFrame`). null = this shell's directory is gone. */
const FSOPS = { lstat: (p) => fs.lstatSync(p), readlink: (p) => fs.readlinkSync(p) };
const SHELL_CWD = (() => { try { return process.cwd(); } catch { return null; } })();
const isAbsWord = (w) => { const s = String(w); return s[0] === '/' || s === '~' || s.startsWith('~/'); };
/** → `{ok:true, path, lexical}` | `{ok:false, error}` for one word. */
function resolveWord(w, base = SHELL_CWD) {
  const s = String(w);
  if (!isAbsWord(s) && !base) return { ok: false, error: 'this shell\'s current directory no longer exists, so a relative path names nothing' };
  const r = V.physicalPath(s, { base: base || '/', home: HOMES.home, ...FSOPS });
  if (!r.ok) return r;
  const exp = s === '~' ? HOMES.home : (s.startsWith('~/') ? path.join(HOMES.home, s.slice(2)) : s);
  return { ok: true, path: r.path, lexical: path.resolve(base || '/', exp) };
}
/** A directory in its spelling and its realpath (both are judged). */
const spellings = (d) => { let r = null; try { r = fs.realpathSync(d); } catch { r = null; } return r && r !== d ? [d, r] : [d]; };
const HOME_DIRS = [...new Set([HOMES.home, os.homedir()].filter(Boolean))];
const DATA_DIR = path.join(__dirname, '..');

/** lane L r2 — AN UPLOAD NEVER TAKES A FILE FROM THE CREDENTIAL STORES.
 *  With VibeSpace's own tools pre-approved (claude.allowAgentTools) a page
 *  verb runs with no permission card, so `upload @ref ~/.ssh/id_rsa` would hand
 *  a key to any site. Every word the verb table names (`uploadFiles`: every
 *  positional word after `upload`, in any reading, in every batch line) is
 *  resolved in THE FRAME (r5: physically — `l/../.ssh/id_rsa` with `l ->
 *  ~/.ssh` is ~/.ssh/id_rsa) and judged by the table's `uploadPathVerdict`
 *  against ~/.claude, ~/.ssh, ~/.vibespace, ~/.codex of BOTH the account's home
 *  and $HOME, and the account stores of the VibeSpace data dir this file lives
 *  in (each root in its realpath spelling too). A name rule, not containment:
 *  what the agent can read it can still type into a page — the documented
 *  trade-off. */
function uploadRefusal(files) {
  const roots = V.secretUploadRoots({ homes: HOME_DIRS, dataDir: DATA_DIR });
  for (const r of roots.slice()) for (const sp of spellings(r.dir).slice(1)) roots.push({ dir: sp, shown: r.shown });
  const cands = [];
  for (const f of files) {
    const r = resolveWord(f);
    if (!r.ok) return { code: 'upload_secret_refused', error: `\`${String(f).slice(0, 120)}\` could not be resolved (${r.error}); nothing ran`, remedy: 'name the file by an absolute path' };
    cands.push({ file: String(f), paths: r.lexical === r.path ? [r.path] : [r.lexical, r.path] });
  }
  return V.uploadPathVerdict(cands, roots);
}

/** lane L r4 — A WRITE STAYS INSIDE THE PROJECT (or /tmp, ~/Downloads).
 *  `Bash(vibespace-browser:*)` pre-approves every page verb, so a WRITE verb
 *  (`download`/`pdf`/`screenshot`/`state save`/`record`/…) would silently
 *  overwrite an arbitrary path — the write-direction twin of the upload guard.
 *  Every word the verb table names (`writeFiles`, over-named) is resolved in
 *  THE FRAME and confined by `writePathVerdict` to the SESSION's project
 *  directory, the OS temp dir, or ~/Downloads; a named store (.ssh / .claude /
 *  .codex / .vibespace / .git), VibeSpace's own data dir, or a dot-entry
 *  directly under a home is refused even inside an allowed root. Local, before
 *  the binary or /resolve.
 *  r5 F3 — THE FENCE IS THE SESSION'S, never this shell's: the project root is
 *  VIBESPACE_SESSION_CWD, which every VibeSpace spawn path exports (the local
 *  wrapper argv, the remote prelude — test-architecture §59); ABSENT, only the
 *  OS temp dir and ~/Downloads are writable (r4 fell back to process.cwd(), so
 *  `cd /etc && … pdf ./cron.d/x` passed). A relative word still means "from
 *  here" — it is resolved from this shell's directory, then fenced. */
// accept-fixes-jobs F6: inside a Background Work job (its token, no session's) the root is the JOB's working directory —
// VIBESPACE_JOB_CWD, exported by the jobs engine's spawn (src/jobs.js) — and the refusal names the job's case
const IN_JOB = !process.env.VIBESPACE_SESSION_TOKEN && !!process.env.VIBESPACE_JOB_TOKEN;
function sessionRoot() {
  const v = IN_JOB ? process.env.VIBESPACE_JOB_CWD : process.env.VIBESPACE_SESSION_CWD;
  if (typeof v !== 'string' || !isAbsWord(v)) return null;
  const r = V.physicalPath(v, { base: '/', home: HOMES.home, ...FSOPS });
  return r.ok && r.path !== '/' ? r.path : null;
}
function writeRefusal(files) {
  const allow = [os.tmpdir(), ...HOME_DIRS.map((h) => path.join(h, 'Downloads'))].flatMap((d) => { const r = V.physicalPath(d, { base: '/', ...FSOPS }); return r.ok && r.path !== d ? [d, r.path] : [d]; });
  const homes = HOME_DIRS.flatMap(spellings);
  const cands = [];
  for (const f of files) {
    const r = resolveWord(f);
    if (!r.ok) return { code: 'write_path_refused', error: `\`${String(f).slice(0, 120)}\` could not be resolved (${r.error}); nothing ran`, remedy: 'save under the project, /tmp or ~/Downloads, spelled without a symbolic-link loop' };
    cands.push({ file: String(f), paths: r.lexical === r.path ? [r.path] : [r.lexical, r.path] });
  }
  return V.writePathVerdict(cands, { allow, homes, dataDir: spellings(DATA_DIR), sessionRoot: sessionRoot(), job: IN_JOB });
}

/** lane L r5 F1 (CRITICAL) — THE BINARY IS HANDED THE PATH THAT WAS JUDGED.
 *  The daemon resolves a relative word against ITS cwd (the launcher's), not
 *  this shell's — measured on 0.38.1 — so every path SLOT (`V.pathSlots`:
 *  exact, per verb, as measured; judging above over-names) is replaced by its
 *  physical absolute path before the spawn: in the argv, in every batch line
 *  (an argument-form batch is handed over in the binary's own stdin JSON form —
 *  exactly the judged words, never re-quoted), and in every element of a stdin
 *  batch. → `{argv, stdinJson, writes, reads}` (`writes`/`reads` = the slot
 *  words, so the caller judges every word it rewrites). */
function inFrame(cls) {
  const writes = []; const reads = [];
  const isFlagW = (t) => typeof t === 'string' && t.length > 1 && t[0] === '-';   // the verb table's own flag test
  const fix = (words) => {
    const slots = V.pathSlots(words);
    for (const sl of slots) (sl.kind === 'write' ? writes : reads).push(sl.word);
    return slots.length ? V.rewriteSlots(words, slots, (sl) => { const r = resolveWord(sl.word); return r.ok ? r.path : sl.word; }) : words.map(String);
  };
  const argv = cls.argv.map(String);
  if (cls.verb !== 'batch') return { argv: fix(argv), stdinJson: cls.stdinJson != null ? cls.stdinJson : null, writes, reads };
  // a batch: its own flags (`batch --screenshot-dir=…`) are slots of the batch argv; every line is a command
  if (cls.stdinJson != null) {
    const orig = JSON.parse(cls.stdinJson);
    const cmds = orig.map((c) => fix(c));
    // unchanged ⇒ the JSON the agent wrote goes over VERBATIM (r4); a moved path ⇒ exactly the judged words
    return { argv: fix(argv), stdinJson: JSON.stringify(cmds) === JSON.stringify(orig) ? cls.stdinJson : JSON.stringify(cmds), writes, reads };
  }
  const vi = V.verbAt(argv);
  const lines = argv.filter((t, i) => i > vi && !isFlagW(t)).map((l) => l.trim()).filter((l) => l && !l.startsWith('#'));
  const cmds = lines.map((l) => V.splitWords(l));
  const fixed = cmds.map((c) => fix(c));
  // only a batch whose lines carry a path is re-handed — in the binary's own stdin JSON form (exactly the judged
  // words, never re-quoted); a flag after `batch` is a flag, never a value (an accepted batch has none: the table
  // would have judged a value as a command line)
  if (JSON.stringify(fixed) === JSON.stringify(cmds)) return { argv: fix(argv), stdinJson: null, writes, reads };
  return { argv: fix(argv.filter((t, i) => i <= vi || isFlagW(t))), stdinJson: JSON.stringify(fixed), writes, reads };
}

/** lane L r5 F1 (b) — DEFENSE IN DEPTH: the binary runs in a private, empty
 *  directory (`V.ensureDaemonCwd`: <tmp>/vibespace-browser-cwd-<uid>, never the
 *  checkout, never this shell's directory) — when no daemon runs, this spawn
 *  STARTS one, and the daemon keeps the directory it was started in. Every path
 *  a known verb takes is handed absolute (`inFrame`), so the binary never needs
 *  this shell's directory. */
const CHECKOUT = (() => { const r = path.join(__dirname, '..', '..'); return fs.existsSync(path.join(r, 'server.js')) ? r : null; })();
function daemonCwd() {
  return V.ensureDaemonCwd({ fs, tmpdirs: [os.tmpdir(), '/tmp'], uid: typeof process.getuid === 'function' ? process.getuid() : null, checkout: CHECKOUT, serverCwd: null });
}

/** Read all of stdin (a batch whose lines arrive there). */
function readStdin() { try { return fs.readFileSync(0, 'utf8'); } catch { return ''; } }

/** A PAGE verb (or an escape): the ONE /resolve call, the real binary, the audit. */
async function runPage(c) {
  let cls = c;
  let stdinBuf = null;
  if (cls.verb === 'batch' && cls.needsStdin) {
    // r4 (takeover finding 3): the binary reads a stdin batch ONLY as a JSON array of string arrays — the
    // verb table parses it the same way (plain lines are converted), judges exactly those words, and the
    // binary is handed exactly `stdinJson`
    stdinBuf = readStdin();
    cls = V.classify(rawArgs, { ours: true, stdin: stdinBuf });
    if (cls.kind === 'refused') refuseLocally(cls);
  }
  // lane L r2: an upload from a credential store is refused HERE, by name — before the binary is looked up,
  // before /resolve (server-independent)
  if (cls.uploadFiles && cls.uploadFiles.length) {
    const up = uploadRefusal(cls.uploadFiles);
    if (up) refuseLocally(up);
  }
  // lane L r4: a WRITE outside the project / temp / ~/Downloads (or into a credential store) is refused HERE,
  // by name — before the binary is looked up (no spawn, not even `--version`) and before /resolve
  if (cls.writeFiles && cls.writeFiles.length) {
    const wr = writeRefusal(cls.writeFiles);
    if (wr) refuseLocally(wr);
  }
  // lane L r5 F1: the words the binary will be handed as paths are rewritten to the absolute path judged here —
  // and every rewritten word is judged (the over-named sets above already hold them; this is the proof, not a hope)
  let framed = inFrame(cls);
  { const wr = framed.writes.length ? writeRefusal(framed.writes) : null; if (wr) refuseLocally(wr); }
  const runCwd = daemonCwd();
  if (!runCwd.ok) refuseLocally(runCwd);
  let bin = realBinary();
  if (!bin.ok) refuseLocally(bin);
  // r4 (takeover finding 6): the flag table is a measurement of ONE version. Another build ⇒ every flag is
  // judged under both readings (and said once) — before /resolve, so a refused command starts no browser
  const binVersionRaw = installedVersion(bin.path);
  const binVersion = (String(binVersionRaw).match(/(\d+\.\d+\.\d+)/) || [])[1] || null;
  const drift = V.versionDrift(binVersionRaw);
  if (drift) {
    console.error(`note: the browser CLI here is ${drift}; this VibeSpace's flag table was measured on ${V.TABLE_VERSION}, so every flag is judged under both readings until it is re-measured [flag_table_drift]`);
    const d = V.classify(rawArgs, { ours: true, drift, ...(stdinBuf != null ? { stdin: stdinBuf } : {}) });
    if (d.kind === 'refused') refuseLocally(d, d.code === 'unknown_verb' ? 2 : 1);
    cls = d;
    framed = inFrame(cls);
    { const wr = framed.writes.length ? writeRefusal(framed.writes) : null; if (wr) refuseLocally(wr); }
