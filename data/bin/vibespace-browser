  const loopWake = !!(dlg && dlg.watched && dlg.profileId && !dialogVerb) && (!loopPass(words[0] || '') || loopNav || shotVerb);
  const pmWake = loopNav || pkWake; // lane browser-ui-prompts-r2: a navigating / acting verb ends at an HTTP sign-in AT ONCE (never its 25 s timeout)
  // a SCREENSHOT of a looping tab is bounded (measured on 0.38.1: the never-painting shape has no frame — the CLI sat 30 s)
  const tStart = Date.now();
  let shotTimer = null;
  const boundShot = (l) => {
    if (!shotVerb || shotTimer || childDone) return;
    shotTimer = setTimeout(() => { if (childDone) return; shotCut = l; try { child.kill('SIGTERM'); } catch { /* ended */ } }, Math.max(0, tStart + LOOP_SHOT_MS - Date.now()));
  };
  if (loopStand) boundShot(loopStand);
  if (dlg && dlg.watched && dlg.profileId && !dialogVerb) {
    (async () => {
      while (!childDone) {
        const w = await peek(`/api/agent/browser/dialog?profile=${encodeURIComponent(dlg.profileId)}&wait=20000${loopWake ? `&loop=1&after=${loopNav && Number(r.at) > 0 ? Number(r.at) : 0}` : ''}${pkWake ? '&passkey=1' : ''}${pmWake ? '&prompt=1' : ''}`, pollAbort.signal);
        if (childDone || !w || w._failed) return;
        if (w.open) { dialogHit = w; try { child.kill('SIGTERM'); } catch { /* ended */ } return; }
        if (w.passkey && pkWake) { passkeyHit = w.passkey; try { child.kill('SIGTERM'); } catch { /* ended */ } return; }
        if (w.prompt && pmWake) { promptHit = w.prompt; try { child.kill('SIGTERM'); } catch { /* ended */ } return; } // lane browser-ui-prompts-r2
        if (w.loop && readVerb && w.loop.readable) return; // verify r4 #4: a reading verb on a readable loop answers on its own
        if (w.loop && shotVerb) { boundShot(w.loop); return; }
        if (w.loop) { loopHit = w.loop; try { child.kill('SIGTERM'); } catch { /* ended */ } return; }
      }
    })();
  }
  child.on('exit', async (code) => {
    childDone = true; pollAbort.abort(); if (shotTimer) clearTimeout(shotTimer);
    const outText = Buffer.concat(outChunks).toString('utf8'), errText = Buffer.concat(errChunks).toString('utf8');
    const tail = (outText + errText).slice(-4000);
    // §3.7's audit: who used which browser, when, to do WHAT (the verb only —
    // a fill's content is never recorded) — the ephemeral browser too. A
    // navigation also stamps the lease's lastUrl (the URL rides `url`, never
    // the audit line). Best effort.
    // the owner's ruling (2026-09-27): the audit also answers whether a takeover caught this command in flight — `since`
    // is the SERVER's instant its /resolve answered (never this machine's clock)
    // lane browser-stuck: …and what the verb ran into (`dialog`: the watch's fact after it, the notes it was not told);
    // `timedOut` / `dialog` feed the unresponsive verdict (the browser CLI's own timeout words, measured on 0.38.1)
    const timedOut = DS ? DS.timedOutText(outText + '\n' + errText) : /CDP command timed out|tab is not responding/.test(outText + errText);
    let au = null;
    const nav = navVerb && code === 0 ? navFacts(outText) : null; // lane browser-propose: the final url + title the server judges for the sign-in hint
    // verify r4 #1: a `tab new` that succeeded names its tab (the ack) — the server binds it to this conversation
    const tabAck = words[0] === 'tab' && words[1] === 'new' && code === 0 && profileId ? await tabNewAck(outText, { bin: bin.path, env, cwd: runCwd.dir, wantsJson }) : null;
    try { au = await call('POST', '/api/agent/browser/audit', { profile: profileId, verb: words[0] || null, ok: code === 0 && !dialogHit && !loopHit && !shotCut && !passkeyHit && !promptHit, ...(navUrl ? { url: navUrl } : {}), ...(tabAck ? { tab: { new: true, targetId: tabAck.targetId } } : {}), ...(Number(r.at) > 0 ? { since: Number(r.at) } : {}), ...(r.kind === 'child' && r.handle ? { handle: r.handle } : {}), ...(timedOut && !loopHit && !shotCut ? { timedOut: true } : {}), ...(dialogHit ? { dialog: true } : {}), ...(loopHit ? { loop: 'cut' } : shotCut ? { loop: true } : {}), ...(nav ? { nav } : {}) }, { soft: true }); } catch { au = null; }
    const after = au && !au._failed && au.dialog && typeof au.dialog === 'object' ? au.dialog : null;
    // THE VERDICT: a dialog holds the page (the long-poll's hit, else the watch's fact after the verb, else — where no watch
    // runs — the browser CLI's own line) ⇒ the sentence FIRST, exit 1 [dialog_open]
    let open = dialogHit && dialogHit.open ? { open: dialogHit.open, text: dialogHit.text } : (after && after.open ? { open: after.open, text: after.text } : null);
    // verify r1 A5: …or where the watch CANNOT see (a tab it attached to after a dialog opened — across a VibeSpace
    // restart —, or a shared browser whose tab of yours it does not know): the lease's own daemon's line is the evidence
    const cannotSee = (x) => !!(x && (x.blind || x.unattributed));
    if (!open && DS && (!(dlg && dlg.watched) || cannotSee(dlg) || cannotSee(after)) && !dialogVerb) {
      const dl = DS.daemonDialogLine(outText + '\n' + errText);
      if (dl && dl.type !== 'alert') open = { open: { type: dl.type, message: dl.message }, text: DS.dialogText({ type: dl.type, message: dl.message }) };
    }
    const notes = after && Array.isArray(after.notes) ? after.notes : [];
    const strip = !!DS && !dialogVerb && !!(open || notes.length); // verify r1 A5: the browser CLI's own `dialog` verb (the fallback) prints ITS dialog lines — they are the answer
    // lane browser-passkey: the verb met a page waiting for a passkey (the long-poll's hit, or a timeout while one stands) ⇒ THE SENTENCE first
    const pkHit = passkeyHit || (timedOut && after && after.passkey && after.passkey.state === 'passkey_open' ? after.passkey : null);
    if (open) printDialogOpen(open);
    else if (promptHit) { // lane browser-ui-prompts-r2: the page asked for an HTTP sign-in and waits — THE SENTENCE first, the verb's own timeout never
      if (wantsJson) console.log(JSON.stringify({ success: false, data: null, code: 'page_prompt', prompt: promptHit, error: promptHit.text || '' }));
      else console.log(promptHit.text || 'The page asked for an HTTP sign-in and waits — only the user can answer it in the live view.');
      console.error('[page_prompt]');
      for (const h of head) console.error(h);
      for (const n of notes) console.error(`note: ${n} [page_dialog]`);
      process.exit(1);
    }
    else if (pkHit) {
      printPasskey(pkHit);
      for (const h of head) console.error(h);
      for (const n of notes) console.error(`note: ${n} [page_dialog]`);
      process.exit(1);
    }
    // lane site-reset: the verb ran into a NAVIGATION LOOP (the watch judged it while the verb waited) — the sentence FIRST,
    // the binary's own timeout words never; a screenshot the loop left without a picture says so by name
    else if (loopHit || shotCut) {
      if (loopHit) { printLoop(loopHit); if (DS && typeof DS.busyText === 'function') { const left = tStart + (DS.CLI_ACTION_TIMEOUT_MS || 25000) - Date.now(); if (left > 1000) console.error(`note: ${DS.busyText(left)} [session_busy]`); } }
      else { const w = DS && typeof DS.noPictureText === 'function' ? DS.noPictureText(shotCut) : 'no picture: the page never drew a frame (a navigation loop) — stop it first (vibespace-browser stop)'; if (wantsJson) console.log(JSON.stringify({ success: false, data: null, code: 'no_picture', loop: DS && typeof DS.loopBlock === 'function' ? DS.loopBlock(shotCut) : shotCut, error: w })); else console.log(w); console.error('[no_picture]'); }
      for (const h of head) console.error(h);
      for (const n of notes) console.error(`note: ${n} [page_dialog]`);
      if (after && after.loop && !loopHit) console.error(`note: ${after.loop.text} [navigation_loop]`);
      const interrupted0 = au && !au._failed && au.interrupted ? au.interrupted : null;
      if (interrupted0) printInterrupted(interrupted0, code);
      process.exit(1);
    }
    for (const h of head) if (!(after && h === stuckLine)) console.error(h);
    for (const n of notes) console.error(`note: ${n} [page_dialog]`);
    if (after && after.loading) console.error(`note: ${after.loading} [page_loading]`); // verify r2 #5: a timeout while the tab loads is SAID (the time so far)
    if (after && after.stuck) console.error(`note: ${after.stuck} [page_unresponsive]`);
    if (after && after.prompt && after.prompt.text) console.error(`note: ${after.prompt.text} [page_prompt]`); // lane browser-ui-prompts: a file chooser / an HTTP sign-in the page opened
    // lane site-reset: a way-out verb (a tab switch, a close, a screenshot) that ran beside a loop still standing is told it
    if (after && after.loop && !navVerb) console.error(`note: ${after.loop.text} [navigation_loop]`);
    // verify r1: on a SHARED browser whose tab of yours VibeSpace cannot tell, a verb that failed or timed out beside a looping
    // tab is told that much (no address — another conversation's page) with the way out; before, only the binary's timeout line
    if (after && after.loopShared && !after.loop && (code !== 0 || timedOut) && DS && typeof DS.loopSharedText === 'function') console.error(`note: ${DS.loopSharedText()} [navigation_loop_shared]`);
    const outShown = strip ? DS.stripDaemonDialogLines(outText) : outText, errShown = strip ? DS.stripDaemonDialogLines(errText) : errText;
    if (!(open && wantsJson)) process.stdout.write(outShown); // --json with a dialog: the ONE JSON object on stdout is ours
    process.stderr.write(errShown);
    if (navVerb) { const h = navHint(tail); if (h) console.error(h); }
    // lane browser-propose step 2: the server's hint for this navigation's final page (a known vendor's sign-in refusal) —
    // printed exactly as the 403/429 one is
    if (navVerb && au && !au._failed && au.hint && au.hint.text) console.error(`hint: ${au.hint.hint || 'may-need-cloak'} — ${au.hint.text}`);
    // lane browser-propose step 3: the user REJECTED the switch this conversation proposed for that host — said ONCE, here
    if (navVerb && au && !au._failed && au.proposalRejected && au.proposalRejected.text) console.error(`note: ${au.proposalRejected.text} [proposal_rejected]`);
    // verify r1 V1 (lane browser-propose): the sites CloakBrowser's list refused while this verb ran — by name, any page verb
    if (au && !au._failed && au.egressRefused && au.egressRefused.text) console.error(`note: ${au.egressRefused.text} [egress_refused]`);
    // lane browser-resume C: the tab this session was bound to is GONE (closed — by the user while he drove, by you, or with the
    // browser) — the binary's own words name its hidden CLI; the way out is this tool's
    if (code !== 0 && /\btab_gone\b/.test(outText + errText)) console.error('note: your tab is gone (it was closed) — `vibespace-browser tab list` names your tabs; `vibespace-browser tab <id>` switches to one, `vibespace-browser tab new <url>` opens one [tab_gone]');
    const interrupted = au && !au._failed && au.interrupted ? au.interrupted : null; // said LAST (after a close's own bookkeeping), exit 1
    if (open) { if (interrupted) printInterrupted(interrupted, code); process.exit(1); }
    if (rest[0] === 'close' && profileId && r.kind === 'attachment') {
      // LANE H VERIFY r3: the lease drop after a `close` is its own request — a takeover that began while the binary ran
      // refuses it (browser_paused). Said as what it is (the close RAN, the lease was NOT dropped, the code, the way
      // out) and the exit is non-zero; r2 sat it in a bare try/catch and printed only the server's words about a `detach`
      const d = await call('POST', '/api/agent/browser/detach', { profile: profileId }, { soft: true });
      if (d && d._failed) {
        console.error(`note: your \`close\` ran, but your lease on "${r.profile.label}" was NOT dropped — ${d.error || 'HTTP ' + d._status}${d.code ? ` [${d.code}]` : ''}${d.code === 'browser_paused' ? '; run `vibespace-browser detach` after they hand it back' : ''}`);
        if (interrupted) printInterrupted(interrupted, code);
        process.exit(code != null && code !== 0 ? code : 1);
      }
      console.error(profileLine(r.profile, null, r.others, r.handle) + ' · lease dropped');
    }
    if (interrupted) { printInterrupted(interrupted, code); process.exit(1); }
    process.exit(code == null ? 1 : code);
  });
}

/** lane site-reset: a way out through VibeSpace's own socket (`/api/agent/browser/direct`) — `stop` always, a bare `tab close`
 *  and a `screenshot` while a loop stands. → true when it answered (printed, audited, exited), false = run the binary. */
async function runDirect(action, { r, head, profileId, wantsJson, shotPath = null }) {
  const verbName = action === 'close' ? 'tab' : action;
  const audit = (ok) => call('POST', '/api/agent/browser/audit', { profile: profileId, verb: verbName, ok, ...(Number(r.at) > 0 ? { since: Number(r.at) } : {}) }, { soft: true }).catch(() => null);
  const a = await call('POST', '/api/agent/browser/direct', { profile: profileId, action }, { soft: true });
  if (a._failed && a.code === 'no_loop' && action !== 'stop') return false; // the loop ended meanwhile: the binary's own verb
  for (const h of head) console.error(h);
  if (a._failed) {
    // lane fleet-image-2: the answer WITHOUT a picture tells the loop as the answer with one does (below) — on a pod whose
    // chromium never painted the looping page within 4 s, the agent screenshotting it was never told it loops
    if (a.code === 'no_picture') { if (wantsJson) console.log(JSON.stringify({ success: false, data: null, code: 'no_picture', loop: a.loop || null, error: a.error || '' })); else console.log(a.error || 'no picture'); console.error('[no_picture]'); if (a.loop && DS && typeof DS.loopText === 'function') console.error(`note: ${DS.loopText(a.loop)} [navigation_loop]`); await audit(false); process.exit(1); }
    if (wantsJson) console.log(JSON.stringify({ success: false, data: null, code: a.code || 'refused', error: a.error || '' }));
    console.error(`${a.error || 'HTTP ' + a._status} [${a.code || 'refused'}]`);
    if (a.remedy) console.error(`  remedy: ${a.remedy}`);
    await audit(false);
    process.exit(1);
  }
  if (action === 'screenshot') {
    const file = shotPath || path.join(os.tmpdir(), `vibespace-screenshot-${Date.now()}.png`);
    try { fs.writeFileSync(file, Buffer.from(String(a.data || ''), 'base64')); } catch (e) { console.error(`the picture could not be written to ${file} (${e.message}) [write_failed]`); await audit(false); process.exit(1); }
    if (wantsJson) console.log(JSON.stringify({ success: true, data: { path: file, loop: a.loop || null }, error: null }));
    else console.log(`✓ Screenshot saved to ${file}`);
    if (a.loop && DS && typeof DS.loopText === 'function') console.error(`note: ${DS.loopText(a.loop)} [navigation_loop]`);
  } else if (wantsJson) console.log(JSON.stringify({ success: true, data: action === 'stop' ? { stopped: !a.nothing, url: a.url || '', title: a.title || '', loop: a.loop || null } : { closed: true, url: a.url || '', opened: !!a.opened, loop: a.loop || null }, error: null }));
  else console.log(a.text || 'done');
  await audit(true);
  process.exit(0);
}
/** lane site-reset: `stop` and `site-reset <host> | --host <host>` — after the one /resolve, the server acts through its
 *  watch (never the browser CLI's queue); the answer is printed, the audit written like every verb's. */
async function runOursPage(cls, { r, head, profileId, wantsJson }) {
  const verbName = cls.verb;
  const words = cls.argv.filter((x) => !x.startsWith('-'));
  // lane browser-passkey: `passkey status | cancel` — a page of yours waiting for a passkey, said or ended (the page's
  // promise rejects AbortError; its other way in takes input again)
  if (verbName === 'passkey') {
    const sub = words[1] || 'status';
    if (!['status', 'cancel'].includes(sub) || words.length > 2) refuseLocally({ code: 'bad-request', error: `passkey takes status | cancel — not "${words.slice(1).join(' ')}"`, remedy: 'vibespace-browser passkey status' }, 2);
    const a = await call('POST', '/api/agent/browser/passkey', { profile: profileId, action: sub }, { soft: true });
    for (const h of head) console.error(h);
    await call('POST', '/api/agent/browser/audit', { profile: profileId, verb: 'passkey', ok: !a._failed, ...(Number(r.at) > 0 ? { since: Number(r.at) } : {}) }, { soft: true }).catch(() => null);
    if (a._failed) {
      if (wantsJson) console.log(JSON.stringify({ success: false, data: null, code: a.code || 'refused', error: a.error || '' }));
      console.error(`${a.error || 'HTTP ' + a._status} [${a.code || 'refused'}]`);
      process.exit(1);
    }
    if (wantsJson) console.log(JSON.stringify({ success: true, data: sub === 'status' ? { passkey: a.passkey || null } : { cancelled: a.cancelled || 0 }, error: null }));
    else console.log(a.text || 'done');
    process.exit(0);
  }
  // lane browser-ui-prompts-r2: `permission <kind> allow|deny [origin] [lat,lon]` — OUR CDP act (0.38.1 has no such verb): every
  // kind is denied ahead by the watch; this flips one kind for one origin on your own browser (recorded on the lease + the trace)
  if (verbName === 'permission') {
    const [, kind, setting, a3, a4] = words;
    const at = a3 && /^-?[\d.]+,-?[\d.]+$/.test(a3) ? a3 : a4;
    const origin = a3 && a3 !== at ? a3 : '';
    if (!kind || !setting || words.length > 5) refuseLocally({ code: 'bad-request', error: 'permission takes <kind> allow|deny [origin] [lat,lon]', remedy: 'vibespace-browser permission geolocation allow' }, 2);
    const a = await call('POST', '/api/agent/browser/permission', { profile: profileId, kind, setting, ...(origin ? { origin } : {}), ...(at ? { at } : {}) }, { soft: true });
    for (const h of head) console.error(h);
    await call('POST', '/api/agent/browser/audit', { profile: profileId, verb: 'permission', ok: !a._failed, ...(Number(r.at) > 0 ? { since: Number(r.at) } : {}) }, { soft: true }).catch(() => null);
    if (a._failed) {
      if (wantsJson) console.log(JSON.stringify({ success: false, data: null, code: a.code || 'refused', error: a.error || '' }));
      console.error(`${a.error || 'HTTP ' + a._status} [${a.code || 'refused'}]`);
      process.exit(1);
    }
    if (wantsJson) console.log(JSON.stringify({ success: true, data: { permission: a.permission || null }, error: null }));
    else console.log(a.text || 'done');
    process.exit(0);
  }
  if (verbName === 'stop') {
    if (words.length > 1) refuseLocally({ code: 'bad-request', error: '`stop` takes nothing — it stops your tab that is loading (or looping)', remedy: 'vibespace-browser stop' }, 2);
    return runDirect('stop', { r, head, profileId, wantsJson });
  }
  if (verbName === 'site-reset') {
    // `site-reset <host>` (a site of one of your own tabs) | `site-reset --host <host>` (named on purpose)
    const hi = cls.argv.indexOf('--host');
    const explicit = hi >= 0;
    const host = explicit ? (cls.argv[hi + 1] || '') : (words[1] || '');
    if (!host || host.startsWith('-') || words.length > (explicit ? 2 : 2)) refuseLocally({ code: 'bad-request', error: '`site-reset` takes ONE host: `site-reset <host>` (the site of your current tab) or `site-reset --host <host>`', remedy: 'vibespace-browser site-reset <host>' }, 2);
    const audit = (ok) => call('POST', '/api/agent/browser/audit', { profile: profileId, verb: 'site-reset', ok, ...(Number(r.at) > 0 ? { since: Number(r.at) } : {}) }, { soft: true }).catch(() => null);
    const a = await call('POST', '/api/agent/browser/site-reset', { profile: profileId, host, explicit }, { soft: true });
    for (const h of head) console.error(h);
    if (a._failed) {
      if (wantsJson) console.log(JSON.stringify({ success: false, data: null, code: a.code || 'refused', error: a.error || '' }));
      console.error(`${a.error || 'HTTP ' + a._status} [${a.code || 'refused'}]`);
      if (a.remedy) console.error(`  remedy: ${a.remedy}`);
      await audit(false);
      process.exit(1);
    }
    if (wantsJson) console.log(JSON.stringify({ success: true, data: a.proposal ? { proposal: a.proposal } : { cleared: a.cleared }, error: null }));
    else console.log(a.text || 'done');
    await audit(true);
    process.exit(0);
  }
  refuseLocally({ code: 'unknown_verb', error: `unknown verb "${verbName}"` }, 2);
}

(async () => {
  if (C.kind === 'refused') refuseLocally(C, C.code === 'unknown_verb' ? 2 : 1);
  if (C.kind === 'page' || C.kind === 'escape') return runPage(C);
  if (verb === 'help') { console.log(USAGE); return; }
  needSession();

  if (verb === 'profiles') {
    const r = await call('GET', '/api/agent/browser/profiles');
    if (!r.profiles.length) { console.log('no browser profiles yet — `vibespace-browser new <label>` creates one every conversation of the user\'s can use.'); return; }
    const mine = new Map((r.me?.attachments || []).map((a) => [a.profileId, a]));
    for (const p of r.profiles) {
      const leases = r.leases.filter((l) => l.profileId === p.id);
      const b = r.browsers[p.id];
      const a = mine.get(p.id);
      // "Who can use it" (a list): only whether THIS conversation may, and through what — never the list, never a key
      const u = p.use || {};
      const usedBy = u.mode !== 'only' ? 'all your conversations'
        : u.unreadable ? 'chosen conversations — unknown for yours right now (the Task Group list could not be read)'
          : u.you ? `chosen conversations — yours included${u.via === 'task' ? ' (through its Task Group)' : ''}`
            : 'chosen conversations — not yours (the user can add this conversation under "Who can use it" in the Agent browser panel)';
      console.log(`${a ? (a.isDefault ? '*' : '+') : ' '} ${p.label}  (${p.id})${a ? '  handle: ' + a.alias : ''}  ${p.provider}${p.host ? ' on ' + p.host : ''}${p.cdpPort ? ' cdp:' + p.cdpPort : ''}${p.legacy ? '  [legacy shared]' : (p.mediated ? '  [separate tabs, mediated]' : '')}  used by: ${usedBy}  browser: ${b ? b.state : 'not running'}  attached: ${leases.length}${p.proxy ? '  proxy: ' + p.proxy : ''}`);
    }
    console.log(`(${r.cap.used}/${r.cap.cap} browsers running; * = my default, + = attached${r.floor && !r.floor.sharedProfiles ? '; shared profiles need the browser CLI ' + r.floor.floor + ' or newer — ' + (r.floor.installed || 'none') + ' is installed, so your tab is not pinned on a shared profile' : ''})`);
    return;
  }

  if (verb === 'new') {
    const label = args[1];
    if (!label || label.startsWith('--')) { console.error('usage: vibespace-browser new <label> [--proxy <url>] [--notes <text>] [--adopt <dir>] [--provider <id>] [--host <machine>] [--cdp-port <n>] [--sharing owner|instance]\n       vibespace-browser new <label> --backend desktop-app [--url <https://…>] [--keep-profile] [--size WxH] [--mode auto|tree|pixels]'); process.exit(2); }
    // lane e2a (§E2.1): `--backend desktop-app` = a real desktop browser of this conversation's own, beside its chat (a
    // WINDOW TARGET — no CDP); `--size WxH` pins its pixel size (lane e2b, the server judges it); `--mode auto|tree|pixels` = how it is driven (lane e2c)
    const r = await call('POST', '/api/agent/browser/new', { label, proxy: flag('--proxy'), notes: flag('--notes'), adoptDir: flag('--adopt'), provider: flag('--provider'), host: flag('--host'), cdpPort: flag('--cdp-port'), sharing: flag('--sharing'),
      backend: flag('--backend'), url: flag('--url'), keepProfile: has('--keep-profile') || undefined, size: flag('--size'), mode: flag('--mode') });
    if (r.desktopApp) {
      const d = r.desktopApp;
      console.log(`opened ${d.label} as your desktop browser — handle ${d.handle}${d.url ? ' at ' + d.url : ''} (${d.state || 'launching'}); it opens beside your chat on the screen showing it${d.pin ? ` — pinned ${d.pin.w}×${d.pin.h} (\`vibespace-window size ${d.handle} auto\` unpins)` : ''}`);
      if (r.mode) console.log(`mode: ${r.mode.mode} — ${r.modeWhy || r.mode.why}`); // lane e2c: the launch verdict's why, verbatim
      console.log(`no CDP on this backend: drive it with \`vibespace-window snapshot ${d.handle}\`, then \`vibespace-window click / type / key / screenshot ${d.handle} …\` — \`vibespace-browser\` page verbs answer no_cdp_on_this_backend there`);
      console.log(`a real Chrome with no egress policy and its own throwaway profile${d.keepProfile ? ' (kept: --keep-profile)' : ' (deleted when the window\'s session ends)'}; the user can act in it at any time`);
      return;
    }
    const where = r.profile.dir ? `at ${r.profile.dir}` : (r.profile.provider === 'cdp' ? `reaching an existing browser over CDP (${r.profile.host ? r.profile.host + ':' : '127.0.0.1:'}${r.profile.cdpPort}; nothing is started)` : `on ${r.profile.host} (its directory is that machine's)`);
    console.log(`${r.adopted ? (r.created ? 'adopted' : 'already registered') : 'created'} ${r.profile.label} (${r.profile.id}) ${where} — every conversation of the user's can use it (one browser; each conversation in its own tab)${r.profile.mediated ? '; separate tabs (each conversation confined to its own through a mediated CDP url)' : ''}. \`vibespace-browser use ${r.profile.id}\` to attach.`);
    return;
  }

  if (verb === 'providers') {
    const r = await call('GET', '/api/agent/browser/providers' + (flag('--host') ? '?host=' + encodeURIComponent(flag('--host')) : ''));
    for (const p of r.providers || []) {
      const v = p.onHost || p.control;
      console.log(`${v.ok ? '✓' : '✗'} ${p.id}  tier ${p.tier}  ${p.label}${v.ok ? (p.remote ? `  (remote: ${p.remote})` : '  (this machine only)') : `\n    cannot be used${r.host ? ' on ' + r.host : ' here'}: ${v.error}`}`);
    }
    if (r.proof) console.log(`egress measurement (§7.2.1) for cloak: ${r.proof.status}${r.proof.refusal ? ' — ' + r.proof.refusal : ''} (${r.proof.date}${r.proof.version ? ', ' + r.proof.version : ''}${r.proof.chromium ? ', Chromium ' + r.proof.chromium : ''})`);
    // lane-cloak: what the record implies, and what a cloak browser may reach HERE (the deployment's named sites)
    if (r.proof && r.proof.status === 'measured' && r.egress) {
      console.log(`  the browser itself reached: ${(r.egress.run || []).length ? r.egress.run.join(', ') : 'nothing beyond loopback'}; its one-time download: ${(r.egress.install || []).join(', ') || 'none'}`);
      console.log(`  a cloak browser may open here: ${(r.cloakSites || []).length ? r.cloakSites.join(', ') : 'no site yet — the user names them (Settings → Agent browser); everything else is refused'}`);
    }
    // lane browser-admin (chunk 3): the Chrome builds there and the browser CLI version in use — FACTS (the user chooses a
    // profile's build in the Agent browser panel; this command never sets one)
    if (r.builds) {
      if (r.builds.ok === false) console.log(`chrome builds${r.host ? ' on ' + r.host : ''}: cannot be listed (${r.builds.code})`);
      else console.log(`chrome builds${r.host ? ' on ' + r.host : ' here'}: ${(r.builds.builds || []).length ? r.builds.builds.map((b) => b.version + (b.usable ? '' : ' (not runnable)')).join(', ') : 'none installed'} — a profile's build is the user's choice (Agent browser panel → Change build…)`);
    }
    if (r.cli) console.log(`browser driver: ${r.cli.inUse || 'unknown'} in use${r.cli.inUsePinned ? ' (VibeSpace\'s own install)' : ' (from PATH)'}; this tool's flag table was measured on ${r.cli.table}${r.cli.drift ? ' — every flag is judged both ways' : ''}${r.cli.mode !== 'path' && !r.cli.pinnedInstalled ? `; the user chose ${r.cli.chosen}, not installed yet` : ''}`);
    return;
  }

  if (verb === 'new-child') {
    const r = await call('POST', '/api/agent/browser/new-child', {});
    // the sub-agent needs ONE name — its handle; the browser identity behind
    // it is the server's business and this tool's (§3.4)
    console.error(`child handle ${r.handle} minted — its own ephemeral browser, reaped with this conversation. The sub-agent runs this line in its OWN tool call (or passes --profile ${r.handle} on every command):`);
    console.log(`export VIBESPACE_BROWSER=${shq(r.handle)}`);
    return;
  }

  if (verb === 'use') {
    const ref = args[1];
    if (has('--print')) refuseLocally({ code: 'not_offered', error: '`use --print` is not offered — there is nothing to export: `use <label>` attaches, and every `vibespace-browser <verb>` then runs on that browser', remedy: `vibespace-browser use ${ref && !ref.startsWith('--') ? shq(ref) : '<label>'}` });
    if (!ref || ref.startsWith('--')) { console.error('usage: vibespace-browser use <label|id> [--alias <handle>]'); process.exit(2); }
    const r = await call('POST', '/api/agent/browser/use', { profile: ref, alias: flag('--alias') });
    console.log(profileLine(r.profile, r.lease, r.others, r.alias) + (r.created ? ' · lease created' : ' · lease already held'));
    // P6 (§6.2): a mediated attachment says what it is — you see and drive only your own tabs
    if (r.mediated && r.note) console.log(r.note);
    if (r.displayNote) console.error(`note: ${r.displayNote}`); // lane headless-fallback: this use launched it headless (no desktop session) / elsewhere
    if ((r.attachments || []).length > 1) console.log(`this session now holds ${r.attachments.length} browsers (${handlesLine(r.handles)}) — name one with --profile <handle> or VIBESPACE_BROWSER on every command.`);
    console.log(`attached — run \`vibespace-browser <verb>\` (e.g. \`vibespace-browser${(r.attachments || []).length > 1 ? ' --profile ' + (r.alias || r.profile.id) : ''} open <url>\`); your lease stays until \`vibespace-browser detach\`.`);
    return;
  }

  if (verb === 'detach') {
    const r = await call('POST', '/api/agent/browser/detach', { profile: handle || undefined });
    // verify r1 L2: detaching the conversation's managed ephemeral browser STOPS it — said, never "idles out"
    if (r.ephemeral) { console.log(`detached — ${r.note || 'this conversation\'s own browser is stopped now; the next browser command starts it again'}`); return; }
    console.log(`detached from ${r.lease.profileId}${r.others ? ` (${r.others} other session(s) still attached)` : ' (nobody else attached — its browser idles out unless re-attached)'}${(r.attachments || []).length ? `; still attached: ${handlesLine(r.handles)}` : ''}`);
    return;
  }

  if (verb === 'status') {
    const r = await call('GET', '/api/agent/browser/status');
    // accept-fixes-jobs F5: inside a Background Work job the answer is the JOB's binding — the profile its next page verb
    // lands on (its conversation's pin / default), in a window of its own — never the empty set of its own handle
    if (r.job) {
      const j = r.job, l = j.lease;
      console.log(`this is Background Work ${j.label || 'job'} (${j.id}): it browses as its conversation — in the conversation's pinned profile, in a window of its own`);
      if (j.lands) console.log(`its page verbs land on ${j.lands.label} (${j.lands.profileId}) · its window: ${l ? (l.browser ? l.browser.state + (l.browser.pid ? ' pid ' + l.browser.pid : '') : 'browser not running') + ' · input: ' + (l.input || '?') + ' · ' + l.others + ' other holder(s)' : 'not opened yet — its first page verb opens it'}`);
      else console.log(`its page verbs are refused ${j.refused ? j.refused.code + ' — ' + j.refused.error : 'job_no_profile'}`);
      console.log(j.pin ? `the conversation's pin: ${j.pin.label} (${j.pin.profileId}) — origin: ${j.pin.origin}, set ${when(j.pin.at)}` : 'the conversation\'s pin: none — pin a profile FROM the conversation (vibespace-browser pin <profile>)');
      if (r.noDisplay) console.log(r.noDisplay);
      return;
    }
    const set = r.attachments || [];
    const eph = r.ephemeral || null;
    const ephWords = eph ? `ephemeral: ${eph.state === 'not-started' ? 'not started yet' : eph.state}${eph.startedAt ? ', started ' + ago(eph.startedAt) : ''}${eph.live && eph.pid ? ', pid ' + eph.pid : ''}` : 'ephemeral: not started yet — your first command starts it';
    if (!set.length && !(r.children || []).length) console.log(r.shared ? 'no profile attached — this session drives the machine\'s SHARED browser (per-session browsers are off here): never `close --all`.' : `no profile attached — this session browses its own managed browser (${ephWords}); its logins and tabs are kept for this conversation when it closes (a browser fenced to allowed domains keeps its tabs only).`);
    else if (eph && !r.shared) console.log(`this conversation's own managed browser: ${ephWords} (a bare verb lands on it only while nothing is attached)`);
    // lane browser-recipes (userR's pod): a status that says what this conversation LACKS also names the recipe — and,
    // where this machine has no display, that only this tool works here (her agent launched chromium by hand and died)
    if (!set.length && r.recipe) console.log(r.recipe);
    if (r.noDisplay) console.log(r.noDisplay);
    for (const a of set) {
      const l = r.leases.find((x) => x.profileId === a.profileId) || {};
      console.log(`${a.isDefault ? '*' : ' '} ${a.alias}  →  ${a.label} (${a.profileId})${l.mediated ? ' · shared (mediated: your own tabs only)' : ''} · attached ${ago(a.since)} · input: ${l.input || '?'} · browser: ${typeof V.browserCell === 'function' ? V.browserCell(l.browser) : (l.browser ? l.browser.state : 'not running')} · ${l.others ?? 0} other session(s)`);
    }
    for (const c of r.children || []) console.log(`  child ${c.handle} (own ephemeral browser, minted ${ago(c.since)})`);
    if (set.length > 1) console.log(`${set.length} attachments: every command needs --profile <handle> (or VIBESPACE_BROWSER) — a bare one is refused profile_required; the default is ${r.defaultProfile ? (set.find((a) => a.isDefault) || {}).alias || 'set' : 'NONE (pin one)'}.`);
    else if (set.length === 1) console.log(`a bare \`vibespace-browser <verb>\` lands on ${set[0].alias}.`);
    console.log(r.pin ? `pin: ${r.pin.label} (${r.pin.profileId}) — origin: ${r.pin.origin}, set ${when(r.pin.at)}` : 'pin: none (ephemeral by default; `vibespace-browser pin <handle>` changes that for this conversation)');
    return;
  }

  if (verb === 'pin') {
    const ref = args[1];
    if (!ref) { console.error('usage: vibespace-browser pin <handle|label|id> | --none'); process.exit(2); }
    const r = await call('POST', '/api/agent/browser/pin', { profile: ref === '--none' ? null : ref });
    console.log(r.pin ? `pinned this conversation to ${r.pin.label} (${r.pin.profileId}) — ${r.appliesFrom}` : `unpinned — ephemeral from the next launch`);
    if ((r.attachments || []).length > 1) console.log(`default is now ${r.defaultId ? (r.attachments.find((a) => a.profileId === r.defaultId) || {}).alias || r.defaultId : 'none'} of ${handlesLine(r.handles)}`);
    if (r.repoint && r.repoint.ok === false) console.log(`note: the running session's indirection was not re-pointed (${r.repoint.why}); the pin applies to this conversation's next spawn`);
    return;
  }

  if (verb === 'backend') {
    const name = args[1];
    if (!name || name.startsWith('--')) {
      const r = await call('GET', '/api/agent/browser/backend' + (handle ? '?profile=' + encodeURIComponent(handle) : ''), undefined, { soft: true });
      if (r._failed) { printRefusal(r); process.exit(1); }
      console.log(`profile: ${r.profile.label} (${r.profile.id}) · backend: ${r.chip}${r.switching ? ' (switching…)' : ''}`);
      for (const row of r.rows || []) {
        console.log(`${row.current ? '*' : (row.enabled ? '✓' : '✗')} ${row.id}  tier ${row.tier}  ${row.chip}${row.sourceLabel ? '  key: ' + row.sourceLabel : ''}`);
        if (!row.enabled && !row.current) console.log(`    cannot switch: ${row.reason}${row.action && row.action.openIntegration ? ` — ask the user to open ⚙ → Integrations → ${row.action.openIntegration}` : ''}`);
        const used = row.integrationId && r.seats && r.seats[row.integrationId] ? r.seats[row.integrationId].used : null;
        if (row.seats) console.log(`    seats: ${used != null ? used + ' used on this instance / ' : ''}${row.seats.text}`);
        if (row.fingerprint) console.log(`    note: ${row.fingerprint}`);
      }
      for (const b of r.blocked || []) console.log(`blocked claim (${b.by}, ${ago(b.at)}): ${b.text}`);
      if ((r.siteHints || []).length) console.log(`site hints: ${r.siteHints.map((h) => `${h.host} → ${h.backend || 'tier ' + h.tier} (by ${h.by})`).join(', ')}`);
      console.log('`vibespace-browser backend <name>` proposes a switch; it is the USER\'s act whenever others are attached or somebody drives this browser.');
      return;
    }
    const r = await call('POST', '/api/agent/browser/backend', { provider: name, profile: handle || undefined, confirmDowngrade: has('--confirm-downgrade') }, { soft: true });
    if (r._failed) { printRefusal(r); process.exit(1); }
    if (r.mode === 'proposal') { console.log(`proposed: ${r.text} — ${r.reason}${r.filed ? ' (filed to the user\'s "For you" inbox)' : ''}. The switch is the user\'s act; carry on with what you can meanwhile.`); return; }
    console.log(`switched ${r.from} → ${r.to} (${r.chip})${r.seedMinted ? ' · fingerprint seed minted' : ''}; ${(r.reopened || []).length} tab(s) re-opened at their last URL — your lease survived, re-orient before continuing.${r.fingerprint ? '\n  note: ' + r.fingerprint : ''}`);
    return;
  }

  if (verb === 'blocked') {
    const url = flag('--url');
    if (!url) { console.error('usage: vibespace-browser blocked --url <u> [--why <code>] [--evidence <text>] [--tier 2|3] [--remember]'); process.exit(2); }
    const r = await call('POST', '/api/agent/browser/blocked', { url, why: flag('--why'), evidence: flag('--evidence'), tier: flag('--tier'), profile: handle || undefined, remember: has('--remember') });
    console.log(`recorded your claim: ${r.text}. ${r.next}`);
    // lane browser-propose step 3: a tier-2 claim is ONE proposal — its card waits in the user's chat (never a second one)
    if (r.proposal) console.log(`proposal ${r.proposal.id}: ${r.proposal.state === 'unavailable' ? 'nothing can be offered here' : r.proposal.state}${r.duplicate ? ' (the same card — none added)' : ''}${r.rejected ? ' — the user rejected it' : ''}`);
    if (r.remembered && !r.remembered.error) console.log(`remembered: ${r.remembered.host} needs tier ${r.remembered.tier} (by agent)`);
    else if (r.remembered && r.remembered.error) console.log(`not remembered: ${r.remembered.error}`);
    if (r.hint) console.log(`site hint already on file: ${r.hint.host} → ${r.hint.backend || 'tier ' + r.hint.tier} (by ${r.hint.by})`);
    return;
  }

  // lane browser-resume B (§3.9): THIS conversation's own browser, started again with its kept tabs (same order, the same tab
  // on show) — or, when it runs, the tabs still waiting from a deliberate stop reopened as new tabs
  // lane browser-unresponsive: a HUNG browser's way out — the server admits it only while the keeper judges it hung
  if (verb === 'restart') {
    const ref = (args[1] && !args[1].startsWith('-') ? args[1] : '') || handle || '';
    const r = await call('POST', '/api/agent/browser/restart', ref ? { profile: ref } : {});
    console.log(r.note || 'restarted');
    return;
  }
  if (verb === 'resume') {
    const r = await call('POST', '/api/agent/browser/resume', handle ? { handle } : {});
    printKept(r);
    const rs = r.restored || null;
    if (rs) console.log(`resumed — ${rs.opened} tab(s) reopened${rs.current ? `; current: ${rs.current.title ? rs.current.title + ' — ' : ''}${rs.current.url}` : ''}${(rs.skipped || []).length ? `; not reopened: ${rs.skipped.map((x) => x.url + ' (' + x.why + ')').join(', ')}` : ''}. Re-read the page first (\`vibespace-browser snapshot -i\`).`);
    else if (r.resumed) console.log('resumed — the user had already reopened it; re-read the page first (`vibespace-browser snapshot -i`).');
    else console.log(r.already ? 'your browser runs — nothing was waiting to reopen' : 'resumed — your browser runs again (its logins are there; it had no web page to reopen)');
    return;
  }

  if (verb === 'watch') { console.log('the live view is the user\'s: they open "Agent browser" from your session card or the status bar, watch what you do, and can Take over. Taking over INTERRUPTS you: the command you had running there ends with browser_interrupted (on a shared, mediated profile its CDP calls in flight are cut and a script it was running is asked to stop — one awaiting a timer or a fetch may still finish), a notice in the conversation lists what was interrupted, and every `vibespace-browser` page verb you run is refused with browser_paused until they Hand back. The handback arrives as a message naming the current URL and what to re-run: re-read the page, then run it again. When a page needs a login or a captcha, tell the user which page needs them and stop.'); return; }

  console.error(`unknown verb "${verb}"\n` + USAGE);
  process.exit(2);
})().catch((e) => { console.error('vibespace-browser: ' + (e && e.message || e)); process.exit(1); });
