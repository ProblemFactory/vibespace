#!/usr/bin/env bash
# MANDATORY release gate (2.336.0, owner directive) — SPLIT INTO TWO TIERS
# (2026-09-07, B-4c5a): the single battery had grown to 11.5 min, which is
# longer than a person will wait and longer than GitHub's SSH idle timeout, so
# it was being skipped. Now:
#
#   BEFORE the push   `node scripts/ci.mjs --keep-going`  build + the FAST tier (~2 min; the one real
#                                                  vendor turn skipped by name, as at a cut — B-e381:
#                                                  nothing of ours bills a turn nobody typed; the turn
#                                                  is proven once a run by the HOSTED fast job, the part
#                                                  holding test-chat-e2e, with VIBESPACE_CI_OAT — ci.yml),
#                                                  ONCE per push (round 6) — for
#                                                  HEAD if it is being pushed,
#                                                  else the newest pushed sha
#   AFTER  the push   `node scripts/ci.mjs --heavy` DETACHED, in its own
#                                                  worktree at the pushed sha
#   NEXT   push       blocked if a heavy run went RED anywhere in this branch's
#                     history and no newer green has cleared it
#
# The global repo-guard pre-push (secret scan) CHAINS to this hook, so both
# always run — and this hook FIRST runs the repo's own scripts/secret-scan.mjs
# over what the push publishes (B-89da, see SECRET SCAN below). Installed into
# .git/hooks by scripts/install-git-hooks.mjs (npm postinstall). Escape hatches:
#   docs-only pushes (every PUBLISHED path is documentation the gate does not
#     READ — see is_code_path) skip the FAST tier; the heavy verdict is still
#     asked, because a red ancestor is red whether or not this push carries code
#   VIBESPACE_SKIP_CI=1 git push       — emergency bypass, use sparingly (the
#     tiers only: the secret scan still runs — GitHub refuses those shapes
#     whatever we skip)
set -uo pipefail
cd "$(git rev-parse --show-toplevel)"
# THE NODE THIS PUSH RUNS (B-e381): every step below — the secret scan, the heavy verdict, the tiers — needs one; none ⇒ refused
# by name before anything (never a «could not read» or a GATE RED about the tree)
command -v node >/dev/null 2>&1 || { echo "[ci] REFUSED — no node on this push's PATH: the gate cannot run, nothing was judged" >&2; exit 1; }

# read ref updates (also keeps stdin drained for chained callers)
mapfile -t REFS || true

# docs-only fast path: list every path this push PUBLISHES; if none of them is
# a code path, skip the fast tier.
#
# "NOTHING CHANGED" AND "WE COULD NOT TELL" ARE NOT THE SAME ANSWER (round 4).
# only_docs was inferred from an EMPTY file list, and two different things
# produce one:
#   (a) A NEW BRANCH (remote sha = zeros) was approximated by its TIP COMMIT
#       only, so [code commit][docs commit] pushed as a new branch printed
#       "docs-only push — gate skipped" with ZERO gate calls. This branch's own
#       history has exactly that shape, so it is not a hypothetical. A new
#       branch publishes its whole unpublished range, so that is what we ask
#       about: every commit reachable from the tip that no remote-tracking ref
#       already has.
#   (b) `git diff` / `git log` FAILING — an unresolvable range (a remote sha we
#       never fetched), a broken repository — also yields an empty list. A
#       gate that reads its own inability to answer as "no code changed" is the
#       §no-silent-failures rule in its purest form, so a non-zero git status
#       means NOT docs-only, said out loud.

# ── IS THIS PATH A CODE PATH? ─────────────────────────────────────────────
# A .md / docs/** PATH THAT THE GATE READS IS A CODE PATH (round 5). The "not
# code" set used to be hand-written as `docs/*|*.md`, which is a statement
# about how a path LOOKS — and several of the paths that look like
# documentation are GATE INPUTS that a suite in the tier table reads and
# asserts on, so a "docs-only" push could ship a tree the gate would have
# refused. Measured, all three shapes reproduced end to end:
#   · scripts/test-codex-effort-meta.mjs (FAST) source-pins CLAUDE.md,
#     docs/kb-file-structure.md, docs/kb-features.md, docs/kb-bugfix-invariants.md
#     and CHANGELOG.md — editing ONLY docs/kb-file-structure.md gave
#     "FAILED (2 of 108)" (renumbering its version marker: the site loses the
#     mark AND names the number master already took), and THIS BRANCH'S OWN
#     TIP is exactly that push shape;
#   · test-plugin-loader / -trust / -security (FAST) cpSync + parse
#     docs/examples/hello-plugin — an unparseable version there gave
#     test-plugin-loader "16 FAILED (32 passed)" and made test-plugin-trust
#     THROW (test-plugin-security reads the same tree and survived that one
#     edit — "reads it" is the rule, not "this edit broke it");
#   · docs/agent/*-manual.md is RUNTIME PRODUCT DATA — src/agent-routes.js
#     serves it to every agent CLI (`GET /api/agent/docs/:topic`,
#     AGENT_DOC_TOPICS) out of the running checkout, and test-agent-msg pins
#     it: deleting docs/agent/msg-manual.md gave "1 FAILED (40 passed)".
# So the list below is NOT trusted: scripts/test-ci-gate.mjs §4 DERIVES the
# real set from the tier table's own suite sources (+ AGENT_DOC_TOPICS), runs
# THIS function over it, and goes red naming any path it still calls
# documentation — with the pre-round-5 pattern as the negative control. Add a
# doc read to a gated suite and the gate tells you to add it here.
# Ordinary documentation still skips: README.md, docs/getting-started.md,
# docs/terminal.md, docs/screenshots/**, … nothing in the tier table reads them.
is_code_path() {
  case "$1" in
    # (a) GATE INPUTS that merely LOOK like documentation.
    CLAUDE.md|CHANGELOG.md|docs/kb-*.md|docs/design-*.md|docs/agent/*|docs/examples/*) return 0 ;;
    # the agent-manual DIRECTORY itself: test-architecture §52b lists docs/agent (every manual + the web-access
    # skill text is scanned for the hidden browser CLI's name — a new file there changes the census) (2.369.168)
    docs/agent) return 0 ;;
    # the user's changelogs in three languages + the engineering log: test-changelog-style lints them, checks their parity
    # and that every user entry has its engineering section; test-codex-effort-meta reads release topics off the log
    CHANGELOG.zh.md|CHANGELOG.ja.md|docs/changelog-engineering.md) return 0 ;;
    docs/README.md|docs/plugins.md|docs/settings.md|docs/keyboard-shortcuts.md) return 0 ;;
    # the desktop copy hint links its "## HTTPS for seamless copy" section and test-xpra-client reads it (2.369.166)
    docs/getting-started.md) return 0 ;;
    # the r4 integrations mockups: test-oauth-field-parity reads the Edit dialog's button order off one (2.369.165)
    docs/mockups/*) return 0 ;;
    # the Slack relay page ships as a static file: test-slack-relay drives it and holds its rule to slack-manifest.js (design 018)
    docs/slack-relay|docs/slack-relay/*) return 0 ;;
    # the communication-panel mockup (a page + its css + a module script): test-frame-host-viewers previews it in the code
    # editor with its folder (lane frame-host-preview — the repo's own pages are the preview's measure)
    docs/design-mockups/communication-panel|docs/design-mockups/communication-panel/*) return 0 ;;
    # the relay login plugin's README: test-frps-plugin holds it to the plugin (the vouch REFUTED, the canary) — lane
    # frp-token-proof r3
    tools/frps-login-plugin/README.md) return 0 ;;
    # docs OUTSIDE docs/ that suites read (lane frp-token-proof r3c — test-ci-gate-push derives them by their whole path,
    # a directory read included): test-helm-render + test-integration-registry hold deploy/README.md (its values, its
    # generated redirect block); every fixture is a suite's input — test-doc-wheel reads doc-wheel/ whole, test-doc-window
    # (-width) read doc-print/lane-brief.md + doc-wheel/31-, 32-, test-record-shape's census walks the directory
    deploy/README.md|scripts/fixtures/*) return 0 ;;
    # (b) documentation: nothing the gate reads.
    docs/*|*.md) return 1 ;;
  esac
  return 0
}

only_docs=1
PUSHED_SHAS=()
PUSHED_REFS=()
PUSHED_RANGES=()   # what each pushed sha PUBLISHES, for the impact-scoped heavy tier (2026-09-15)
for line in "${REFS[@]:-}"; do
  [ -z "$line" ] && continue
  local_sha=$(echo "$line" | awk '{print $2}')
  remote_sha=$(echo "$line" | awk '{print $4}')
  [ "$local_sha" = "0000000000000000000000000000000000000000" ] && continue  # deletion
  PUSHED_SHAS+=("$local_sha")
  PUSHED_REFS+=("$(echo "$line" | awk '{print $1}')")
  if [ "$remote_sha" = "0000000000000000000000000000000000000000" ]; then
    range_cmd=(git log --name-only --format= "$local_sha" --not --remotes)   # new branch: the WHOLE unpublished range
    # A FIXED SPELLING FOR THE DETACHED CHILD (2026-09-16, verifier). The lone
    # sha means "everything <sha> has that no remote-tracking ref has" — true
    # HERE, before the push, and false a moment later: the child resolves it
    # with `git log <sha> --not --remotes` after the pack transfer may already
    # have updated refs/remotes/origin/<branch>, and then the range is EMPTY
    # and the affected tier runs the two `always` rows for a push full of
    # code. Reproduced on a stub (3 trials): changedFiles(tip) = 2 files
    # before the push, [] after it, every time. So the boundary is resolved
    # now: the merge base of the tip and every remote-tracking ref (`git
    # merge-base A B C…` = the base of A and a hypothetical merge of the rest,
    # i.e. the nearest point where this line meets ANY published ref), spelled
    # `<boundary>..<sha>` — a diff, immune to the ref update. No remote-tracking
    # ref at all, or no common ancestor (an orphan branch): the lone sha stays.
    boundary=""
    remote_tips="$(git for-each-ref --format='%(objectname)' refs/remotes/ 2>/dev/null | tr '\n' ' ')"
    if [ -n "$remote_tips" ]; then boundary="$(git merge-base "$local_sha" $remote_tips 2>/dev/null || true)"; fi
    if [ -n "$boundary" ]; then PUSHED_RANGES+=("$boundary..$local_sha"); else PUSHED_RANGES+=("$local_sha"); fi
  else
    range_cmd=(git diff --name-only "$remote_sha..$local_sha")
    PUSHED_RANGES+=("$remote_sha..$local_sha")
  fi
  files=$("${range_cmd[@]}" 2>/dev/null); rc=$?
  if [ "$rc" != "0" ]; then
    echo "[ci] could not list the paths this push publishes (\`${range_cmd[*]}\` exited $rc: $("${range_cmd[@]}" 2>&1 >/dev/null | head -1)) — NOT treating it as docs-only" >&2
    only_docs=0
    files=""
  fi
  while IFS= read -r f; do
    [ -z "$f" ] && continue
    if is_code_path "$f"; then only_docs=0; fi
  done <<< "$files"
done

# The ref a sha arrived on, for the messages below (a sha8 alone does not tell
# anybody which branch they are pushing). Several refs can name one sha; the
# first is enough, and "a ref" is the honest answer when the lists do not line
# up rather than printing an empty word.
ref_for_sha() {
  local j=0
  for s in "${PUSHED_SHAS[@]:-}"; do
    [ "$s" = "$1" ] && { echo "${PUSHED_REFS[$j]:-a ref}"; return 0; }
    j=$((j + 1))
  done
  echo "a ref"
}

# The range a sha arrived with — the same two spellings ci.mjs's --range
# reads: `<remote>..<local>` for an existing ref, `<boundary>..<local>` for a
# new branch (its merge base with the remote-tracking refs, resolved BEFORE
# the push — see above), and the lone `<local>` only when nothing anchors it.
# Empty when the lists do not line up, and an empty range launches the FULL
# tier (ci.mjs cannot scope what it was not told).
range_for_sha() {
  local j=0
  for s in "${PUSHED_SHAS[@]:-}"; do
    [ "$s" = "$1" ] && { echo "${PUSHED_RANGES[$j]:-}"; return 0; }
    j=$((j + 1))
  done
  echo ""
}

# ── SECRET SCAN (B-89da, 2026-10-13) ─────────────────────────────────────
# GitHub push protection refused 2.369.263's first cut (GH013) for a literal
# Slack-token fixture that every local scan had MATCHED and then dropped: an
# allow row matched ANOTHER part of the same line. scripts/secret-scan.mjs is
# THE ONE TABLE — its partner rows are a superset of GitHub's partner patterns
# and no allow row silences them — and `--range` reads what each ref
# publishes: every commit's added lines + the full text of every file the
# range touches, so a token added and removed again inside one push is still
# refused (GitHub reads every commit). It runs BEFORE VIBESPACE_SKIP_CI is
# honoured: GitHub refuses the push whether or not the gate was skipped, and
# the scan costs a second. The same file is what scripts/ci.mjs's fast tier
# and the Actions secret-scan workflow run (`--tree`); test-secret-scan holds
# the three callers to it.
[ -f scripts/secret-scan.mjs ] || { echo "[ci] scripts/secret-scan.mjs is missing from this checkout — nothing can say what this push publishes is clean; push blocked" >&2; exit 1; }
for sha in "${PUSHED_SHAS[@]:-}"; do
  [ -z "$sha" ] && continue
  node scripts/secret-scan.mjs --range="$(range_for_sha "$sha")" --quiet
  scan_rc=$?
  [ "$scan_rc" = "0" ] && continue
  if [ "$scan_rc" = "1" ]; then
    echo "[ci] SECRET SCAN RED — the push of $(ref_for_sha "$sha") is blocked: GitHub push protection refuses these shapes (GH013) and no allow row passes them — build token shapes at runtime by concatenation, split inside the vendor prefix (['xo', 'xb-…'].join(''))" >&2
  else
    echo "[ci] the secret scan could not read what $(ref_for_sha "$sha") publishes (exit $scan_rc) — that is not a clean verdict; push blocked" >&2
  fi
  exit 1
done

[ "${VIBESPACE_SKIP_CI:-}" = "1" ] && { echo "[ci] VIBESPACE_SKIP_CI=1 — gate bypassed" >&2; exit 0; }


# ── HEAVY-TIER VERDICT FIRST (2026-09-07) ─────────────────────────────────
# A heavy run that went RED on a commit that is an ANCESTOR of what we are
# about to push means the last push shipped a regression the fast tier cannot
# see. Blocking here — before spending two minutes on the fast tier — is the
# whole point of letting the heavy tier run after the push: the failure is
# still reported, and it is reported before more code rides on top of it.
# `--check-heavy` names the red sha and its failing suites, and exits 0 when a
# newer green run has cleared it.
#
# ASK IT OF THE REFS BEING PUSHED, NOT OF HEAD (2026-09-07 round 2). Without
# --head the verdict is about the checked-out commit, so `git push origin main`
# from a different branch shipped a commit riding on a heavy-red ancestor with
# no block and no message — the refs are right here in PUSHED_SHAS, which is
# the same list the launch loop below already uses.
# `"${PUSHED_SHAS[@]:-}"` is the same idiom as the launch loop below: `set -u`
# treats a bare empty-array expansion as unbound on bash < 4.4.
checked_any=0
for sha in "${PUSHED_SHAS[@]:-}"; do
  [ -z "$sha" ] && continue
  node scripts/ci.mjs --check-heavy --head="$sha" >&2 || exit 1
  checked_any=1
done
if [ "$checked_any" = "0" ]; then
  node scripts/ci.mjs --check-heavy >&2 || exit 1
fi

# DOCS-ONLY EXITS *HERE*, NOT ABOVE (round 4). A red heavy ancestor is red
# whether or not this particular push carries code, and the block is the thing
# that stops more work being stacked on a known-broken commit — so the verdict
# is asked first and only the FAST tier (and the heavy launch, which has
# nothing new to test) is what a docs-only push saves.
if [ "$only_docs" = "1" ] && [ "${#REFS[@]}" -gt 0 ]; then
  echo "[ci] docs-only push — fast tier skipped" >&2
  exit 0
fi

# ── THE TIERS' OWN ENV (B-e381 part 2, 主开发 r962, 2026-11-21) ──────────────
# A tier this hook launches ran in WHATEVER env the pushing shell had: a full tier launched from an interactive shell
# (PATH = git's exec-path + the production checkout's data/bin + …) showed 26 mount-guard refusals and 183 failed lines for
# a sha the hosted runner and the integrator's lane env ran green — such a run is no verdict. So every tier it launches
# (the fast calls and the full launcher below) runs under `env -i` with an ALLOWLIST, as the tree's service env does for a
# long-lived child (src/agent-env.js serviceEnv):
#  - the search path is a PRIVATE folder holding only the node this push resolves first (its real file) and its npm / npx,
#    then the system folders — never that node's own folder (an npm -g bin: an agent CLI lives there), never a checkout's
#    data/bin, never the agent programs' ~/.local/bin. The folder is on local disk, this user's own (0700), ONE per node
#    (keyed by its real path), made whole and moved in at once, never relinked — so the detached full tier keeps it after
#    this hook exits and a second push with another node never swaps it. The tree pins no node: the pushing shell's, said.
#    VIBESPACE_HOOK_NODE_DIR moves the folder's root — the test seam: the suites that run this hook point it into their scratch.
#    A node that does not run under this env (a version manager's shim) is refused at the banner, by name; its version call
#    there is bounded (timeout -k 2 10 — coreutils, on the tier path; a tier path without it is refused by THAT name).
#  - the names kept are the service env's (HOME, LANG, LC_*, TMPDIR, XDG_RUNTIME_DIR, TERM) + USER / LOGNAME + TZ (a push
#    that mirrors the hosted runner's zone keeps it) + VS_CHROME + the tier's own knobs BY NAME (never a token: the real
#    turn's VIBESPACE_CI_OAT stays out, and VIBESPACE_CI_RUN, ci.mjs's own); the switches are the cut scripts': VS_NO_REAL_CLI=1 (the one real vendor turn is
#    skipped by name, as at a cut) and VIBESPACE_SKIP_AGENT_HOOKS=1. A suite that looks for a real agent program (claude, codex,
#    agent-browser) finds none on this path and takes its NAMED skip in these tiers; those rows are proven by the hosted run and
#    the integrator's runs.
# Nothing here reads or sources a person's shell files. (No node on the push's PATH is refused at the hook's top.)
tier_node="$(command -v node 2>/dev/null || true)"
tier_real="$(readlink -f "$tier_node" 2>/dev/null || true)"; [ -n "$tier_real" ] || tier_real="$tier_node"
tier_root="${VIBESPACE_HOOK_NODE_DIR:-/var/tmp/vs-tier-node-$(id -u)}"   # local disk (never a checkout's git dir: it may sit on a guarded mount), this user's own
# the root: a real folder (never a link — `-O` would follow it), this user's own, writable by nobody else
if [ -L "$tier_root" ] || ! mkdir -p -m 0700 "$tier_root" 2>/dev/null || [ -L "$tier_root" ] || [ ! -O "$tier_root" ] || (( (8#$(stat -c %a "$tier_root" 2>/dev/null || echo 777) & 8#022) != 0 )); then
  echo "[ci] REFUSED — the tiers' private node folder $tier_root is a link, writable by others or not this user's own: nothing was judged — remove it (or set VIBESPACE_HOOK_NODE_DIR to a folder of your own) and push again" >&2; exit 1
fi
# a node's folder is trusted only when it holds EXACTLY its links — node → this push's node, npm / npx → beside it — and nothing else
tier_holds() {
  local d="$1" e
  [ -d "$d" ] && [ ! -L "$d" ] && [ "$(readlink "$d/node" 2>/dev/null)" = "$tier_real" ] || return 1
  for e in "$d"/* "$d"/.[!.]*; do
    [ -e "$e" ] || [ -L "$e" ] || continue
    case "${e##*/}" in
      node) ;;
      npm|npx) [ "$(readlink "$e" 2>/dev/null)" = "$(dirname "$tier_real")/${e##*/}" ] || return 1 ;;
      *) return 1 ;;
    esac
  done
  for e in npm npx; do   # one that sits beside node NOW and is missing here (a folder made before it came) is not trusted
    if [ -e "$(dirname "$tier_real")/$e" ] && [ ! -L "$d/$e" ]; then return 1; fi
  done
}
tier_bin="$tier_root/$(printf '%s' "$tier_real" | cksum | cut -d' ' -f1)"   # ONE folder per node: two pushes with two nodes never share one
if ! tier_holds "$tier_bin"; then
  tier_new="$(mktemp -d "$tier_root/.new.XXXXXX" 2>/dev/null)" || { echo "[ci] REFUSED — the tiers' private node folder could not be made in $tier_root: nothing was judged" >&2; exit 1; }
  ln -s "$tier_real" "$tier_new/node"
  for t in npm npx; do [ -e "$(dirname "$tier_real")/$t" ] && ln -s "$(dirname "$tier_real")/$t" "$tier_new/$t"; done
  mv -T "$tier_new" "$tier_bin" 2>/dev/null || rm -rf "$tier_new"   # made whole, then moved in at once — a racing push's own stays
fi
tier_holds "$tier_bin" || { echo "[ci] REFUSED — $tier_bin does not hold exactly this push's node ($tier_real) and its npm / npx: nothing was judged — remove $tier_bin and push again" >&2; exit 1; }
tier_path="$tier_bin:/usr/local/bin:/usr/bin:/bin"
tier_env=(env -i "PATH=$tier_path" VS_NO_REAL_CLI=1 VIBESPACE_SKIP_AGENT_HOOKS=1)
for v in HOME USER LOGNAME LANG TMPDIR XDG_RUNTIME_DIR TERM TZ VS_CHROME VIBESPACE_CI_FAST_LANES VIBESPACE_CI_LANES VIBESPACE_CI_HEAVY_LOCK VIBESPACE_CI_LANE_ROOT VIBESPACE_CI_REAP_PROCFS VIBESPACE_CI_REAPER_LOCK VIBESPACE_CI_DIR_SWEEP VIBESPACE_CI_SCRATCH_ROOTS VIBESPACE_CI_REMOTE_RUN VIBESPACE_CI_MODEL; do
  [ -n "${!v:-}" ] && tier_env+=("$v=${!v}")
done
for v in $(compgen -e); do
  case "$v" in LC_*) tier_env+=("$v=${!v}") ;; esac
done
(PATH="$tier_path"; type -P timeout) >/dev/null 2>&1 || { echo "[ci] REFUSED — timeout (coreutils: the bound on the version call) is not on the tiers' path ($tier_path): nothing was judged — install coreutils and push again" >&2; exit 1; }
tier_ver="$(env -i "PATH=$tier_path" HOME="${HOME:-/}" timeout -k 2 10 "$tier_bin/node" --version 2>/dev/null || true)"   # bounded: timeout is coreutils, on the tier path; -k: a shim deaf to TERM is KILLed
case "$tier_ver" in v[0-9]*) ;; *) echo "[ci] REFUSED — the node this push resolves ($tier_node → $tier_real) does not run under the tiers' own env (a version manager's shim needs its manager on PATH; its --version has 10 s): point PATH at a real node and push again — nothing was judged" >&2; exit 1 ;; esac
echo "[ci] the tiers run in the hook's own env: node $tier_real ($tier_ver) · PATH $tier_path${TZ:+ · TZ=$TZ} (B-e381: no shell additions)" >&2

# GREEN MARKER (2.369.51): scripts/ci.mjs writes .git/ci-green = "<sha> <epoch-ms>"
# after a green run on a CLEAN tree. If it names HEAD and is < 60 min old the gate
# already passed on this exact tree — do not re-run it inside the SSH session
# (GitHub closes an idle connection before a long gate finishes).
#
# THE SHORTCUT IS ABOUT THE COMMITS BEING PUBLISHED, NOT THE ONE CHECKED OUT
# (round 4 — the same defect round 2 fixed for `--check-heavy --head`). Keyed
# to HEAD alone, `git push origin some-other-branch` skipped the WHOLE fast
# tier for a never-gated commit and printed "fast gate already GREEN on this
# exact tree" while doing it. Reproduced: standing on main with a fresh marker,
# pushing refs/heads/feature whose tip adds src/broken.js ⇒ no fast run at all.
# So every pushed sha must BE the marker's sha, and an empty PUSHED_SHAS never
# takes the shortcut (nothing was proven about a list we do not have).
skip_fast=0
marker="$(git rev-parse --git-dir)/ci-green"
if [ -f "$marker" ]; then
  m_sha=$(awk '{print $1}' "$marker"); m_ts=$(awk '{print $2}' "$marker"); now_ms=$(( $(date +%s) * 1000 ))
  # U2 L4 (主开发 r5567): a run that used PLACED lines writes a third field «placed:<lines>:<suite>=<n>,…» — the shortcut says it by
  # name and count, never «GREEN»; a third field of any other shape is a marker this hook cannot read: no shortcut
  m_pl=$(awk '{print $3}' "$marker"); m_pl_ok=0
  case "$m_pl" in '') m_pl_ok=1 ;; placed:[0-9]*:?*) m_pl_ok=1 ;; esac
  pushed_all_marked=1; pushed_n=0
  for sha in "${PUSHED_SHAS[@]:-}"; do
    [ -z "$sha" ] && continue
    pushed_n=$((pushed_n + 1))
    [ "$sha" = "$m_sha" ] || pushed_all_marked=0
  done
  [ "$pushed_n" = "0" ] && pushed_all_marked=0
  if [ "$m_sha" = "$(git rev-parse HEAD)" ] && [ "$pushed_all_marked" = "1" ] && [ "$m_pl_ok" = "1" ] && [ -z "$(git status --porcelain)" ] && [ $(( now_ms - ${m_ts:-0} )) -lt 3600000 ]; then
    if [ -n "$m_pl" ]; then
      m_pl_rest="${m_pl#placed:}"; m_pl_names="${m_pl_rest#*:}"; m_pl_names="${m_pl_names//=/ (}"; m_pl_names="${m_pl_names//,/), })"
      echo "[ci] fast gate PLACED on this exact tree ($(echo "$m_sha" | cut -c1-8), $(( (now_ms - m_ts) / 60000 )) min ago): ${m_pl_rest%%:*} placed line(s) in ${m_pl_names} — NOT a green: each placed line is still red, owed by its lane (scripts/fixtures/placed-reds.json) — skipping the in-hook run" >&2
    else
      echo "[ci] fast gate already GREEN on this exact tree ($(echo "$m_sha" | cut -c1-8), $(( (now_ms - m_ts) / 60000 )) min ago) — skipping the in-hook run" >&2
    fi
    skip_fast=1
  fi
fi
# ── AND IT GATES THE COMMITS BEING PUBLISHED, NOT WHATEVER IS CHECKED OUT ──
# INVARIANT ⑭ AGAIN, IN THE ONE PLACE IT HAD NOT REACHED (round 5). Round 2
# fixed the heavy VERDICT (`--check-heavy --head=<sha>`) and round 4 fixed the
# green-marker SHORTCUT; the fast RUN itself still executed `node
# scripts/ci.mjs` in the working tree with no idea what PUSHED_SHAS held.
# Reproduced through the real hook: standing on `main`, pushing
# refs/heads/feature whose tip adds src/broken.js ⇒ the fast tier ran in a tree
# that did NOT contain src/broken.js (`sawBroken=false`), printed ALL GREEN and
# let the push through — an ungated commit shipped under a green sentence about
# a tree nobody is publishing.
#
# WE RUN IT AT THE SHA INSTEAD OF REFUSING THE SHAPE. Refusing would be cheaper
# and is the other honest answer, but `git push origin <branch>` from somewhere
# else works today, and the only bypass we ship is VIBESPACE_SKIP_CI=1 — which
# skips the heavy VERDICT too. Turning a working push into "use the total
# bypass" is exactly the "a gate people route around is not a gate" failure the
# split exists to remove. So: the ordinary push (every pushed sha IS HEAD) runs
# in place and costs exactly what it costs today — 86-122 s measured, the whole
# ≤2 min budget untouched — and only the rare mismatch pays for an isolated
# worktree at the commit it is actually publishing (~+3 s of `git worktree
# add`, then the same tier). Distinct shas only, so a multi-ref push of one
# commit still runs once.
#
# …AND EXACTLY ONE FAST SUBJECT PER PUSH (round 6). Round 5 made that a LOOP
# over the distinct pushed shas, which is the whole ≤2 min budget multiplied by
# the number of refs — inside the live SSH session, and each run spends a real
# billed haiku turn (test-chat-e2e). Reproduced with this hook in a throwaway
# repo: `git push` of three refs ⇒ THREE fast runs (in place for HEAD, isolated
# for the other two); `git push --all` here would be 315 branches and
# `git push --tags` 41 tags. So the hook picks ONE subject and says what it did
# not cover: HEAD when HEAD is among the pushed shas (the ordinary push, run in
# place, unchanged), otherwise the NEWEST of them. The others are not
# ungated — `--heavy-launch` below still runs for every pushed sha, and that
# tier is where a multi-ref push gets its per-commit coverage. Spending N×2 min
# and N billed turns in the hook is the "a gate people route around" failure
# again, one budget larger.
head_sha="$(git rev-parse HEAD 2>/dev/null || true)"
if [ "$skip_fast" = "0" ]; then
  # every distinct sha this push publishes, in push order
  distinct=""
  for sha in "${PUSHED_SHAS[@]:-}"; do
    [ -z "$sha" ] && continue
    case " $distinct " in *" $sha "*) continue ;; esac
    distinct="$distinct $sha"
  done
  # THE ONE SUBJECT. HEAD if it is being pushed (that is the ordinary push and
  # it runs in place); otherwise the newest by commit date, falling back to the
  # first pushed ref when git cannot sort them (an annotated tag's own object,
  # a repo state rev-list refuses) — and only when the answer is one of the
  # shas we are actually publishing, because naming a peeled commit nobody
  # asked about would be a verdict about a sha that is not in this push.
  subject=""
  for sha in $distinct; do [ "$sha" = "$head_sha" ] && subject="$sha"; done
  if [ -z "$subject" ] && [ -n "$distinct" ]; then
    newest="$(git rev-list --no-walk=sorted $distinct 2>/dev/null | head -1)"
    case " $distinct " in *" $newest "*) subject="$newest" ;; esac
    [ -z "$subject" ] && subject="$(echo $distinct | awk '{print $1}')"
  fi
  # KEEP-GOING (B-6e71, 2026-11-21): every fast call below runs the WHOLE tier and names EVERY red at its end — a first
  # red no longer hides the ones behind it (a release cut learned its reds one push at a time). The verdict is the
  # same: any red is exit 1 = GATE RED, and only a whole, clean, in-place, all-green run writes the green marker. The
  # price: a red push runs the rest of the tier before it refuses — each red retried once, a hung suite to its own
  # budget — longer than a green tier, never a pass. The installed hook is shared by every worktree: a checkout whose
  # scripts/ci.mjs predates the flag would refuse it (exit 2, a false GATE RED), so it is passed only when that file
  # knows it, and an older checkout runs fail-fast, said.
  kg=""
  if grep -qF "'keep-going'" scripts/ci.mjs 2>/dev/null; then kg="--keep-going"
  else echo "[ci] this checkout's scripts/ci.mjs has no --keep-going (an older tree) — its fast tier stops at the first red" >&2; fi
  # `fast_subjects` is the guard: it is what makes this ONE run instead of one
  # per pushed sha. (test-ci-gate's negative control sets it back to
  # "$distinct" — that is the round-5 hook, verbatim in behaviour.)
  fast_subjects="$subject"
  ran_fast=0
  for sha in $fast_subjects; do
    ref="$(ref_for_sha "$sha")"
    if [ "$sha" = "$head_sha" ]; then
      echo "[ci] release gate — fast tier (VIBESPACE_SKIP_CI=1 to bypass in an emergency)…" >&2
      "${tier_env[@]}" node scripts/ci.mjs $kg || { echo "[ci] GATE RED — push blocked" >&2; exit 1; }
    else
      echo "[ci] $ref tips at $(echo "$sha" | cut -c1-8), which is NOT the commit you have checked out — the fast tier runs in an ISOLATED worktree at that commit (a verdict about the tree you have is not a verdict about the tree you are publishing)…" >&2
      "${tier_env[@]}" node scripts/ci.mjs --isolate $kg --sha="$sha" || { echo "[ci] GATE RED — push blocked" >&2; exit 1; }
    fi
    ran_fast=1
  done
  # SAY WHAT THE FAST TIER DID NOT LOOK AT. Silence here would be the same
  # class of defect as the one above: a push that got one green tier reading as
  # if every ref in it had been gated.
  others=""; others_n=0
  for sha in $distinct; do
    case " $fast_subjects " in *" $sha "*) continue ;; esac
    others="$others $(echo "$sha" | cut -c1-8)"; others_n=$((others_n + 1))
  done
  if [ "$others_n" != "0" ]; then
    echo "[ci] this push publishes $others_n other commit(s) ($(echo $others)) — the fast tier runs ONCE per push (it costs ~2 min; its one real vendor turn is skipped by name — B-e381), so those are covered by the HEAVY tier only, which is launched for every pushed sha below." >&2
  fi
  # No pushed shas at all (a deletion-only push, or a caller that fed us
  # nothing): gate the tree we have, exactly as before. Nothing is claimed
  # about a list we do not have.
  if [ "$ran_fast" = "0" ]; then
    echo "[ci] release gate — fast tier (VIBESPACE_SKIP_CI=1 to bypass in an emergency)…" >&2
    "${tier_env[@]}" node scripts/ci.mjs $kg || { echo "[ci] GATE RED — push blocked" >&2; exit 1; }
  fi
fi

# ── LAUNCH THE HEAVY TIER, DETACHED ───────────────────────────────────────
# The fast tier is green, so the push is going ahead; everything the fast tier
# cannot afford runs now, in the background, against the sha being pushed (its
# own git worktree — the working tree keeps moving under a 10-minute run, and a
# marker must describe the commit it names). `--heavy-launch` does the
# detaching itself (no setsid/nohup dependency) and, crucially, hands the child
# a SANITIZED git environment: this hook process exports GIT_DIR/GIT_INDEX_FILE
# and the heavy suites run `git worktree add`.
#
# THE LAUNCHER DECIDES WHAT TO RUN (2026-09-15): with the pushed range it runs
# the AFFECTED tier — only the suites whose inputs the range touches, plus the
# `always` boot/restore smokes — unless the newest FULL green marker is older
# than 24 h, in which case the FULL tier. No cron; `npm run ci:status` says
# which comes next. A red of either scope blocks the next push exactly alike;
# an affected green clears a red only for the suites it actually ran.
for sha in "${PUSHED_SHAS[@]:-}"; do
  [ -z "$sha" ] && continue
  "${tier_env[@]}" node scripts/ci.mjs --heavy-launch "$sha" --range="$(range_for_sha "$sha")" >&2 || true
done
exit 0
