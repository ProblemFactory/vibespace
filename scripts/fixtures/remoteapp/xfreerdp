#!/bin/sh
# A FAKE `xfreerdp` (lane remoteapp-r1a; POSIX sh since lane remoteapp-fake-node-path — it was `#!/usr/bin/env node`, and the
# hosted runner's sanitized spawn PATH holds no node: master .288 read "/usr/bin/env: 'node': No such file or directory" as
# the client's version ⇒ rdp_client_unknown) — stands in for FreeRDP 3's X client in the RemoteApp suites. It answers
# `/version` + `/buildconfig` like FreeRDP 3.32.1 (VS_FAKE_RDP_VERSION, VS_FAKE_RDP_H264=ON change them), and a launch the
# way the REAL one was measured to behave (src/remoteapp.js header — xfreerdp 3.32.1 against a FreeRDP shadow server on a
# private Xvfb):
#   • `/from-stdin` with no `/d:` prompts "Domain:" and reads the FIRST stdin line as the domain, then the password line;
#     EOF before the password ⇒ ERRCONNECT_CONNECT_CANCELLED, exit 145
#   • a pinned `/cert:…fingerprint:sha256:<fp>` that differs from VS_FAKE_RDP_SERVER_FP ⇒ "Host key verification failed",
#     ERRCONNECT_TLS_CONNECT_FAILED, exit 143 — UNLESS a certificate is stored for that host:port under the client's config
#     dir ($XDG_CONFIG_HOME, else $HOME/.config)/freerdp/server/ (then it connects: the measured hole)
#   • a password whose sha256 is not VS_FAKE_RDP_PASSWORD_SHA256 ⇒ ERRCONNECT_LOGON_FAILURE, exit 134
#   • nothing listening on `/v:` ⇒ ERRCONNECT_CONNECT_FAILED, exit 141
# Then it connects to `/v:`, says one line and reads the machine's one-line answer (the suites' stand-in for the machine's
# 3389 behind the forward), prints a RAIL-looking line and — unless VS_FAKE_RDP_WINDOW=0 — opens ONE X top-level on $DISPLAY
# (xmessage, instance name `xfreerdp`), and runs until SIGTERM (exit 145) or until the machine's side closes (exit 131).
# VS_FAKE_RDP_RAIL=<RAIL_EXEC_E_…> prints FreeRDP's RAIL exec error line instead and exits 1 (that row's wording is from
# FreeRDP's xf_rail.c, not measured). What it saw goes to VS_FAKE_RDP_RECORD as JSON lines — the stdin password as its
# sha256 + length only, never its bytes.
# THE FIRST CONNECTION (lane remoteapp-r1b — `/auth-only`, measured on the same client + shadow server): `/auth-only` with plain
# `/from-stdin` never connects (ERRCONNECT_PRE_CONNECT_FAILED, exit 136); `/cert:tofu` stores VS_FAKE_RDP_SERVER_PEM's bytes in
# <config dir>/freerdp/server/<host>_<port>.pem (the suite passes its sha256 as VS_FAKE_RDP_SERVER_FP — no certificate is parsed
# here) after the measured warnings; a good sign-in exits 0 after "Authentication only, exit status 1" + CONNECT_CANCELLED, a
# wrong password exits 134 with the certificate stored all the same. VS_FAKE_RDP_LEAK=1 prints the password in a `password=`
# line once connected (the suites' log-scrub control).
# Needs sh + sed, sort, tr, wc, date, mktemp, mkfifo, rm, sha256sum (or shasum) and perl: the ONE socket is perl-base's
# IO::Socket::INET (Debian/Ubuntu Essential) — POSIX sh cannot open one, and OpenBSD nc never exits when the far side
# closes while its stdin is held open (measured), so the link-lost exit would hang. The password stays in this shell:
# builtins only (printf, read), never an argv or an exported variable; the socket helper is told only whether it was right.

case ${1-} in
  /version) printf 'This is FreeRDP version %s (fake)\n' "${VS_FAKE_RDP_VERSION:-3.32.1}"; exit 0 ;;
  /buildconfig) if [ "${VS_FAKE_RDP_H264-}" = ON ]; then h=ON; else h=OFF; fi
    printf 'Build configuration: BUILD_TESTING=OFF WITH_FFMPEG=OFF WITH_GFX_H264=%s WITH_OPENH264=OFF\n' "$h"; exit 0 ;;
esac

TAB=$(printf '\t'); CR=$(printf '\r')
js() { printf '%s\n' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' -e "s/$TAB/\\\\t/g" -e "s/$CR/\\\\r/g" | { IFS= read -r l; o=$l; while IFS= read -r l; do o="$o\\n$l"; done; printf '"%s"' "$o"; }; }
jn() { if [ -n "$1" ]; then js "$1"; else printf null; fi; }
sha() { if command -v sha256sum >/dev/null 2>&1; then printf '%s' "$1" | sha256sum; else printf '%s' "$1" | shasum -a 256; fi | { read -r h _; printf '%s' "$h"; }; }
lc() { printf '%s' "$1" | tr 'A-Z' 'a-z'; }
REC=${VS_FAKE_RDP_RECORD-}
record() { [ -z "$REC" ] || printf '{"pid":%s,"at":%s000,%s}\n' "$$" "$(date +%s)" "$1" >>"$REC"; }
say() { printf '[00:00:00:000] [%s:00000000] [%s][%s] - [%s]: %s\n' "$$" "$1" "$2" "$3" "$4" >&2; }
opt() { _n=$1; shift; for _a in "$@"; do case $_a in "/$_n:"*) printf '%s' "${_a#"/$_n:"}"; return 0 ;; "/$_n") return 0 ;; esac; done; return 1; }

win=; link=
end() { [ -z "$win" ] || kill "$win" 2>/dev/null; [ -z "$link" ] || kill -9 "$link" 2>/dev/null; exit "$1"; }
onsig() {
  trap '' TERM INT HUP
  if [ "$1" = TERM ]; then w=Terminated; else w=SIG$1; fi
  say ERROR com.freerdp.utils.signal fsig_term_handler "Caught signal '$w' [15]"
  say ERROR com.freerdp.core freerdp_abort_connect_context 'ERRCONNECT_CONNECT_CANCELLED [0x0002000B]'
  record "\"phase\":\"signal\",\"sig\":\"SIG$1\""
  end 145
}
trap 'onsig TERM' TERM; trap 'onsig INT' INT; trap 'onsig HUP' HUP
fail() { say ERROR com.freerdp.core freerdp_connect "the fake xfreerdp could not $1"; record "\"phase\":\"end\",\"why\":$(js "$1")"; end 70; }

argv=; for a in "$@"; do argv="$argv${argv:+,}$(js "$a")"; done
names=; for nm in $(if [ -r "/proc/$$/environ" ]; then tr '\n\0' ' \n' <"/proc/$$/environ"; else env; fi | sed -n 's/^\([A-Za-z_][A-Za-z0-9_]*\)=.*/\1/p' | LC_ALL=C sort -u); do names="$names${names:+,}\"$nm\""; done
cfg=${XDG_CONFIG_HOME:-${HOME:-/nonexistent}/.config}
target=$(opt v "$@") || target=
port=${target##*:}
case $target in *:*) case $port in ''|*[!0-9]*) host=$target port= ;; *) host=${target%:*} ;; esac ;; *) host=$target port= ;; esac
record "\"phase\":\"start\",\"argv\":[$argv],\"env\":{\"names\":[$names],\"XDG_CONFIG_HOME\":$(jn "${XDG_CONFIG_HOME-}"),\"DISPLAY\":$(jn "${DISPLAY-}")}"

authonly=0; for a in "$@"; do [ "$a" = /auth-only ] && authonly=1; done
if [ $authonly = 1 ]; then for a in "$@"; do if [ "$a" = /from-stdin ]; then # measured: the password check comes BEFORE a plain /from-stdin reads
  say ERROR com.freerdp.core freerdp_connect_begin 'ERRCONNECT_PRE_CONNECT_FAILED [0x00020001]'
  say ERROR com.freerdp.core freerdp_connect_begin 'freerdp_pre_connect failed: CLIENT_STATE_PRECONNECT_PASSED'
  record '"phase":"end","why":"auth-only-no-password"'
  end 136
fi; done; fi

# ── the credentials on stdin, exactly as measured ──
fromstdin=0; for a in "$@"; do case $a in /from-stdin|/from-stdin:force) fromstdin=1 ;; esac; done
readline() { line=; IFS= read -r line || [ -n "$line" ]; }
pw=; havepw=0; lines=0; domstdin=false
if [ $fromstdin = 1 ]; then
  if opt d "$@" >/dev/null; then want=1; else want=2; domstdin=true; printf 'Domain:          '; fi
  if readline; then
    lines=1
    if [ $want = 1 ]; then pw=$line; havepw=1; elif readline; then lines=2; pw=$line; havepw=1; fi
  fi
fi
if [ $havepw = 1 ]; then pwj="{\"sha256\":\"$(sha "$pw")\",\"length\":$(printf '%s' "$pw" | wc -c | tr -d ' ')}"; else pwj=null; fi
record "\"phase\":\"stdin\",\"lines\":$lines,\"domainFromStdin\":$domstdin,\"password\":$pwj"

# the pinned certificate (the real client checks it during TLS, before the credentials are used)
cert=$(opt cert "$@") || cert=
pinned=; case $cert in *fingerprint:sha256:*) pinned=$(printf '%s\n' "${cert#*fingerprint:sha256:}" | sed -e 's/[^0-9A-Fa-f:].*//' -e q) ;; esac
stored=false; [ -e "$cfg/freerdp/server/${host}_${port}.pem" ] && stored=true
tofu=0; case ",$cert," in *,tofu,*) tofu=1 ;; esac
if [ $tofu = 1 ] && [ $stored = false ]; then # measured: the name-mismatch warnings, then the certificate is stored and it goes on
  say WARN com.freerdp.crypto verify_cb "Certificate verification failure 'self-signed certificate (18)' at stack position 0"
  say ERROR com.freerdp.crypto tls_print_certificate_name_mismatch_error 'A valid certificate for the wrong name should NOT be trusted!'
  say ERROR com.freerdp.crypto tls_print_new_certificate_warn 'Host key verification failed.'
  mkdir -p "$cfg/freerdp/server" || fail 'make its config dir'
  if [ -n "${VS_FAKE_RDP_SERVER_PEM-}" ]; then cat "$VS_FAKE_RDP_SERVER_PEM"; else printf '%s\n' '-----BEGIN CERTIFICATE-----' fake '-----END CERTIFICATE-----'; fi >"$cfg/freerdp/server/${host}_${port}.pem"
  record "\"phase\":\"tofu\",\"stored\":$(js "$cfg/freerdp/server/${host}_${port}.pem")"
fi
sfp=${VS_FAKE_RDP_SERVER_FP-}
if [ -n "$sfp" ] && [ $tofu = 0 ] && [ $stored = false ] && { [ -z "$pinned" ] || [ "$(lc "$pinned")" != "$(lc "$sfp")" ]; }; then
  say WARN com.freerdp.crypto verify_cb "Certificate verification failure 'self-signed certificate (18)' at stack position 0"
  say ERROR com.freerdp.crypto tls_print_new_certificate_warn 'Host key verification failed.'
  say ERROR com.freerdp.crypto freerdp_tls_handshake 'certificate not trusted, aborting.'
  say ERROR com.freerdp.core transport_default_connect_tls 'ERRCONNECT_TLS_CONNECT_FAILED [0x00020008]'
  record "\"phase\":\"end\",\"why\":\"cert\",\"pinned\":$(jn "$pinned"),\"stored\":$stored"
  end 143
fi
if [ $fromstdin = 1 ] && [ $havepw = 0 ]; then
  say ERROR com.freerdp.core nla_client_setup_identity 'ERRCONNECT_CONNECT_CANCELLED [0x0002000B]'
  say ERROR com.freerdp.core.transport transport_connect_nla 'NLA begin failed'
  record '"phase":"end","why":"no-password"'
  end 145
fi
logon=ok
if [ -n "${VS_FAKE_RDP_PASSWORD_SHA256-}" ] && [ "$(sha "$pw")" != "$VS_FAKE_RDP_PASSWORD_SHA256" ]; then logon=refused; fi

# the machine first (TCP), then the sign-in — like the real NLA order. The helper answers ONE line on a fifo (E <why> = no
# connection, L = the sign-in refused, R <reply> / N = connected: the machine's answer or none in 5 s), then holds the link
# until the far side closes (its exit; it ignores TERM — this shell ends it) or this shell is gone
LINK='use IO::Socket::INET; $SIG{$_} = "IGNORE" for qw(TERM INT HUP); $| = 1;
my ($h, $p, $logon) = @ARGV; my $parent = getppid;
my $s = IO::Socket::INET->new(PeerAddr => $h, PeerPort => $p, Proto => "tcp");
if (!$s) { (my $e = $@ || "$!") =~ s/\s+/ /g; print "E $e\n"; exit 41 }
if ($logon ne "ok") { close $s; print "L\n"; exit 34 }
syswrite $s, "VS-FAKE-RDP hello\n";
my ($b, $closed) = ("", 0);
my $wait = sub { my $rin = ""; vec($rin, fileno($s), 1) = 1; select(my $r = $rin, undef, undef, $_[0]) };
for (1 .. 20) { last if index($b, "\n") >= 0; next unless $wait->(0.25); if (!sysread($s, $b, 4096, length $b)) { $closed = 1; last } }
my $i = index($b, "\n");
print $i >= 0 ? "R " . substr($b, 0, $i) . "\n" : ($closed && length $b) ? "R $b\n" : "N\n";
while (1) { exit 0 if getppid != $parent; next unless $wait->(1); sysread($s, my $x, 4096) or exit 31 }'
command -v perl >/dev/null 2>&1 || fail 'find perl for its socket'
d=$(mktemp -d "${TMPDIR:-/tmp}/vs-fake-rdp.XXXXXX") && mkfifo "$d/link" || fail 'make its link fifo'
perl -e "$LINK" "${host:-127.0.0.1}" "$port" "$logon" >"$d/link" &
link=$!
exec 3<"$d/link"
rm -rf "$d"
IFS= read -r ans <&3 || ans=
case $ans in
  'R '*) reply=$(js "${ans#R }") ;;
  N) reply=null ;;
  L) link=
    say ERROR com.freerdp.core nla_recv_pdu 'ERRCONNECT_LOGON_FAILURE [0x00020014]'
    [ $authonly = 0 ] || say ERROR com.freerdp.core freerdp_connect_begin 'Authentication only, exit status 0'
    record '"phase":"end","why":"logon"'
    end 134 ;;
  *) link=
    say WARN com.freerdp.core freerdp_tcp_connect_timeout "connect to $host:$port failed with error: ${ans#E }"
    say ERROR com.freerdp.core get_next_addrinfo 'ERRCONNECT_CONNECT_FAILED [0x00020006]'
    record '"phase":"end","why":"unreachable"'
    end 141 ;;
esac
if [ $authonly = 1 ]; then # the real wording of a SUCCESSFUL auth-only run ("exit status 1" and CANCELLED, then exit 0)
  say ERROR com.freerdp.core freerdp_connect_begin 'Authentication only, exit status 1'
  say ERROR com.freerdp.core freerdp_abort_connect_context 'ERRCONNECT_CONNECT_CANCELLED [0x0002000B]'
  record "\"phase\":\"end\",\"why\":\"auth-only-ok\",\"reply\":$reply"
  end 0
fi
record "\"phase\":\"connected\",\"reply\":$reply"
if [ "${VS_FAKE_RDP_LEAK-}" = 1 ] && [ $havepw = 1 ]; then say WARN com.freerdp.client.common client_cli_auth "using password=$pw for the sign-in"; fi
if [ -n "${VS_FAKE_RDP_RAIL-}" ]; then
  say ERROR com.freerdp.client.x11 xf_rail_server_execute_result "RAIL exec error: execResult=$VS_FAKE_RDP_RAIL NtError=0x0"
  record "\"phase\":\"end\",\"why\":\"rail\",\"rail\":$(js "$VS_FAKE_RDP_RAIL")"
  end 1
fi
app=$(opt app "$@") || app=
name=",$app"; name=${name#*,name:}; name=${name%%,*}; case ",$app" in *,name:*) ;; *) name= ;; esac; [ -n "$name" ] || name=RemoteApp
printf '[INFO][com.freerdp.client.x11] - [xf_rail_window_common]: RAIL window "%s" mapped (fake xfreerdp)\n' "$name"
if [ "${VS_FAKE_RDP_WINDOW-}" != 0 ] && [ -n "${DISPLAY-}" ]; then
  if xm=$(command -v xmessage) && [ -n "$xm" ]; then
    "$xm" -name xfreerdp -title "$name" -geometry 360x120+40+40 "$name - a RemoteApp (fake xfreerdp)" </dev/null >/dev/null 2>&1 &
    win=$!
    record "\"phase\":\"window\",\"tool\":\"xmessage\",\"windowPid\":$win"
  else record '"phase":"window","tool":null'; fi
fi
wait "$link" # a session runs until it is stopped (the TERM trap) or the machine's side goes away
link=
say ERROR com.freerdp.core transport_read_layer 'ERRCONNECT_CONNECT_TRANSPORT_FAILED [0x0002000D]'
record '"phase":"end","why":"link-closed"'
end 131
