#!/usr/bin/env node
// A FAKE `xfreerdp` (lane remoteapp-r1a) — stands in for FreeRDP 3's X client in the RemoteApp suites. It answers
// `/version` + `/buildconfig` like FreeRDP 3.32.1, and a launch the way the REAL one was measured to behave (src/remoteapp.js
// header — xfreerdp 3.32.1 against a FreeRDP shadow server on a private Xvfb):
//   • `/from-stdin` with no `/d:` prompts "Domain:" and reads the FIRST stdin line as the domain, then the password line;
//     EOF before the password ⇒ ERRCONNECT_CONNECT_CANCELLED, exit 145
//   • a pinned `/cert:…fingerprint:sha256:<fp>` that differs from VS_FAKE_RDP_SERVER_FP ⇒ "Host key verification failed",
//     ERRCONNECT_TLS_CONNECT_FAILED, exit 143 — UNLESS a certificate is stored for that host:port under the client's config
//     dir ($XDG_CONFIG_HOME, else $HOME/.config)/freerdp/server/ (then it connects: the measured hole)
//   • a password whose sha256 is not VS_FAKE_RDP_PASSWORD_SHA256 ⇒ ERRCONNECT_LOGON_FAILURE, exit 134
//   • nothing listening on `/v:` ⇒ ERRCONNECT_CONNECT_FAILED, exit 141
// Then it connects to `/v:`, says one line and reads the machine's one-line answer (the suites' stand-in for the machine's
// 3389 behind the forward), prints a RAIL-looking line and — unless VS_FAKE_RDP_WINDOW=0 — opens ONE X top-level on $DISPLAY
// (xmessage, instance name `xfreerdp`), and runs until SIGTERM. VS_FAKE_RDP_RAIL=<RAIL_EXEC_E_…> prints FreeRDP's RAIL exec
// error line instead and exits 1 (that row's wording is from FreeRDP's xf_rail.c, not measured). What it saw goes to
// VS_FAKE_RDP_RECORD as JSON lines — the stdin password as its sha256 + length only, never its bytes.
'use strict';
const fs = require('fs');
const net = require('net');
const path = require('path');
const crypto = require('crypto');
const { spawn } = require('child_process');

const argv = process.argv.slice(2);
if (argv[0] === '/version') { process.stdout.write(`This is FreeRDP version ${process.env.VS_FAKE_RDP_VERSION || '3.32.1'} (fake)\n`); process.exit(0); }
if (argv[0] === '/buildconfig') { process.stdout.write(`Build configuration: BUILD_TESTING=OFF WITH_FFMPEG=OFF WITH_GFX_H264=${process.env.VS_FAKE_RDP_H264 === 'ON' ? 'ON' : 'OFF'} WITH_OPENH264=OFF\n`); process.exit(0); }

const sha = (s) => crypto.createHash('sha256').update(s).digest('hex');
const record = (o) => { const f = process.env.VS_FAKE_RDP_RECORD; if (f) fs.appendFileSync(f, JSON.stringify({ pid: process.pid, at: Date.now(), ...o }) + '\n'); };
const say = (level, tag, fn, msg) => process.stderr.write(`[00:00:00:000] [${process.pid}:00000000] [${level}][${tag}] - [${fn}]: ${msg}\n`);
const opt = (name) => { const a = argv.find((x) => x.startsWith(`/${name}:`) || x === `/${name}`); return a === undefined ? undefined : a.slice(name.length + 2); };
const configDir = process.env.XDG_CONFIG_HOME || path.join(process.env.HOME || '/nonexistent', '.config');
const target = String(opt('v') || '');
const [host, port] = [target.replace(/:\d+$/, ''), Number((/:(\d+)$/.exec(target) || [])[1])];
record({ phase: 'start', argv, env: { names: Object.keys(process.env).sort(), XDG_CONFIG_HOME: process.env.XDG_CONFIG_HOME || null, DISPLAY: process.env.DISPLAY || null } });

// ── the credentials on stdin, exactly as measured ──
function readStdinLines(want) {
  return new Promise((resolve) => {
    let buf = '';
    const lines = [];
    const done = () => { process.stdin.removeAllListeners(); process.stdin.pause(); resolve({ lines, eof: lines.length < want }); };
    process.stdin.setEncoding('utf8');
    process.stdin.on('data', (d) => { buf += d; let i; while ((i = buf.indexOf('\n')) >= 0 && lines.length < want) { lines.push(buf.slice(0, i)); buf = buf.slice(i + 1); } if (lines.length >= want) done(); });
    process.stdin.on('end', () => { if (buf && lines.length < want) lines.push(buf); done(); });
    process.stdin.on('error', () => done());
  });
}
async function credentials() {
  if (!argv.includes('/from-stdin') && !argv.includes('/from-stdin:force')) return { password: null, domainFromStdin: false, lines: 0 };
  const askDomain = opt('d') === undefined;
  if (askDomain) process.stdout.write('Domain:          ');
  const r = await readStdinLines(askDomain ? 2 : 1);
  const password = askDomain ? r.lines[1] : r.lines[0];
  return { password: password === undefined ? null : password, domainFromStdin: askDomain, lines: r.lines.length };
}

let child = null;
function end(code) { if (child) { try { child.kill('SIGTERM'); } catch { /* gone */ } } process.exit(code); }
for (const sig of ['SIGTERM', 'SIGINT', 'SIGHUP']) process.on(sig, () => { say('ERROR', 'com.freerdp.utils.signal', 'fsig_term_handler', `Caught signal '${sig === 'SIGTERM' ? 'Terminated' : sig}' [15]`); say('ERROR', 'com.freerdp.core', 'freerdp_abort_connect_context', 'ERRCONNECT_CONNECT_CANCELLED [0x0002000B]'); record({ phase: 'signal', sig }); end(145); });

(async () => {
  const cred = await credentials();
  record({ phase: 'stdin', lines: cred.lines, domainFromStdin: cred.domainFromStdin, password: cred.password === null ? null : { sha256: sha(cred.password), length: Buffer.byteLength(cred.password) } });
  // the pinned certificate (the real client checks it during TLS, before the credentials are used)
  const certOpt = String(opt('cert') || '');
  const pinned = (/fingerprint:sha256:([0-9a-f:]+)/i.exec(certOpt) || [])[1] || null;
  const serverFp = process.env.VS_FAKE_RDP_SERVER_FP || null;
  const stored = fs.existsSync(path.join(configDir, 'freerdp', 'server', `${host}_${port}.pem`));
  if (serverFp && !stored && (!pinned || pinned.toLowerCase() !== serverFp.toLowerCase())) {
    say('WARN', 'com.freerdp.crypto', 'verify_cb', "Certificate verification failure 'self-signed certificate (18)' at stack position 0");
    say('ERROR', 'com.freerdp.crypto', 'tls_print_new_certificate_warn', 'Host key verification failed.');
    say('ERROR', 'com.freerdp.crypto', 'freerdp_tls_handshake', 'certificate not trusted, aborting.');
    say('ERROR', 'com.freerdp.core', 'transport_default_connect_tls', 'ERRCONNECT_TLS_CONNECT_FAILED [0x00020008]');
    record({ phase: 'end', why: 'cert', pinned, stored });
    end(143);
  }
  if (cred.password === null && (argv.includes('/from-stdin') || argv.includes('/from-stdin:force'))) {
    say('ERROR', 'com.freerdp.core', 'nla_client_setup_identity', 'ERRCONNECT_CONNECT_CANCELLED [0x0002000B]');
    say('ERROR', 'com.freerdp.core.transport', 'transport_connect_nla', 'NLA begin failed');
    record({ phase: 'end', why: 'no-password' });
    end(145);
  }
  const wantPw = process.env.VS_FAKE_RDP_PASSWORD_SHA256 || null;
  // the machine first (TCP), then the sign-in — like the real NLA order
  const sock = await new Promise((resolve) => {
    const s = net.connect({ host: host || '127.0.0.1', port });
    s.once('connect', () => resolve(s));
    s.once('error', (e) => { say('WARN', 'com.freerdp.core', 'freerdp_tcp_connect_timeout', `connect to ${host}:${port} failed with error: ${e.message}`); say('ERROR', 'com.freerdp.core', 'get_next_addrinfo', 'ERRCONNECT_CONNECT_FAILED [0x00020006]'); record({ phase: 'end', why: 'unreachable' }); end(141); });
  });
  if (wantPw && sha(cred.password || '') !== wantPw) {
    say('ERROR', 'com.freerdp.core', 'nla_recv_pdu', 'ERRCONNECT_LOGON_FAILURE [0x00020014]');
    record({ phase: 'end', why: 'logon' });
    sock.destroy(); end(134);
  }
  sock.write('VS-FAKE-RDP hello\n');
  const reply = await new Promise((resolve) => { let b = ''; const t = setTimeout(() => resolve(null), 5000); sock.on('data', (d) => { b += d; const i = b.indexOf('\n'); if (i >= 0) { clearTimeout(t); resolve(b.slice(0, i)); } }); sock.on('close', () => { clearTimeout(t); resolve(b || null); }); });
  record({ phase: 'connected', reply });
  sock.on('close', () => { say('ERROR', 'com.freerdp.core', 'transport_read_layer', 'ERRCONNECT_CONNECT_TRANSPORT_FAILED [0x0002000D]'); record({ phase: 'end', why: 'link-closed' }); end(131); });
  const rail = process.env.VS_FAKE_RDP_RAIL;
  if (rail) { say('ERROR', 'com.freerdp.client.x11', 'xf_rail_server_execute_result', `RAIL exec error: execResult=${rail} NtError=0x0`); record({ phase: 'end', why: 'rail', rail }); end(1); }
  const app = String(opt('app') || '');
  const name = (/(?:^|,)name:([^,]*)/.exec(app) || [])[1] || 'RemoteApp';
  process.stdout.write(`[INFO][com.freerdp.client.x11] - [xf_rail_window_common]: RAIL window "${name}" mapped (fake xfreerdp)\n`);
  if (process.env.VS_FAKE_RDP_WINDOW !== '0' && process.env.DISPLAY) {
    const xm = (process.env.PATH || '').split(':').map((d) => path.join(d, 'xmessage')).find((f) => { try { fs.accessSync(f, fs.constants.X_OK); return true; } catch { return false; } });
    if (xm) { child = spawn(xm, ['-name', 'xfreerdp', '-title', name, '-geometry', '360x120+40+40', `${name} - a RemoteApp (fake xfreerdp)`], { stdio: 'ignore', env: process.env }); record({ phase: 'window', tool: 'xmessage', windowPid: child.pid }); }
    else record({ phase: 'window', tool: null });
  }
  setInterval(() => { }, 1 << 30); // a session runs until it is stopped
})();
