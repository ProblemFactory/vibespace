#!/usr/bin/env node
'use strict';
// THE FAKE agy (lane antigravity-harness): stands in for the Antigravity CLI in the suites, speaking the headless
// stream-json contract recorded in scripts/fixtures/antigravity-cli-1.4.3.json (provenance there: 'binary' for what the
// real 1.4.3 did offline, 'docs' for the stream shapes). Every argv and stdin line is appended to $AGY_STUB_LOG.
//   --version / --help            → the recorded version / help (stderr, like the real one)
//   -p /usage                     → see $AGY_STUB_USAGE below (the reading's judge, the capture script, the reading door)
//   not signed in: $AGY_STUB_AUTH=none = the MEASURED stream start on a pipe (refused at once, result ERROR);
//                  $AGY_STUB_AUTH=wait = the MEASURED start on a character-device stdin (the OAuth URL on stderr, then it
//                  WAITS reading a pasted code on stdin, up to $AGY_STUB_AUTH_WAIT_MS, and answers a result ERROR)
//   --input-format stream-json    → init once (conversation_id = --conversation or a fresh uuid), then per stdin line:
//       not JSON / no `event`     → result ERROR, exit 1        · an unknown event → a stderr warning, skipped
//       control_request/_response → result ERROR, exit 2
//       a `user` whose first word is one of agy's OWN commands (the fixture's slashInPrint.answeredWithoutATurn, any case)
//                                 → result ERROR, exit 2 — any other text, one that starts with a path too, is a turn
//       a non-text content block  → result ERROR, exit 1
//       text naming `tool`        → a run_command tool step (ACTIVE, then DONE with output)
//       text naming `deny`        → a soft-deny notice on stderr (the run continues); under --dangerously-skip-permissions
//                                   the tool runs instead (a run_command step)
//       text naming `fail`        → result ERROR + an AGY_ERROR line on stderr · `slow` → the turn takes $AGY_STUB_SLOW_MS
//       text naming `subagent`    → an invoke_subagent tool step (ACTIVE, parameters {Role, TypeName} — what the owner's
//                                   journal recorded, lane agy-subagent-cards) at step $AGY_STUB_SPAWN_STEP (the fixture
//                                   store's task names it), then the subagent_info update DONE on the same step (shape:
//                                   the docs'); with `old` too = an older build: no subagent_info, the tool step DONE
//                                   with an output that names no subagent
//       text naming `write the summary` / `edit the summary` → a write_file / edit_file step on <cwd>/reports/summary.md (the
//                                   file is written) — the MEASURED stream names + an absolute `Path` (lane agy-status-bar-facts)
//       otherwise                 → agent_response deltas "Antigravity (<model>, <mode>): <text>", a checkpoint, result SUCCESS
//     USAGE (lane agy-status-bar-facts) = the MEASURED semantics: every model call (one per agent_response, one more per
//     tool step) counts input / cache_read (the previous call's context) / output, and result.usage is the CONVERSATION'S
//     RUNNING SUM (total = input + output; thinking beside it); with $AGY_STUB_TRANSCRIPT=1 each step is also a row of
//     <HOME>/.gemini/antigravity-cli/brain/<conversation>/.system_generated/logs/transcript.jsonl (agy's own shape: a
//     USER_INPUT row per turn, a MODEL PLANNER_RESPONSE row with the call's counts), and a restart on --conversation
//     re-reads the sums from it (agy rehydrates its steps).
//     stdin EOF → exit 0 ($AGY_STUB_EXIT_DELAY_MS: after that long, SIGTERM ignored — a slow restart, made deterministic).  The --model / --effort / --mode / --dangerously-skip-permissions it was started with are echoed.
const fs = require('fs');
const path = require('path');
const crypto = require('crypto');
const FX = JSON.parse(fs.readFileSync(path.join(__dirname, 'antigravity-cli-1.4.3.json'), 'utf8'));
const argv = process.argv.slice(2);
const LOG = process.env.AGY_STUB_LOG || '';
const logLine = (o) => { if (LOG) { try { fs.appendFileSync(LOG, JSON.stringify(o) + '\n'); } catch { } } };
logLine({ argv, home: process.env.HOME || null, bus: process.env.DBUS_SESSION_BUS_ADDRESS || null });
const flag = (name) => { const i = argv.indexOf(name); return i >= 0 ? argv[i + 1] : null; };
if (argv.includes('--version')) { process.stdout.write(FX.version + '\n'); process.exit(0); }
if (argv.includes('--help')) { process.stderr.write('Usage of agy:\n' + Object.entries(FX.help.flags).map(([k, v]) => `  ${k.padEnd(32)}${v}`).join('\n') + '\n'); process.exit(0); }
const out = (o) => process.stdout.write(JSON.stringify(o) + '\n');
const usage = (n) => ({ input_tokens: 100 * n, output_tokens: 7 * n, thinking_tokens: 0, cache_read_tokens: 0, total_tokens: 107 * n });

// `-p /usage` (the reading the CLI answers itself): $AGY_STUB_USAGE = auth (default — the MEASURED unauthenticated
// envelope) | ok (a SUCCESS with no turn — a stand-in payload, its shape NOT agy's) | capture (the SIGNED-IN answer,
// verbatim from scripts/fixtures/antigravity-usage-1.4.3.json — lane antigravity-card-fixes) | turn (a SUCCESS that
// started a turn — what the judge must call turn-started). The working dir is logged (the reading runs in the account's
// empty login dir).
if (flag('-p') === '/usage' || flag('--print') === '/usage') {
  const mode = process.env.AGY_STUB_USAGE || 'auth';
  logLine({ usageCwd: process.cwd() });
  if (mode === 'capture') { out(JSON.parse(fs.readFileSync(path.join(__dirname, 'antigravity-usage-1.4.3.json'), 'utf8')).envelope); process.exit(0); }
  if (mode === 'turn') { out({ conversation_id: crypto.randomUUID(), status: 'SUCCESS', response: 'stand-in', duration_seconds: 1.2, num_turns: 1, usage: usage(1) }); process.exit(0); }
  if (mode === 'ok') { out({ conversation_id: '', status: 'SUCCESS', response: 'stand-in model\t80%\towner@example.com', duration_seconds: 0, num_turns: 0, usage: usage(0) }); process.exit(0); }
  process.stderr.write("Error: authentication required. Run 'agy' to log in, then retry.\nerror: authentication failed or timed out\n");
  out(FX.unauthenticated.usageStdout);
  process.exit(1);
}
if (process.env.AGY_STUB_AUTH === 'none') { // the MEASURED stream start on a pipe: an immediate refusal
  process.stderr.write("Error: authentication required. Run 'agy' to log in, then retry.\nerror: authentication failed or timed out\n");
  out(FX.unauthenticated.streamPipe.stdout);
  process.exit(1);
}
if (process.env.AGY_STUB_AUTH === 'wait') { // the MEASURED start on a character-device stdin: the URL, then a 60 s wait for a code
  process.stderr.write('Authentication required. Please visit the URL to log in:\n  https://accounts.google.com/o/oauth2/auth?access_type=offline&client_id=stub&response_type=code&state=stub\n\nWaiting for authentication (timeout 60s)...\nOr, paste the authorization code here and press Enter:\n');
  const t = setTimeout(() => { process.stderr.write('Error: authentication interrupted.\nerror: authentication failed or timed out\n'); out({ event: 'result', result: { conversation_id: '', status: 'ERROR', response: '', error: 'authentication failed or timed out', duration_seconds: 0, num_turns: 0, usage: usage(0) } }); process.exit(1); }, Number(process.env.AGY_STUB_AUTH_WAIT_MS || 60000));
  process.stdin.on('data', (d) => { logLine({ authCodeLine: String(d).slice(0, 200) }); });
  process.stdin.on('end', () => { clearTimeout(t); process.exit(1); });
  return;
}
if (flag('--input-format') !== 'stream-json') { process.stderr.write('stub: only --input-format stream-json is implemented\n'); process.exit(2); }
const cid = flag('--conversation') || process.env.AGY_STUB_CID || crypto.randomUUID(); // AGY_STUB_CID: a suite's fixed conversation (its fixture store is that conversation's)
const model = flag('--model') || 'default', effort = flag('--effort') || '', mode = argv.includes('--dangerously-skip-permissions') ? 'always-proceed' : (flag('--mode') || 'request-review');
out({ event: 'init', conversation_id: cid, init: { cwd: process.cwd(), tools: ['ask_permission', 'run_command', 'write_to_file'], permission_mode: mode === 'always-proceed' ? 'always-proceed' : 'request-review', ...(flag('--model') ? { model } : {}) } });
let step = 0, turns = 0, busy = Promise.resolve();
// the running sums (see USAGE above) + agy's own transcript when asked
const TX = process.env.AGY_STUB_TRANSCRIPT === '1' && process.env.HOME ? path.join(process.env.HOME, '.gemini', 'antigravity-cli', 'brain', cid, '.system_generated', 'logs', 'transcript.jsonl') : null;
const run = { input: 0, output: 0, thinking: 0, cacheRead: 0 };
let ctx = 0;
if (TX) { try { for (const l of fs.readFileSync(TX, 'utf8').split('\n')) { if (!l.trim()) continue; const r = JSON.parse(l); step = Math.max(step, r.step_index + 1); if (r.input_tokens != null) { run.input += r.input_tokens; run.output += r.output_tokens; run.cacheRead += r.cache_read_tokens; run.thinking += 3; ctx = r.input_tokens + r.cache_read_tokens; } } } catch { } }
const tx = (row) => { if (!TX) return; fs.mkdirSync(path.dirname(TX), { recursive: true }); fs.appendFileSync(TX, JSON.stringify({ step_index: row.step_index, source: row.source, type: row.type, status: 'DONE', created_at: new Date().toISOString(), ...row }) + '\n'); };
function modelCall(i) { const input = 40 + 2 * i, cacheRead = ctx, output = 9; ctx = input + cacheRead; run.input += input; run.output += output; run.cacheRead += cacheRead; run.thinking += 3; tx({ step_index: i, source: 'MODEL', type: 'PLANNER_RESPONSE', input_tokens: input, cache_read_tokens: cacheRead, output_tokens: output }); }
const running = () => ({ input_tokens: run.input, output_tokens: run.output, thinking_tokens: run.thinking, cache_read_tokens: run.cacheRead, total_tokens: run.input + run.output });
const fail = (error, code) => { out({ event: 'result', result: { conversation_id: cid, status: 'ERROR', response: '', error, duration_seconds: 0, num_turns: turns, usage: usage(turns) } }); process.exit(code); };
const sleep = (ms) => new Promise((r) => setTimeout(r, ms));
async function turn(text) {
  turns++;
  tx({ step_index: step, source: 'USER_EXPLICIT', type: 'USER_INPUT' });
  out({ event: 'step_update', step_update: { conversation_id: cid, step_index: step++, state: 'DONE', step_type: 'user_input' } });
  const wm = /\b(write|edit) the summary\b/.exec(text); // a phrase, never a bare word: the task-context prefix the wrapper adds says «write» too
  if (wm) {
    const i = step++, file = path.join(process.cwd(), 'reports', 'summary.md'), name = wm[1] === 'write' ? 'write_file' : 'edit_file';
    modelCall(i);
    out({ event: 'step_update', step_update: { conversation_id: cid, step_index: i, state: 'ACTIVE', step_type: 'tool', tool_name: name, tool_info: { name, parameters: { Path: file } } } });
    fs.mkdirSync(path.dirname(file), { recursive: true });
    if (wm[1] === 'write') fs.writeFileSync(file, '# Summary\n\nWritten by the fake agy.\n'); else fs.appendFileSync(file, '\nEdited.\n');
    out({ event: 'step_update', step_update: { conversation_id: cid, step_index: i, state: 'DONE', step_type: 'tool', tool_name: name, duration_seconds: 0.02, tool_info: { name, parameters: { Path: file }, output: 'ok' } } });
  }
  if (/\btool\b/.test(text)) {
    const i = step++;
    modelCall(i);
    out({ event: 'step_update', step_update: { conversation_id: cid, step_index: i, state: 'ACTIVE', step_type: 'tool', tool_name: 'run_command', tool_info: { name: 'run_command', parameters: { CommandLine: 'echo hello_headless_demo' } } } });
    await sleep(10);
    out({ event: 'step_update', step_update: { conversation_id: cid, step_index: i, state: 'DONE', step_type: 'tool', tool_name: 'run_command', duration_seconds: 0.07, tool_info: { name: 'run_command', parameters: { CommandLine: 'echo hello_headless_demo' }, output: 'hello_headless_demo\r\n' } } });
  }
  if (/\bdeny\b/.test(text) && mode === 'always-proceed') {
    const i = step++;
    out({ event: 'step_update', step_update: { conversation_id: cid, step_index: i, state: 'DONE', step_type: 'tool', tool_name: 'run_command', tool_info: { name: 'run_command', parameters: { CommandLine: 'rm -rf build' }, output: '' } } });
  } else if (/\bdeny\b/.test(text)) process.stderr.write('Tool run_command(rm -rf build) requires approval and was skipped. Allow it with a "command(rm)" rule under permissions.allow in ~/.gemini/antigravity-cli/settings.json, or run with --dangerously-skip-permissions.\n');
  if (/\bsubagent\b/.test(text)) {
    const fixed = Number(process.env.AGY_STUB_SPAWN_STEP);
    const i = Number.isInteger(fixed) && fixed >= 0 && !/\bold\b/.test(text) ? fixed : step++; // the old way: the next free step
    if (i >= step) step = i + 1;
    const role = process.env.AGY_STUB_SUB_ROLE || 'reviewer';
    out({ event: 'step_update', step_update: { conversation_id: cid, step_index: i, state: 'ACTIVE', step_type: 'tool', tool_name: 'invoke_subagent', tool_info: { name: 'invoke_subagent', parameters: { Role: role, TypeName: 'self' } } } });
    await sleep(10);
    if (/\bold\b/.test(text)) out({ event: 'step_update', step_update: { conversation_id: cid, step_index: i, state: 'DONE', step_type: 'tool', tool_name: 'invoke_subagent', tool_info: { name: 'invoke_subagent', parameters: { Role: role, TypeName: 'self' }, output: 'Started.' } } });
    else out({ event: 'step_update', step_update: { conversation_id: cid, step_index: i, state: 'DONE', step_type: 'subagent', subagent_info: { subagents: [{ type_name: 'self', role }] } } });
  }
  if (/\bslow\b/.test(text)) await sleep(Number(process.env.AGY_STUB_SLOW_MS || 1500));
  if (/\bfail\b/.test(text)) { process.stderr.write('AGY_ERROR: {"short_error":"model unavailable","status":"UNAVAILABLE","code":503,"retryable":true}\n'); out({ event: 'result', result: { conversation_id: cid, status: 'ERROR', response: '', error: 'model unavailable', duration_seconds: 0.1, num_turns: turns, usage: usage(turns) } }); return; }
  const reply = `Antigravity (${model}${effort ? ', ' + effort : ''}, ${mode}): ${text}`;
  const i = step++;
  modelCall(i);
  out({ event: 'step_update', step_update: { conversation_id: cid, step_index: i, state: 'ACTIVE', step_type: 'agent_response', text_delta: reply.slice(0, 12) } });
  await sleep(5);
  out({ event: 'step_update', step_update: { conversation_id: cid, step_index: i, state: 'DONE', step_type: 'agent_response', text_delta: reply.slice(12), duration_seconds: 0.2, usage: usage(1) } });
  out({ event: 'step_update', step_update: { conversation_id: cid, step_index: step++, state: 'DONE', step_type: 'checkpoint', duration_seconds: 0.01, usage: usage(turns) } });
  out({ event: 'result', result: { conversation_id: cid, status: 'SUCCESS', response: reply, duration_seconds: 0.3, num_turns: turns, usage: running() } });
}
let buf = '';
process.stdin.setEncoding('utf8');
process.stdin.on('data', (d) => {
  buf += d; let i;
  while ((i = buf.indexOf('\n')) !== -1) {
    const line = buf.slice(0, i).trim(); buf = buf.slice(i + 1);
    if (!line) continue;
    logLine({ stdin: line });
    let m = null; try { m = JSON.parse(line); } catch { fail('invalid JSON line', 1); }
    if (!m || typeof m.event !== 'string') fail('message missing the event field', 1);
    if (m.event === 'control_request' || m.event === 'control_response') fail(`${m.event} is not supported in a stream`, 2);
    if (m.event !== 'user') { process.stderr.write(`warning: ignoring unsupported stream input message event "${m.event}"\n`); continue; }
    const c = m.message && m.message.content;
    const blocks = Array.isArray(c) ? c : [{ type: 'text', text: String(c || '') }];
    if (blocks.some((b) => !b || b.type !== 'text')) fail('content block type other than text', 1);
    const text = blocks.map((b) => b.text).join('');
    const head = text.trim().split(/\s/)[0];
    if (FX.slashInPrint.answeredWithoutATurn.includes(head.toLowerCase())) fail(`${head} is answered by the CLI itself and is unavailable with --input-format stream-json; run it as its own --print ${head} invocation`, 2);
    busy = busy.then(() => turn(text));
  }
});
const EXIT_DELAY = Number(process.env.AGY_STUB_EXIT_DELAY_MS || 0);
if (EXIT_DELAY) process.on('SIGTERM', () => { });
process.stdin.on('end', () => { busy.then(() => setTimeout(() => process.exit(0), EXIT_DELAY)); });
